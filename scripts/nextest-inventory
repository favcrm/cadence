#!/bin/sh
# CAD-173: compare a complete Rust test inventory without running it.
# Both manifests must be non-empty before diffing; an empty command result is
# dependency failure, never proof of equivalent coverage.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# CAD-426: the monolithic `integration` binary is split into per-area
# tests/*.rs binaries. TARGET is `all-targets` or a test binary name
# (the tests/<name>.rs stem, e.g. `daemon`, `board`, `agents_pty`).
# CAD-482: remaining args (e.g. `--features test-seam`) reach both the
# cargo and the nextest inventory, so parity holds on the same feature
# set the suite runs with.
TARGET=${1:-all-targets}
if [ $# -gt 0 ]; then shift; fi
TMP=$(mktemp -d "${TMPDIR:-/tmp}/cadence-nextest-inventory.XXXXXX")
trap 'rm -rf "$TMP"' EXIT HUP INT TERM

die() {
    echo "nextest-inventory: $*" >&2
    exit 1
}

command -v jq >/dev/null 2>&1 || die "jq is required to parse nextest list JSON"

case "$TARGET" in
    all-targets)
        CARGO_TARGET_ARGS="--all-targets"
        NEXTEST_TARGET_ARGS="--all-targets"
        ;;
    integration)
        die "the 'integration' binary was split into per-area tests/*.rs \
binaries (CAD-426); use all-targets or a binary name such as 'daemon'"
        ;;
    *[!A-Za-z0-9_]*|"")
        die "unsupported target '$TARGET' (use all-targets or a tests/*.rs stem)"
        ;;
    *)
        CARGO_TARGET_ARGS="--test $TARGET"
        NEXTEST_TARGET_ARGS="--test $TARGET"
        ;;
esac

# libtest prints one `name: test` line per case. Keep only those lines so
# cargo warnings and the final summary cannot masquerade as test names.
# Fixed target arguments are selected above, so this unquoted expansion is
# deliberately a two-argument Cargo invocation for either inventory mode.
cargo test --manifest-path "$ROOT/Cargo.toml" $CARGO_TARGET_ARGS --locked "$@" -- --list >"$TMP/cargo.list" ||
    die "cargo inventory for $TARGET failed"
awk '
    /^[[:space:]]*[^[:space:]].*: test[[:space:]]*$/ {
        sub(/^[[:space:]]+/, ""); sub(/[[:space:]]*: test[[:space:]]*$/, ""); print
    }
' "$TMP/cargo.list" | sort -u >"$TMP/cargo.names"

# nextest's documented JSON list exposes each suite's `testcases` map.
"$ROOT/scripts/cadence-nextest" list $NEXTEST_TARGET_ARGS --locked "$@" --message-format json \
    >"$TMP/nextest.json" || die "pinned nextest list failed"
jq -er '
    [."rust-suites"[]?.testcases? | keys[]] | unique | .[]
' "$TMP/nextest.json" | sort -u >"$TMP/nextest.names" ||
    die "nextest list did not contain a parseable rust-suites testcases map"

[ -s "$TMP/cargo.names" ] || die "cargo inventory is empty"
[ -s "$TMP/nextest.names" ] || die "nextest inventory is empty"

if ! diff -u "$TMP/cargo.names" "$TMP/nextest.names"; then
    die "cargo and nextest inventories differ for $TARGET"
fi

count=$(wc -l <"$TMP/cargo.names" | tr -d ' ')
printf '%s\n' "inventory: target=$TARGET tests=$count runner=cargo-nextest retries=0 equal=yes"
