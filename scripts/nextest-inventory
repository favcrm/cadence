#!/bin/sh
# CAD-173: compare a complete Rust test inventory without running it.
# Both manifests must be non-empty before diffing; an empty command result is
# dependency failure, never proof of equivalent coverage.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# CAD-426: the monolithic `integration` binary is split into per-area
# tests/*.rs binaries. TARGET is `all-targets` or a test binary name
# (the tests/<name>.rs stem, e.g. `daemon`, `board`, `agents_pty`).
# CAD-482: remaining args (e.g. `--features test-seam`) reach both the
# cargo and the nextest inventory, so parity holds on the same feature
# set the suite runs with.
TARGET=${1:-all-targets}
if [ $# -gt 0 ]; then shift; fi
TMP=$(mktemp -d "${TMPDIR:-/tmp}/cadence-nextest-inventory.XXXXXX")
trap 'rm -rf "$TMP"' EXIT HUP INT TERM

die() {
    echo "nextest-inventory: $*" >&2
    exit 1
}

# CI retains only the first build; an output marker excludes stale/partial
# evidence if preservation fails. Capture I/O never changes inventory gates.
# Other callers need no destination; CI uses the default target directory.
TIMINGS_REPORT=${CADENCE_INVENTORY_TIMINGS_REPORT:-}
TIMINGS_SOURCE="$ROOT/target/cargo-timings/cargo-timing.html"
# CAD-1210: drop every CADENCE_* routing variable before cargo runs, except
# an allowlist, so a pane's production CADENCE_PM_DIR/CADENCE_STATE_DIR never
# reaches the test binaries (same approach as scripts/run-result-tests, CAD-1197).
cadence_env_allow=" CADENCE_SUITE_LOCK CADENCE_NEXTTEST_BIN CADENCE_REVIEW_SUITE_LOCK_HELD CADENCE_REVIEW_PR CADENCE_REVIEW_HEAD "
for v in $(env | sed -n 's/^\(CADENCE_[A-Za-z0-9_]*\)=.*/\1/p'); do
    case $cadence_env_allow in *" $v "*) ;; *) unset "$v" ;; esac
done
capture=false
if [ -n "${GITHUB_OUTPUT:-}" ]; then
    printf 'timings_available=false\n' >> "$GITHUB_OUTPUT" ||
        echo "inventory build timings unavailable: cannot publish capture status" >&2
fi
if [ -n "$TIMINGS_REPORT" ]; then
    if mkdir -p "$(dirname -- "$TIMINGS_REPORT")" &&
        rm -f "$TIMINGS_REPORT" "$TIMINGS_REPORT.tmp" "$TIMINGS_SOURCE"; then
        capture=true
    else
        echo "inventory build timings unavailable: cannot prepare capture paths" >&2
    fi
fi

command -v jq >/dev/null 2>&1 || die "jq is required to parse nextest list JSON"

case "$TARGET" in
    selected)
        # ci-rust-tests.py supplies explicit lib/bin/test selectors. Both
        # backends receive the same argv without compiling unrelated areas.
        CARGO_TARGET_ARGS=""
        NEXTEST_TARGET_ARGS=""
        ;;
    all-targets)
        CARGO_TARGET_ARGS="--all-targets"
        NEXTEST_TARGET_ARGS="--all-targets"
        ;;
    integration)
        die "the 'integration' binary was split into per-area tests/*.rs \
binaries (CAD-426); use all-targets or a binary name such as 'daemon'"
        ;;
    *[!A-Za-z0-9_]*|"")
        die "unsupported target '$TARGET' (use all-targets or a tests/*.rs stem)"
        ;;
    *)
        CARGO_TARGET_ARGS="--test $TARGET"
        NEXTEST_TARGET_ARGS="--test $TARGET"
        ;;
esac

# libtest prints one `name: test` line per case. Keep only those lines so
# cargo warnings and the final summary cannot masquerade as test names.
# Fixed target arguments are selected above, so this unquoted expansion is
# deliberately a two-argument Cargo invocation for either inventory mode.
cargo_failed=false
cargo test --manifest-path "$ROOT/Cargo.toml" $CARGO_TARGET_ARGS --locked --timings "$@" -- --list >"$TMP/cargo.list" ||
    cargo_failed=true
if [ "$capture" = true ]; then
    if [ ! -s "$TIMINGS_SOURCE" ]; then
        echo "inventory build timings unavailable: Cargo did not produce a report" >&2
    elif cp "$TIMINGS_SOURCE" "$TIMINGS_REPORT.tmp" &&
        mv "$TIMINGS_REPORT.tmp" "$TIMINGS_REPORT"; then
        if [ -n "${GITHUB_OUTPUT:-}" ]; then
            printf 'timings_available=true\n' >> "$GITHUB_OUTPUT" ||
                echo "inventory build timings unavailable: cannot publish capture status" >&2
        fi
    else
        rm -f "$TIMINGS_REPORT.tmp" || :
        echo "inventory build timings unavailable: cannot retain complete report" >&2
    fi
fi
[ "$cargo_failed" = false ] || die "cargo inventory for $TARGET failed"
awk '
    /^[[:space:]]*[^[:space:]].*: test[[:space:]]*$/ {
        sub(/^[[:space:]]+/, ""); sub(/[[:space:]]*: test[[:space:]]*$/, ""); print
    }
' "$TMP/cargo.list" | sort >"$TMP/cargo.names"

# nextest's documented JSON list exposes each suite's `testcases` map.
"$ROOT/scripts/cadence-nextest" list $NEXTEST_TARGET_ARGS --locked "$@" --message-format json \
    >"$TMP/nextest.json" || die "pinned nextest list failed"
jq -er '
    [."rust-suites"[]?.testcases? | keys[]] | .[]
' "$TMP/nextest.json" | sort >"$TMP/nextest.names" ||
    die "nextest list did not contain a parseable rust-suites testcases map"

[ -s "$TMP/cargo.names" ] || die "cargo inventory is empty"
[ -s "$TMP/nextest.names" ] || die "nextest inventory is empty"

if ! diff -u "$TMP/cargo.names" "$TMP/nextest.names"; then
    die "cargo and nextest inventories differ for $TARGET"
fi

count=$(wc -l <"$TMP/cargo.names" | tr -d ' ')
printf '%s\n' "inventory: target=$TARGET tests=$count runner=cargo-nextest retries=0 equal=yes"
