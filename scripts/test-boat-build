#!/usr/bin/env python3
"""CAD-2265 contract tests for scripts/boat-build: machine-type selection and
the memory-guard stop. No Boat sandbox is created."""

import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
from unittest import mock


ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader("boat_build", str(ROOT / "scripts/boat-build"))
spec = importlib.util.spec_from_loader("boat_build", loader)
boat = importlib.util.module_from_spec(spec)
loader.exec_module(boat)

PLAYBOOK = ['cargo', 'test', '--locked', '--features', 'test-seam', '--lib', 'cad2402',
            '--', '--test-threads', '1']


class TypeSelection(unittest.TestCase):
    def test_playbook_example_selects_large(self):
        machine, why = boat.choose_machine_type(None, PLAYBOOK)
        self.assertEqual(machine, 'large')
        self.assertIn('auto', why)

    def test_seam_lib_spellings(self):
        for argv in (
            ['cargo', 'test', '--lib', '--features=test-seam'],
            ['cargo', 'test', '--lib', '-F', 'test-seam'],
            ['cargo', 'test', '--lib', '-Ftest-seam'],
            ['cargo', '+stable', 'test', '--lib', '--features', 'a,test-seam'],
            ['cargo', 'test', '--lib', '--features', 'a test-seam'],
            ['cargo', 'test', '--lib', '--features', 'cadence-agent/test-seam'],
            ['cargo', 'nextest', 'run', '--lib', '--features', 'test-seam'],
            ['/usr/bin/cargo', 'test', '--lib', '--all-features'],
        ):
            self.assertTrue(boat.is_test_seam_lib_build(argv), argv)

    def test_other_commands_stay_default(self):
        for argv in (
            ['cargo', 'test', '--lib', 'cad2402'],
            ['cargo', 'test', '--features', 'test-seam', '--test', 'daemon'],
            ['cargo', 'check', '--lib', '--features', 'test-seam'],
            ['cargo', 'clippy', '--all-targets', '--features', 'test-seam'],
            ['cargo', 'nextest', 'show-config', '--lib', '--features', 'test-seam'],
            ['cargo', 'test', '--lib', '--features', 'other'],
            ['cargo', 'test', '--lib', '--', '--features', 'test-seam'],
            ['sh', '-c', 'cargo test --lib --features test-seam'],
            ['scripts/pre-push'],
            [],
        ):
            self.assertFalse(boat.is_test_seam_lib_build(argv), argv)
            self.assertEqual(boat.choose_machine_type(None, argv)[0], 'default', argv)

    def test_explicit_type_wins(self):
        self.assertEqual(boat.choose_machine_type('xlarge', PLAYBOOK)[0], 'xlarge')
        self.assertEqual(boat.choose_machine_type('small', PLAYBOOK)[0], 'small')

    def test_session_without_type_is_default(self):
        self.assertEqual(boat.session_machine_type({'sandbox': 'x'}), 'default')
        self.assertEqual(boat.session_machine_type({'type': 'large'}), 'large')
        self.assertEqual(boat.session_machine_type({'type': 'bogus'}), 'default')

    def test_create_and_session_record_the_type(self):
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / 'session.json'
            boat.save_session(path, 'bx_abcdefgh', Path(tmp), 'large')
            self.assertEqual(json.loads(path.read_text())['type'], 'large')
        with mock.patch.object(boat.subprocess, 'Popen') as popen:
            popen.return_value.stdout = iter(())
            popen.return_value.wait.return_value = 1
            with self.assertRaises(boat.Failure):
                boat.create_sandbox('n', 'large')
            command = popen.call_args[0][0]
            self.assertEqual(command[command.index('--type') + 1], 'large')


class GuardStop(unittest.TestCase):
    def setUp(self):
        boat.GUARD_STOPPED = False

    def test_stream_marker_sets_the_flag(self):
        with mock.patch.object(sys, 'stdout', io.StringIO()):
            boat._emit_exec_line(json.dumps({'type': 'stdout', 'data':
                'stopping this sandbox job: available memory below 768 MiB\n'}), None)
        self.assertTrue(boat.GUARD_STOPPED)

    def test_final_line_says_stopped_and_no_result(self):
        line = boat.guard_stop_line('default')
        self.assertIn('STOPPED BY THE MEMORY GUARD', line)
        self.assertIn('NO TEST RESULT EXISTS', line)
        self.assertNotIn('\n', line)

    def test_remote_script_exits_nonzero_when_guard_fires(self):
        # Run the in-sandbox script locally against a throwaway repo and an
        # unreachable memory floor, so the real guard path runs.
        with tempfile.TemporaryDirectory(prefix='bb') as tmp:
            home = Path(tmp)
            repo = home / 'boat-worktree'
            git = ['git', '-c', 'user.name=t', '-c', 'user.email=t@t', '-C', str(repo)]
            subprocess.run(['git', 'init', '-q', str(repo)], check=True)
            (repo / 'f').write_text('x')
            subprocess.run([*git, 'add', 'f'], check=True)
            subprocess.run([*git, 'commit', '-qm', 'c'], check=True)
            sha = subprocess.check_output([*git, 'rev-parse', 'HEAD'], text=True).strip()
            (home / 'boat-changes.patch').write_text('')
            (home / 'boat-job.json').write_text(json.dumps({
                'head': sha, 'base': sha, 'command': ['sleep', '60'],
                'snapshot': False, 'quarantine': False}))
            (home / 'boat-remote.py').write_text(boat.REMOTE)
            env = dict(os.environ, CADENCE_BOAT_REMOTE_ROOT=str(home),
                       CADENCE_BOAT_MEMORY_FLOOR_MIB='999999999')
            done = subprocess.run([sys.executable, str(home / 'boat-remote.py')],
                                  env=env, capture_output=True, text=True, timeout=60)
        self.assertEqual(done.returncode, boat.GUARD_EXIT, done.stdout + done.stderr)
        self.assertIn(boat.GUARD_MARK, done.stdout)


if __name__ == '__main__':
    unittest.main()
