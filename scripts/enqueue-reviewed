#!/usr/bin/env python3
"""CAD-959: enqueue a PR only when the AGENTS.md review and merge rules hold.

    scripts/enqueue-reviewed <pr> --head <full-40-hex-sha> [--repo owner/name]
                             [--notes-dir DIR] [--author ALIAS ...]
                             [--dry-run] [--poll-secs N] [--poll-interval N]

Refuses (exit 1, one reason per line on stderr, every failing rule listed)
unless ALL of these hold for the pinned head:

  * the PR is OPEN, its head equals --head, mergeStateStatus is not DIRTY and
    auto-merge is off;
  * every required status check of the base branch (branch protection AND
    rulesets) is PRESENT and SUCCESS at that head. Missing or pending fails,
    and so does a base branch for which no required check can be read: an
    invalid workflow yields zero checks, and "nothing failed" is not a pass;
  * the verdict notes in the notes dir, parsed by `cadence audit verdicts`
    (the audit's own note parser; reviewer = first token of `From:`), give the
    required count of PASS verdicts pinned to this exact head from distinct
    reviewers, none of them the PR author: two (Standards plus Spec/security),
    or one (`Review (standards+spec)`) when every change is on the one-review
    list (docs/roles/one-review-paths.toml, CAD-957, read at the PR's base
    commit so a PR cannot widen its own list). A `ui/` change also needs a
    Browser QA pass;
  * a ticket comment for this head lists those verdict notes (created after
    the other gates pass; dry-run only checks an existing comment);
  * for a human-class diff (a path trigger, more than 1500 changed lines, or
    any head-pinned note whose Risk is not exactly `auto`),
    `cadence audit approval` reports an approval in
    force for exactly this head. This script never records an approval.

Then it runs `gh pr merge --auto --squash --match-head-commit <sha>`, polls
isInMergeQueue for up to --poll-secs (default 30), and when the PR is not
queued runs --disable-auto and exits 1. --dry-run runs every check and
enqueues nothing. Exit: 0 enqueued (or dry-run clean) / 1 refused / 2 usage.
"""

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import tomllib
import unicodedata

ME = "enqueue-reviewed"
DEFAULT_NOTES_DIR = "/var/www/agent-notes"
ONE_REVIEW_FILE = "docs/roles/one-review-paths.toml"  # CAD-957

# Human-class path triggers: docs/roles/risk-classes.md (4, 7) and the
# AGENTS.md list. A verdict note's `Risk: human` also makes a diff human.
# CAD-1104: with one reviewer by default, the operator's approval is the second
# check, so this list must catch every trigger 4/6/7 path mechanically rather
# than rely on a single reviewer's `Risk:` line.
HUMAN_PREFIXES = (".github/", "scripts/", "docs/roles/", ".config/", ".cargo/",
                  "src/audit/", "src/delegation/", "tests/common/", "config/")
# Every [schema]/[trigger4]/[trigger6]/[trigger7] glob in this file, read at the
# PR's base, is human too (CAD-1104). Unreadable means human (fail closed).
RISK_PATHS_FILE = "docs/roles/risk-paths.toml"
RISK_HUMAN_TABLES = ("schema", "trigger4", "trigger6", "trigger7")
HUMAN_LINES = 1500  # risk-classes trigger 5
HUMAN_BASENAMES = {"Cargo.toml", "Cargo.lock", "package.json", "pnpm-lock.yaml",
                   "package-lock.json", ".npmrc", "yarn.lock", "bun.lockb",
                   "build.rs", "rust-toolchain.toml"}
HUMAN_EXACT = {
    "Cargo.toml", "Cargo.lock", "ui/package.json", "cadence-review.toml",
    "src/review.rs", "docs/TEAM.md", "docs/CHARTER.md", "AGENTS.md",
    # trigger 4 build inputs
    "build.rs", "rust-toolchain.toml", "clippy.toml",
    # trigger 6: installs and rollouts (CAD-1104)
    "src/rollout.rs", "src/update.rs", "src/upgrade.rs", "src/cli/rollout.rs",
    "src/cli/daemon.rs", "src/cli/update.rs", "src/cli/upgrade.rs",
    # trigger 7: approval and delivery rules (CAD-1104)
    "src/audit.rs", "src/delegation.rs", "src/issue/delivery_policy.rs",
    "src/issue/delivery_requirements.rs",
    "docs/AUDIT.md", "tests/safety_floor.rs",
}

# CAD-1106: a scope approval never covers trust boundary/identity (1) or
# secrets (3); those need a per-head approval.
NEVER_SCOPE_TRIGGERS = {1, 3}
# Tracker statuses (src/issue/model.rs STATUSES) a scope approval may cover:
# work has started and the ticket is not closed. backlog, done, dropped: no.
SCOPE_STATUSES = ("ready", "doing", "review")
SCOPE_RECORDED_VIA = "operator-connection"  # the proof check_approval relies on
# Rust's char::is_whitespace set: the daemon's scope_digest is sha256 of
# body.trim(), and Python's str.strip() trims a different set.
RUST_WS = "\t\n\v\f\r \u0085\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000"
RISK_TRIGGERS = re.compile(r"(?:triggers?\s*)?(\d+(?:\s*(?:,|and|&)\s*\d+)*)", re.I)

REGULAR_MODES = ("100644", "100755")
FULL_SHA = re.compile(r"^[0-9a-f]{40}$")


def run(argv, input_text=None):
    """(returncode, stdout, stderr); a missing binary is rc 127."""
    try:
        r = subprocess.run(argv, input=input_text, capture_output=True, text=True)
    except OSError as e:
        return 127, "", str(e)
    return r.returncode, r.stdout, r.stderr


def gh_json(argv):
    rc, out, err = run(["gh", *argv])
    if rc != 0:
        raise RuntimeError(f"gh {' '.join(argv[:2])} failed: {err.strip() or out.strip()}")
    try:
        return json.loads(out)
    except ValueError as e:
        raise RuntimeError(f"gh {' '.join(argv[:2])} returned bad JSON: {e}")


# ---- one-review path list (CAD-957) ----------------------------------------

def seg_re(seg):
    """One non-`**` glob segment: `*` is zero or more non-`/` characters;
    `?` and `[` are literal (CAD-957)."""
    return re.compile("".join("[^/]*" if c == "*" else re.escape(c) for c in seg) + r"\Z")


def glob_match(glob, path):
    """Repo-root relative; `**` only as a WHOLE segment, matching zero or
    more whole segments."""
    gs, ps = glob.split("/"), path.split("/")

    def go(i, j):
        if i == len(gs):
            return j == len(ps)
        if gs[i] == "**":
            return any(go(i + 1, k) for k in range(j, len(ps) + 1))
        return j < len(ps) and bool(seg_re(gs[i]).match(ps[j])) and go(i + 1, j + 1)
    return go(0, 0)


def one_review_qualifies(changes, toml_text):
    """CAD-957: one review only when EVERY change is a plain add or modify of a
    regular file whose path matches an include glob and no exclude glob
    (exclude wins). `changes` is [(status, old_mode, new_mode, path)] from
    `git diff --raw --no-renames`. A delete, rename, type change, mode change,
    symlink (120000), submodule (160000), odd path, empty diff, or a missing or
    unreadable list means two reviews."""
    if not changes or toml_text is None:
        return False
    try:
        doc = tomllib.loads(toml_text)
        inc = doc.get("one_review_include", [])
        exc = doc.get("one_review_exclude", [])
        if not (isinstance(inc, list) and isinstance(exc, list)
                and all(isinstance(g, str) for g in inc + exc)):
            return False
    except tomllib.TOMLDecodeError:
        return False
    for status, old_mode, new_mode, path in changes:
        if status not in ("A", "M") or new_mode not in REGULAR_MODES:
            return False
        if status == "M" and old_mode != new_mode:
            return False
        if status == "A" and old_mode != "000000":
            return False
        if (not path or path.startswith("/") or "\\" in path or ".." in path
                or any(seg in ("", ".") for seg in path.split("/"))):
            return False
        if not any(glob_match(g, path) for g in inc) or any(glob_match(g, path) for g in exc):
            return False
    return True


def parse_raw_diff(raw):
    """[(status, old_mode, new_mode, path)] from `git diff --raw -z`."""
    toks = raw.split("\0")
    out = []
    i = 0
    while i + 1 < len(toks):
        meta = toks[i]
        if not meta.startswith(":"):
            break
        f = meta[1:].split()
        out.append((f[4][:1], f[0], f[1], toks[i + 1]))
        i += 2
    return out


def pr_changes(pr, head, base, base_oid):
    """(changes, changed_lines) of the PR, from git in the current checkout:
    fetch the base and the PR head when either commit is absent, then diff the
    merge base to the pinned head with no rename detection (a rename is a
    delete plus an add, so both ends are seen). Raises on any failure."""
    def have(sha):
        return run(["git", "cat-file", "-e", f"{sha}^{{commit}}"])[0] == 0
    if not (have(head) and have(base_oid)):
        rc, _, err = run(["git", "fetch", "--quiet", "--no-tags", "origin", base, f"refs/pull/{pr}/head"])
        if rc != 0:
            raise RuntimeError(f"git fetch of {base} and refs/pull/{pr}/head failed: {err.strip()}")
    for sha in (head, base_oid):
        if not have(sha):
            raise RuntimeError(f"commit {sha} is not in this checkout (run from a checkout of the repo)")
    rc, mb, err = run(["git", "merge-base", base_oid, head])
    if rc != 0 or not FULL_SHA.match(mb.strip()):
        raise RuntimeError(f"no merge base of {base_oid} and {head}: {err.strip()}")
    mb = mb.strip()
    rc, out, err = run(["git", "diff", "--raw", "-z", "--no-renames", "--no-abbrev", mb, head])
    if rc != 0:
        raise RuntimeError(f"git diff failed: {err.strip()}")
    rc, num, err = run(["git", "diff", "--numstat", "--no-renames", mb, head])
    if rc != 0:
        raise RuntimeError(f"git diff --numstat failed: {err.strip()}")
    lines = 0
    for row in num.splitlines():
        added, deleted = row.split("\t")[:2]
        lines += (int(added) if added.isdigit() else 0) + (int(deleted) if deleted.isdigit() else 0)
    return parse_raw_diff(out), lines


def risk_globs(toml_text):
    """The human-class globs of risk-paths.toml, or None if unreadable."""
    if toml_text is None:
        return None
    try:
        doc = tomllib.loads(toml_text)
        globs = [g for t in RISK_HUMAN_TABLES for g in doc[t]["paths"]]
    except (tomllib.TOMLDecodeError, KeyError, TypeError):
        return None
    return globs if all(isinstance(g, str) for g in globs) else None


def is_human_path(path, risk=()):
    base = path.rsplit("/", 1)[-1]
    segs = path.split("/")[:-1]
    return (path in HUMAN_EXACT or path.startswith(HUMAN_PREFIXES)
            or base in HUMAN_BASENAMES or ".github" in segs or ".cargo" in segs
            or any(glob_match(g, path) for g in risk))


# ---- required checks --------------------------------------------------------

def required_contexts(repo, base):
    """(set of required check names, [reasons]). Fail closed."""
    names, reasons = set(), []
    rc, out, err = run(["gh", "api", f"repos/{repo}/rules/branches/{base}"])
    if rc != 0:
        reasons.append(f"cannot read the rulesets of {base}: {err.strip() or out.strip()}")
    else:
        try:
            for rule in json.loads(out):
                if rule.get("type") == "required_status_checks":
                    for c in rule.get("parameters", {}).get("required_status_checks", []):
                        names.add(c["context"])
        except (ValueError, TypeError, KeyError) as e:
            reasons.append(f"cannot parse the rulesets of {base}: {e}")
    rc, out, err = run(["gh", "api", f"repos/{repo}/branches/{base}/protection"])
    if rc != 0:
        if "not protected" not in (out + err).lower():
            reasons.append(f"cannot read branch protection of {base}: {err.strip() or out.strip()}")
    else:
        try:
            rsc = json.loads(out).get("required_status_checks") or {}
            names.update(rsc.get("contexts", []))
            names.update(c["context"] for c in rsc.get("checks", []))
        except (ValueError, TypeError, KeyError) as e:
            reasons.append(f"cannot parse branch protection of {base}: {e}")
    if not reasons and not names:
        reasons.append(f"no required checks found for {base}; refusing to read an empty list as 'nothing required'")
    return names, reasons


def check_states(rollup):
    """{check name: [state, ...]} from statusCheckRollup, state upper-case."""
    states = {}
    for e in rollup or []:
        if "context" in e:  # StatusContext
            name, state = e["context"], (e.get("state") or "").upper()
        else:  # CheckRun
            name = e.get("name")
            status = (e.get("status") or "").upper()
            state = (e.get("conclusion") or "").upper() if status == "COMPLETED" else (status or "PENDING")
        if name:
            states.setdefault(name, []).append(state or "PENDING")
    return states


def check_required(names, rollup, head):
    reasons = []
    states = check_states(rollup)
    for name in sorted(names):
        got = states.get(name)
        if not got:
            reasons.append(f"required check '{name}' is missing at head {head[:12]}")
        elif any(s != "SUCCESS" for s in got):
            bad = sorted({s for s in got if s != "SUCCESS"})
            kind = "pending" if all(s in ("PENDING", "QUEUED", "IN_PROGRESS", "WAITING", "EXPECTED", "REQUESTED") for s in bad) else "not successful"
            reasons.append(f"required check '{name}' is {kind} ({', '.join(bad)}) at head {head[:12]}")
    return reasons


# ---- verdict notes (parsed by `cadence audit verdicts`) --------------------

def read_verdicts(notes_dir, issue, pr, head):
    """(verdicts, skipped) from the audit's own note parser. Raises on failure."""
    rc, out, err = run(["cadence", "audit", "verdicts", "--issue", issue, "--pr", str(pr),
                        "--head", head, "--notes-dir", notes_dir])
    try:
        doc = json.loads(out)
        verdicts, skipped = doc["verdicts"], doc.get("skipped", [])
        keys = ("name", "stamp", "reviewer", "kind", "outcome", "title_outcome", "section_outcome", "risk")
        if rc != 0 or not all(isinstance(v, dict) and all(k in v for k in keys) for v in verdicts):
            raise ValueError("unexpected shape")
        return verdicts, skipped
    except (ValueError, KeyError, TypeError, AttributeError):
        raise RuntimeError(f"cannot read the verdict notes via `cadence audit verdicts` (rc {rc}): {(err or out).strip()[:200]}")


def check_reviews(verdicts, qualifies_one, need_qa, authors, issue):
    """(reasons, counted notes).

    Every head-pinned note counts toward a refusal, whatever its kind or file
    name: a non-pass note refuses unless the SAME reviewer has a later-stamped
    pass of a recognised kind, and an unstamped non-pass note always refuses.
    Notes are ordered by the file-name stamp, never mtime."""
    reasons, counted = [], []
    by_reviewer = {}
    for v in verdicts:
        by_reviewer.setdefault(v["reviewer"], []).append(v)
    for who, notes in sorted(by_reviewer.items()):
        stamped = [n for n in notes if n["stamp"]]
        passes = [n for n in stamped if n["outcome"] == "pass" and n["kind"] != "other"]
        for n in notes:
            if n["outcome"] == "pass":
                continue
            if n["stamp"] and any(p["stamp"] > n["stamp"] for p in passes):
                continue  # superseded by a later pass of this reviewer
            why = "" if n["stamp"] else "; the file name has no stamp, so it cannot be ordered"
            reasons.append(
                f"verdict by {who or '(no reviewer)'} on this head is not a pass "
                f"(outcome '{n['outcome']}', title '{n['title_outcome']}', section '{n['section_outcome']}'){why}: {n['name']}")
        if stamped:
            newest = max(n["stamp"] for n in stamped)
            names = sorted({n["name"] for n in stamped if n["stamp"] == newest})
            if len(names) > 1:
                reasons.append(f"cannot order two verdicts by one reviewer with the same file-name stamp: {' and '.join(names)}")
    # Counted: the latest recognised, stamped note per (reviewer, kind), when it passes.
    latest = {}
    for v in verdicts:
        if v["kind"] == "other" or not v["stamp"]:
            continue
        cur = latest.get((v["reviewer"], v["kind"]))
        if cur is None or v["stamp"] > cur["stamp"]:
            latest[(v["reviewer"], v["kind"])] = v
    for n in latest.values():
        who = n["reviewer"]
        if n["outcome"] != "pass":
            continue  # already refused above unless superseded
        if not who:
            reasons.append(f"verdict note has no 'From:' reviewer: {n['name']}")
        elif who in authors:
            reasons.append(f"verdict by {who} is not independent: they are the PR author ({n['name']})")
        else:
            counted.append(n)
    by = lambda kind: {n["reviewer"] for n in counted if n["kind"] == kind}
    std, spec, combined = by("standards"), by("spec-security"), by("combined")
    two = bool(std) and bool(spec) and any(a != b for a in std for b in spec)
    if qualifies_one:
        if not (combined or two):
            reasons.append(f"no pass verdict for {issue} pinned to this head (one review is required)")
    else:
        if not std:
            reasons.append(f"no pass Standards verdict for {issue} pinned to this head")
        if not spec:
            reasons.append(f"no pass Spec/security verdict for {issue} pinned to this head")
        if std and spec and not two:
            reasons.append("the Standards and Spec/security verdicts come from the same reviewer; two distinct reviewers are required")
    if need_qa and not by("browser-qa"):
        reasons.append(f"a ui/ change needs a pass Browser QA verdict for {issue} pinned to this head, from someone other than the author")
    return reasons, counted


def check_comment(comments, head, counted, required=()):
    names = sorted({n["name"] for n in counted})
    for c in comments or []:
        body = c.get("body") or ""
        if head in body and all(n in body for n in names) and all(v in body for v in required):
            return []
    suffix = (f" and required delivery evidence ({', '.join(required)})" if required else "")
    return [f"no ticket comment names head {head} and lists the verdict notes{suffix}"
            + (f" ({', '.join(names)})" if names else "")]


def requirements_inspection(issue, repo, pr, head):
    """Read the daemon's trusted, policy-aware requirements decision."""
    pr_url = f"https://github.com/{repo}/pull/{pr}"
    rc, out, err = run(["cadence", "delivery", "requirements", "--issue", issue,
                        "--pr", pr_url, "--head", head, "--json"])
    try:
        result = json.loads(out)
        req = result["requirements"]
        if rc != 0 or not isinstance(result, dict) or not isinstance(req, dict):
            raise ValueError("unexpected response shape")
        if (result.get("issue") != issue or result.get("repo") != repo.lower()
                or result.get("pr") != pr or result.get("head") != head
                or not FULL_SHA.fullmatch(result.get("base", ""))
                or not FULL_SHA.fullmatch(result.get("merge_base", ""))
                or not re.fullmatch(r"sha256:[0-9a-f]{64}", result.get("policy_digest", ""))
                or req.get("policy_digest") != result.get("policy_digest")
                or req.get("class") not in ("routine", "consequential", "sensitive", "strict")
                or req.get("activation") not in ("active", "no_profile", "not_approved", "malformed")
                or type(req.get("reviews")) is not int or req["reviews"] not in (0, 1, 2)
                or req.get("review_kind") not in ("none", "combined", "standards_and_spec")
                or type(req.get("security_capable")) is not bool
                or type(req.get("operator_approval")) is not bool
                or type(req.get("browser_qa")) is not bool
                or type(req.get("full_checks")) is not bool
                or not isinstance(req.get("reasons"), list)
                or not all(isinstance(v, str) for v in req["reasons"])):
            raise ValueError("requirements binding or fields are malformed")
        expected = {
            "routine": (0, "none", False, False, False),
            "consequential": (1, "combined", False, False, True),
        }
        if req["class"] in expected and req["activation"] == "active":
            reviews, kind, security, approval, full = expected[req["class"]]
            if (req["reviews"], req["review_kind"], req["security_capable"],
                    req["operator_approval"], req["full_checks"]) != (
                    reviews, kind, security, approval, full):
                raise ValueError("active class does not match its mandatory requirements")
        elif req["class"] != "strict" or req["reviews"] not in (1, 2):
            raise ValueError("inactive or strict result attempts a non-legacy waiver")
        if req["class"] == "strict":
            legacy_kind = "combined" if req["reviews"] == 1 else "standards_and_spec"
            if req["review_kind"] != legacy_kind or not req["full_checks"]:
                raise ValueError("strict requirements do not preserve the native legacy review/check floor")
        if req["class"] == "routine" and req["activation"] != "active":
            raise ValueError("routine classification without an active approved profile")
        if req["class"] == "routine" and req["browser_qa"]:
            raise ValueError("routine classification cannot require Browser QA")
        binding = {key: result[key] for key in
                   ("issue", "project", "repo", "pr", "head", "base", "merge_base", "policy_digest")}
        if not isinstance(binding["project"], str) or not binding["project"]:
            raise ValueError("requirements response has no project binding")
        readiness = result.get("readiness")
        if readiness is not None:
            if not isinstance(readiness, dict):
                raise ValueError("routine readiness is malformed")
            if (readiness.get("repo") != repo.lower() or readiness.get("pr") != pr
                    or readiness.get("head") != head or readiness.get("base") != result["base"]
                    or readiness.get("policy_digest") != result["policy_digest"]
                    or type(readiness.get("ci_run_id")) is not int or readiness["ci_run_id"] <= 0
                    or readiness.get("ci_run_url") != f"https://github.com/{repo.lower()}/actions/runs/{readiness.get('ci_run_id')}"
                    or not isinstance(readiness.get("outcome_report"), str)
                    or not readiness["outcome_report"].startswith(f"{issue}/reports/")
                    or readiness["outcome_report"].count("/") != 2
                    or readiness["outcome_report"].split("/")[-1] in ("", ".", "..")
                    or any(unicodedata.category(char) == "Cc" for char in readiness["outcome_report"])):
                raise ValueError("routine readiness does not bind to this issue, PR, head, base and policy")
        return {"binding": binding, "requirements": req, "readiness": readiness}
    except (ValueError, KeyError, TypeError, AttributeError) as e:
        raise RuntimeError(f"cannot use authoritative `cadence delivery requirements` result: {e}; {(err or out).strip()[:200]}")


def check_approval(repo, pr, head, report, evidence=None):
    rc, out, err = run(["cadence", "audit", "approval", "--pr", str(pr), "--head", head, "--repo", repo])
    try:
        state = json.loads(out)
    except ValueError:
        return [f"cannot read the operator approval via `cadence audit approval` (rc {rc}): {(err or out).strip()[:200]}"]
    if (rc == 0 and state.get("state") == "in-force"
            and state.get("recorded_via") == SCOPE_RECORDED_VIA
            and isinstance(state.get("approval_id"), str) and state["approval_id"]):
        if evidence is not None:
            evidence["approval"] = state["approval_id"]
        report.append(f"approval in force: id {state.get('approval_id')}, source {state.get('source')!r}, "
                      f"recorded_via {state.get('recorded_via')} (an operator claim until CAD-280)")
        return []
    why = state.get("reason") or state.get("state") or "unknown"
    return [f"human-class diff has no operator approval recorded for exactly head {head} ({why}); the operator records it with `cadence audit approve`"]


# ---- ticket scope approval (CAD-1106) --------------------------------------

def scope_digest(body):
    """The daemon's delegation::scope_digest: sha256 of the trimmed body."""
    return hashlib.sha256(body.strip(RUST_WS).encode()).hexdigest()


def glob_list(toml_text, key_path):
    """The string globs at doc[key_path...] of a TOML text, or None if the
    text is missing, malformed or not a list of strings."""
    if toml_text is None:
        return None
    try:
        node = tomllib.loads(toml_text)
        for k in key_path:
            node = node[k]
    except (tomllib.TOMLDecodeError, KeyError, TypeError):
        return None
    return node if isinstance(node, list) and all(isinstance(g, str) for g in node) else None


# A ticket body that can hide or disguise a line from the rendered page gives
# no scope approval (a per-PR approval still works): a Unicode format
# character, an HTML character reference, or hidden HTML.
HIDING_HTML = re.compile(r"<!--|<[^>]*\bhidden\b|display\s*:\s*none", re.I)
HTML_REF = re.compile(r"&(?:#\w+|[a-z][a-z0-9]*);", re.I)
RISK_LOOSE = re.compile(r"r\w?s\W*k\W*:")


def hides_text(text):
    return (any(unicodedata.category(c) == "Cf" for c in text)
            or HTML_REF.search(text) is not None or HIDING_HTML.search(text) is not None)


def risk_line(text, ticket=False):
    """The one `Risk:` line (stripped, without the label), or None when there
    is none or MORE THAN ONE (fail closed: which one counts is unknowable).
    `ticket` (a ticket body) refuses text that can hide a line (`hides_text`),
    then counts EVERY line that loosely looks like `Risk:` after NFKC and
    casefold (lookalike letters, fullwidth forms, lowercase), fenced code
    included. That one line must itself start with the ASCII `Risk:` once
    Markdown markers are stripped."""
    if ticket and hides_text(text or ""):
        return None
    lines = []
    for raw in (text or "").splitlines():
        l = raw.strip()
        if ticket:
            l = re.sub(r"[*_`]", "", l).lstrip(" \t>-").strip()
            if RISK_LOOSE.search(unicodedata.normalize("NFKC", l).casefold()):
                lines.append(l[5:].strip() if l.startswith("Risk:") else None)
        elif l.startswith("Risk:"):
            lines.append(l[5:].strip())
    return lines[0] if len(lines) == 1 else None


def risk_triggers(line):
    """The trigger numbers a `Risk:` line names, or None when it is not
    `auto` / `human (<numbers>)` (allowlist). Beyond the first group it reads
    EVERY trigger number on the line: `trigger N` wording and single digits
    inside any other parenthesised group, so a 1 or 3 cannot hide in prose."""
    if line is None:
        return None
    if line.split()[:1] == ["auto"]:
        return set()
    m = re.match(r"human\s*\(([^)]*)\)", line)
    t = RISK_TRIGGERS.fullmatch(m.group(1).strip()) if m else None
    if not t:
        return None
    nums = {int(n) for n in re.findall(r"\d+", t.group(1))}
    rest = line[m.end():]
    for w in re.finditer(r"\btriggers?\s*(\d+(?:\s*(?:,|and|&)\s*\d+)*)", rest, re.I):
        nums |= {int(n) for n in re.findall(r"\d+", w.group(1))}
    for g in re.findall(r"\(([^)]*)\)", rest):
        nums |= {int(n) for n in re.findall(r"(?<![\w#-])[1-9](?![\w-])", g)}
    return nums


def note_triggers(text):
    return risk_triggers(risk_line(text))


# docs/roles/risk-paths.toml tables that map a path to a risk trigger number
PATH_TRIGGER_TABLES = (("schema", 2), ("trigger4", 4), ("trigger6", 6), ("trigger7", 7))


def path_triggers(paths, risk_text):
    """(triggers hit, [unmapped human paths]) from the risk-paths tables read
    at the base, or (None, reason) when a table is unreadable. A human-class
    path (is_human_path) in no table is unmapped: it needs a per-head approval."""
    tables = []
    for t, n in PATH_TRIGGER_TABLES:
        g = glob_list(risk_text, (t, "paths"))
        if g is None:
            return None, f"cannot read the [{t}] list of {RISK_PATHS_FILE} at the base"
        tables.append((n, g))
    hit, unmapped = set(), []
    for p in paths:
        mine = {n for n, g in tables if any(glob_match(x, p) for x in g)}
        hit |= mine
        if not mine and is_human_path(p, ()):
            unmapped.append(p)
    return hit, unmapped


def scope_reasons(issue, title, branch, ticket, paths, risk_text, one_text, verdicts, counted, scopes, read_note):
    """Why a ticket scope approval does NOT cover this PR: [] only when every
    condition holds. Pure but for `read_note(path)` (a verdict note's text or
    None). Each condition fails closed on a missing or malformed input."""
    why = []
    if not issue:
        return ["the PR title carries no ticket id"]
    body = ticket.get("body")
    if not isinstance(body, str) or str(ticket.get("id", "")).lower() != issue.lower():
        why.append(f"cannot read the body of ticket {issue}")
    # Paths: never trigger 1 or 3, never a two-review (exclude) path.
    t13 = [g for t in ("trigger1", "trigger3") for g in (glob_list(risk_text, (t, "paths")) or [None])]
    exc = glob_list(one_text, ("one_review_exclude",))
    if None in t13 or exc is None:
        why.append(f"cannot read the trigger 1/3 lists ({RISK_PATHS_FILE}, {ONE_REVIEW_FILE}) at the base")
    else:
        hit = [p for p in paths if any(glob_match(g, p) for g in t13 + exc)]
        if hit:
            why.append(f"trigger 1/3 or two-review path needs a per-head approval: {', '.join(hit[:5])}")
    if not paths:
        why.append("no changed paths")
    if ticket.get("status") not in SCOPE_STATUSES:
        why.append(f"ticket {issue} status is {ticket.get('status')!r}; a scope approval covers only a ticket in {'/'.join(SCOPE_STATUSES)}")
    # The ticket declares its Risk triggers; the approval covers only those.
    declared = risk_triggers(risk_line(body, ticket=True)) if isinstance(body, str) else None
    pt, unmapped = path_triggers(paths, risk_text)
    if not declared:
        why.append(f"ticket {issue} declares no parseable `Risk: human (<numbers>)` line, so its scope is unknown")
    elif declared & NEVER_SCOPE_TRIGGERS:
        why.append(f"ticket {issue} declares trigger {sorted(declared & NEVER_SCOPE_TRIGGERS)}, which a scope approval never covers")
    if pt is None:
        why.append(unmapped)
    else:
        if unmapped:
            why.append(f"human-class path in no risk trigger list needs a per-head approval: {', '.join(unmapped[:5])}")
        if declared and not pt <= declared:
            why.append(f"the diff hits trigger(s) {sorted(pt - declared)} the ticket does not declare (declared {sorted(declared)})")
    # Lane branch the ticket recorded.
    refs = ticket.get("refs")
    if not (isinstance(refs, list) and branch and any(
            isinstance(r, dict) and r.get("kind") == "branch" and r.get("closed") is not True
            and r.get("path") == branch for r in refs)):
        why.append(f"PR branch {branch!r} is not an open lane branch recorded on {issue}")
    # Verdict notes: no trigger 1/3 Risk line; counted notes state in-scope.
    for v in verdicts:
        text = read_note(v.get("path"))
        trig = note_triggers(text) if text is not None else None
        if trig is None:
            why.append(f"cannot show that {v.get('name')} avoids Risk triggers 1 and 3")
        elif trig & NEVER_SCOPE_TRIGGERS:
            why.append(f"{v.get('name')} names Risk trigger {sorted(trig & NEVER_SCOPE_TRIGGERS)}")
        elif declared and not trig <= declared:
            why.append(f"{v.get('name')} names Risk trigger(s) {sorted(trig - declared)} the ticket does not declare")
    for n in counted:
        text = read_note(n.get("path"))
        if text is None or not re.search(rf"^\s*Scope:\s*in-scope\s+{re.escape(issue)}\b", text, re.I | re.M):
            why.append(f"{n['name']} does not state `Scope: in-scope {issue}`")
    # The approval itself.
    if not isinstance(scopes, dict) or scopes.get("state") != "ok" or not isinstance(scopes.get("approvals"), list):
        why.append(f"cannot read scope approvals via `cadence audit scope`: {scopes!r}"[:200])
    elif str(scopes.get("issue", "")).lower() != issue.lower():
        why.append(f"the scope approvals read are for {scopes.get('issue')!r}, not {issue}")
    else:
        digest = scope_digest(body) if isinstance(body, str) else None
        live = [a for a in scopes["approvals"] if isinstance(a, dict) and a.get("revoked") is False]
        if not live:
            why.append(f"no live (unrevoked) scope approval is recorded for {issue}")
        elif not any(a.get("digest") == digest and a.get("recorded_via") == SCOPE_RECORDED_VIA for a in live):
            why.append(f"no live scope approval of {issue} matches the ticket as it reads now "
                       f"(digest {str(digest)[:12]}; edited since approval, or not recorded via {SCOPE_RECORDED_VIA})")
    return why


def pick_scope_approval(scopes, body):
    """The approval id scope_reasons accepted (call only when it returned [])."""
    d = scope_digest(body)
    return next(a for a in scopes["approvals"]
                if a.get("revoked") is False and a.get("digest") == d and a.get("recorded_via") == SCOPE_RECORDED_VIA)


def read_note_file(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, TypeError, ValueError):
        return None


def check_scope(issue, title, branch, ticket, paths, risk_text, one_text, verdicts, counted, report, evidence=None):
    """Reasons ([] = covered). Appends which approval was used to `report`."""
    try:
        rc, out, _ = run(["cadence", "audit", "scope", "--issue", issue or ""])
        try:
            scopes = json.loads(out) if rc == 0 else {"state": f"rc {rc}"}
        except ValueError:
            scopes = {"state": "unparseable"}
        why = scope_reasons(issue, title, branch, ticket, paths, risk_text, one_text, verdicts, counted, scopes, read_note_file)
        if not why:
            a = pick_scope_approval(scopes, ticket["body"])
            if not isinstance(a.get("approval_id"), str) or not a["approval_id"]:
                return ["scope approval has no approval id"]
            if evidence is not None:
                evidence["approval"] = a["approval_id"]
            report.append(f"scope approval in force: id {a.get('approval_id')}, ticket {issue}, digest {a['digest'][:12]}, "
                          f"source {a.get('source')!r}, recorded_via {a.get('recorded_via')} (an operator claim until CAD-280)")
        return why
    except Exception as e:  # fail closed on any read error
        return [f"scope approval check failed: {e}"]


def evaluate(args, repo, *, require_comment=True, evidence=None):
    """(reasons, report lines). Preparing evidence skips only comment presence."""
    reasons, report = [], []
    if evidence is not None:
        evidence.clear()
    approval_evidence = evidence if evidence is not None else {}
    pr, head = args.pr, args.head
    fields = "number,state,title,headRefName,headRefOid,baseRefName,baseRefOid,mergeStateStatus,autoMergeRequest,statusCheckRollup,author"
    view = gh_json(["pr", "view", str(pr), "-R", repo, "--json", fields])

    if view.get("state") != "OPEN":
        reasons.append(f"PR #{pr} is {view.get('state')}, not OPEN")
    if (view.get("headRefOid") or "").lower() != head:
        reasons.append(f"PR #{pr} head is {view.get('headRefOid')}, not the pinned {head}")
    if view.get("mergeStateStatus") == "DIRTY":
        reasons.append(f"PR #{pr} has merge conflicts (mergeStateStatus DIRTY)")
    if view.get("autoMergeRequest"):
        reasons.append(f"auto-merge is already enabled on PR #{pr}; disable it, then review the exact head")
    base = view.get("baseRefName") or ""
    base_oid = view.get("baseRefOid") or ""
    if not FULL_SHA.fullmatch(base_oid):
        reasons.append("cannot bind evidence to a full base commit SHA")
    try:
        default = gh_json(["repo", "view", repo, "--json", "defaultBranchRef"])["defaultBranchRef"]["name"]
    except (RuntimeError, KeyError, TypeError) as e:
        default = None
        reasons.append(f"cannot read the default branch of {repo}: {e}")
    if default and base != default:
        reasons.append(f"PR #{pr} targets {base!r}, not the default branch {default!r}")

    # Required checks of the base.
    names, rs = required_contexts(repo, base or "main")
    reasons += rs
    if names:
        reasons += check_required(names, view.get("statusCheckRollup"), head)
        report.append(f"required checks: {', '.join(sorted(names))}")

    # Changed paths (modes included) and size, straight from git.
    try:
        changes, lines = pr_changes(pr, head, base, base_oid)
    except RuntimeError as e:
        reasons.append(f"cannot list the changed files of PR #{pr}: {e}")
        changes, lines = [], 0
    paths = sorted({c[3] for c in changes})
    if not changes and not any("cannot list the changed files" in r for r in reasons):
        reasons.append(f"PR #{pr} has an empty diff against {base}")

    # One-review list, read at the PR's base commit.
    rc, toml_text, _ = run(["gh", "api", "-H", "Accept: application/vnd.github.raw",
                            f"repos/{repo}/contents/{ONE_REVIEW_FILE}?ref={base_oid}"])
    one_text = toml_text if rc == 0 and base_oid else None
    one = rc == 0 and bool(base_oid) and one_review_qualifies(changes, toml_text)
    report.append("reviews required: " + ("one (diff is on the one-review list)" if one else "two (Standards and Spec/security)"))
    need_qa = any(p.startswith("ui/") for p in paths)

    # Ticket and verdicts.
    m = re.match(r"\s*([A-Z][A-Z0-9]*-\d+)\b", view.get("title") or "")
    issue = m.group(1) if m else None
    ticket = {}
    if not issue:
        reasons.append(f"PR title carries no issue id (want 'CAD-123: ...'): {view.get('title')!r}")
    else:
        rc, out, err = run(["cadence", "issue", "show", issue, "--json"])
        try:
            loaded = json.loads(out)
            if rc != 0 or not isinstance(loaded, dict) or loaded.get("id") != issue:
                raise ValueError("ticket reply is not bound to this issue")
            ticket = loaded
        except ValueError:
            reasons.append(f"cannot read ticket {issue} via `cadence issue show` (rc {rc}): {(err or out).strip()[:200]}")

    authors = {a.lower() for a in args.author}
    login = (view.get("author") or {}).get("login")
    if login:
        authors.add(login.lower())
    if ticket.get("owner"):
        authors.add(str(ticket["owner"]).lower())
    if (ticket.get("claim") or {}).get("by"):
        authors.add(str(ticket["claim"]["by"]).lower())

    authority = None
    required_comment_evidence = []
    if issue:
        try:
            authority = requirements_inspection(issue, repo, pr, head)
            if (authority["binding"]["base"] != base_oid
                    or authority["binding"]["repo"] != repo.lower()
                    or authority["binding"]["project"] != ticket.get("project")):
                raise RuntimeError("authoritative requirements binding differs from the ticket project, PR base or repository")
            req = authority["requirements"]
            need_qa = need_qa or req["browser_qa"]
            report.append(f"delivery requirements: {req['class']} ({req['activation']}); policy {authority['binding']['policy_digest']}")
            report.extend(f"delivery reason: {reason}" for reason in req["reasons"])
            if req["activation"] == "active":
                required_comment_evidence.extend((f"Delivery class: {req['class']}",
                                                  f"Policy digest: {authority['binding']['policy_digest']}"))
                ci_url = green_ci_run(repo, head)
                required_comment_evidence.append(f"Green CI run: {ci_url}")
            if authority["readiness"]:
                ready = authority["readiness"]
                report.append(f"routine outcome: {ready['outcome_report']}; CI run {ready['ci_run_id']} {ready['ci_run_url']}")
                required_comment_evidence.extend((f"Outcome report: {ready['outcome_report']}",
                                                  f"Native CI run: {ready['ci_run_id']} {ready['ci_run_url']}"))
        except RuntimeError as e:
            reasons.append(str(e))

    verdicts, counted = [], []
    if issue:
        try:
            verdicts, skipped = read_verdicts(args.notes_dir, issue, pr, head)
            for sk in skipped:
                report.append(f"skipped note {sk['name']}: {sk['reason']}")
            for v in verdicts:
                if v["kind"] == "other":
                    report.append(f"ignored note {v['name']}: its title names no known review kind")
        except RuntimeError as e:
            reasons.append(str(e))
        active = authority is not None and authority["requirements"]["activation"] == "active"
        klass = authority["requirements"]["class"] if authority else None
        counted = []
        if not active or klass == "strict":
            native_one = bool(authority and authority["requirements"]["reviews"] == 1)
            effective_one = one and native_one
            rs, counted = check_reviews(verdicts, effective_one, need_qa, authors, issue)
            reasons += rs
        elif klass == "routine":
            if authority["readiness"] is None:
                reasons.append("active routine delivery has no fresh native readiness proof for this exact binding")
            else:
                ready = authority["readiness"]
                try:
                    ci_url = green_ci_run(repo, head)
                    if ci_url != ready["ci_run_url"]:
                        reasons.append("native routine readiness CI run is not the actual successful ci.yml run at this head")
                except RuntimeError as e:
                    reasons.append(str(e))
            if need_qa:
                reasons += check_reviews(verdicts, True, True, authors, issue)[0]
        elif klass == "consequential":
            rs, counted = check_reviews(verdicts, True, need_qa, authors, issue)
            reasons += rs
            combined = [n for n in counted if n.get("kind") == "combined"]
            if len({n.get("reviewer") for n in combined}) != 1:
                reasons.append(f"active {klass} delivery requires exactly one independent combined review")
        report.append("counted verdicts: " + (", ".join(f"{n['reviewer']} {n['kind']} ({n['name']})" for n in counted) or "none"))

    # Human class: paths, size, or any head-pinned note whose Risk is not exactly `auto`.
    rc, risk_text, _ = run(["gh", "api", "-H", "Accept: application/vnd.github.raw",
                            f"repos/{repo}/contents/{RISK_PATHS_FILE}?ref={base_oid}"])
    risk_text = risk_text if rc == 0 and base_oid else None
    risk = risk_globs(risk_text)
    why = [] if risk is not None else [f"cannot read {RISK_PATHS_FILE} at the base (fail closed)"]
    why += [p for p in paths if is_human_path(p, risk or ())][:5]
    if lines > HUMAN_LINES:
        why.append(f"{lines} changed lines")
    not_auto = [v for v in verdicts if v["risk"] != "auto"]
    if not_auto:
        why.append(f"Risk {not_auto[0]['risk'] or '(missing)'!r} in {not_auto[0]['name']}")
    if why:
        report.append("class: human (" + "; ".join(why) + ")")
        rs = check_approval(repo, pr, head, report, approval_evidence)
        if rs:  # legacy CAD-1106 scope fallback only
            sr = check_scope(issue, view.get("title"), view.get("headRefName"), ticket, paths,
                             risk_text, one_text, verdicts, counted, report, approval_evidence)
            if sr:
                report.append("scope approval not used: " + "; ".join(sr))
            else:
                rs = []
        reasons += rs
    else:
        report.append("class: auto (every head-pinned note says Risk: auto; no path or size trigger)")
    authoritative_operator = bool(authority and authority["requirements"]["operator_approval"])
    if authoritative_operator and not why:
        rs = check_approval(repo, pr, head, report, approval_evidence)
        if rs:
            sr = check_scope(issue, view.get("title"), view.get("headRefName"), ticket, paths,
                             risk_text, one_text, verdicts, counted, report, approval_evidence)
            if sr:
                report.append("scope approval not used: " + "; ".join(sr))
            else:
                rs = []
        reasons += rs
    if require_comment:
        if approval_evidence.get("approval"):
            required_comment_evidence.append("Operator approval id: " + approval_evidence["approval"])
        reasons += check_comment(ticket.get("comments"), head, counted, required_comment_evidence)
    if evidence is not None and not reasons:
        evidence.update(issue=issue, repo=repo, pr=pr, head=head, base=base_oid,
                        notes=sorted({n["name"] for n in counted}),
                        checks=sorted(names), comments=ticket.get("comments") or [],
                        binding=authority["binding"] if authority else None,
                        requirements=authority["requirements"] if authority else None,
                        readiness=authority["readiness"] if authority else None)
        try:
            evidence["ci_run"] = green_ci_run(repo, head)
        except RuntimeError as e:
            reasons.append(str(e))
    return reasons, report


def green_ci_run(repo, head):
    """An actual successful ci.yml PR run at this head, not a guessed URL."""
    doc = gh_json(["api", f"repos/{repo}/actions/workflows/ci.yml/runs"
                   f"?head_sha={head}&event=pull_request&status=success&per_page=100"])
    runs = doc.get("workflow_runs") if isinstance(doc, dict) else None
    if not isinstance(runs, list):
        raise RuntimeError("cannot read a green CI run for the evidence comment")
    for run_ in runs:
        if not isinstance(run_, dict):
            continue
        run_id = run_.get("id")
        if (type(run_id) is int and run_id > 0
                and run_.get("head_sha") == head and run_.get("event") == "pull_request"
                and run_.get("status") == "completed" and run_.get("conclusion") == "success"
                and run_.get("html_url") == f"https://github.com/{repo}/actions/runs/{run_id}"):
            return run_["html_url"]
    raise RuntimeError(f"no successful ci.yml PR run is available for exact head {head}")


def evidence_body(evidence):
    lines = [f"Delivery evidence: {evidence['repo']}#{evidence['pr']}",
             f"Head: {evidence['head']}", f"Base: {evidence['base']}",
             f"Green CI run: {evidence['ci_run']}",
             "Required checks: " + ", ".join(evidence["checks"]),
             "Verdict notes: " + (", ".join(evidence["notes"]) or "none required")]
    binding = evidence.get("binding")
    if binding:
        lines.extend((f"Delivery class: {evidence['requirements']['class']}",
                      f"Policy digest: {binding['policy_digest']}"))
    readiness = evidence.get("readiness")
    if readiness:
        lines.extend((f"Outcome report: {readiness['outcome_report']}",
                      f"Native CI run: {readiness['ci_run_id']} {readiness['ci_run_url']}"))
    if evidence.get("approval"):
        lines.append("Operator approval id: " + evidence["approval"])
    return "\n".join(lines)


def check_evidence_head(args, repo, evidence):
    view = gh_json(["pr", "view", str(args.pr), "-R", repo, "--json",
                    "state,headRefOid,baseRefOid,autoMergeRequest"])
    if (view.get("state") != "OPEN" or view.get("headRefOid") != evidence["head"]
            or view.get("baseRefOid") != evidence["base"] or view.get("autoMergeRequest")):
        return ["PR head/base/state changed during evidence collection; revalidate before enqueue"]
    return []


def post_evidence(args, repo, evidence):
    """Post once only after preflight; no tracker write during dry-run."""
    if args.dry_run:
        return []
    reasons = check_evidence_head(args, repo, evidence)
    if reasons:
        return reasons
    body = evidence_body(evidence)
    if any(c.get("body") == body for c in evidence["comments"]):
        return []
    rc, out, err = run(["cadence", "issue", "comment", evidence["issue"], "--file", "-"],
                       input_text=body)
    if rc != 0:
        return [f"evidence comment failed (rc {rc}): {(err or out).strip()[:200]}"]
    return []


def queued(repo, pr):
    owner, name = repo.split("/", 1)
    q = ("query($o:String!,$n:String!,$p:Int!){repository(owner:$o,name:$n)"
         "{pullRequest(number:$p){isInMergeQueue state}}}")
    rc, out, _ = run(["gh", "api", "graphql", "-f", f"query={q}", "-f", f"o={owner}",
                      "-f", f"n={name}", "-F", f"p={pr}"])
    if rc != 0:
        return False
    try:
        p = json.loads(out)["data"]["repository"]["pullRequest"]
    except (ValueError, KeyError, TypeError):
        return False
    return p.get("isInMergeQueue") is True or p.get("state") == "MERGED"


def enqueue(args, repo):
    rc, out, err = run(["gh", "pr", "merge", str(args.pr), "-R", repo, "--auto", "--squash",
                        "--match-head-commit", args.head])
    if rc != 0:
        print(f"{ME}: gh pr merge failed: {(err or out).strip()}", file=sys.stderr)
    else:
        deadline = time.monotonic() + args.poll_secs
        while True:
            if queued(repo, args.pr):
                print(f"{ME}: PR #{args.pr} is in the merge queue at {args.head}")
                return 0
            if time.monotonic() >= deadline:
                break
            time.sleep(args.poll_interval)
        print(f"{ME}: PR #{args.pr} did not enter the merge queue within {args.poll_secs}s", file=sys.stderr)
    for _ in range(2):  # one retry before shouting
        rc, out, err = run(["gh", "pr", "merge", str(args.pr), "-R", repo, "--disable-auto"])
        if rc == 0:
            break
    if rc != 0:
        print(f"{ME}: DANGER: --disable-auto failed; auto-merge may still be on: {(err or out).strip()}", file=sys.stderr)
    else:
        print(f"{ME}: auto-merge disabled again", file=sys.stderr)
    return 1


def main(argv):
    ap = argparse.ArgumentParser(prog=ME, description="Enqueue a PR only when review, checks and approval hold.")
    ap.add_argument("pr", type=int)
    ap.add_argument("--head", required=True, help="the full 40-hex head SHA the review covered")
    ap.add_argument("--repo")
    ap.add_argument("--notes-dir", default=os.environ.get("CADENCE_NOTES_DIR", DEFAULT_NOTES_DIR))
    ap.add_argument("--author", action="append", default=[], help="an extra alias that authored the PR")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--poll-secs", type=float, default=30)
    ap.add_argument("--poll-interval", type=float, default=2)
    args = ap.parse_args(argv)
    args.head = args.head.lower()
    if args.pr < 1 or not FULL_SHA.match(args.head):
        print(f"{ME}: --head must be the full 40-hex SHA and <pr> a positive number", file=sys.stderr)
        return 2
    repo = args.repo
    try:
        if not repo:
            repo = gh_json(["repo", "view", "--json", "nameWithOwner"])["nameWithOwner"]
        if not re.match(r"^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$", repo):
            print(f"{ME}: bad repo {repo!r}", file=sys.stderr)
            return 2
        if args.dry_run:
            reasons, report = evaluate(args, repo)
        else:
            evidence = {}
            reasons, report = evaluate(args, repo, require_comment=False, evidence=evidence)
            if not reasons:
                reasons += post_evidence(args, repo, evidence)
            if not reasons:
                # Re-read every gate after the write, including approvals and comments.
                final_evidence = {}
                reasons, report = evaluate(args, repo, evidence=final_evidence)
                reasons += check_evidence_head(args, repo, evidence)
                if (not reasons and (final_evidence.get("binding") != evidence.get("binding")
                                     or final_evidence.get("requirements") != evidence.get("requirements")
                                     or final_evidence.get("readiness") != evidence.get("readiness")
                                     or final_evidence.get("approval") != evidence.get("approval"))):
                    reasons.append("delivery policy/base/readiness binding changed after evidence collection; revalidate before enqueue")
    except (RuntimeError, KeyError, TypeError) as e:
        reasons, report = [f"cannot read the PR: {e}"], []
    for line in report:
        print(f"{ME}: {line}")
    if reasons:
        for r in reasons:
            print(f"{ME}: refused: {r}", file=sys.stderr)
        return 1
    if args.dry_run:
        print(f"{ME}: dry run: every rule holds for PR #{args.pr} at {args.head}; nothing enqueued")
        return 0
    return enqueue(args, repo)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
