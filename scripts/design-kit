#!/usr/bin/env python3
"""CAD-582: regenerate the design kit's token files from the app theme.

The board's theme lives in ui/src/styles.css: the `@theme` block (fonts,
the ink scale, accent/ok/fail/warn/info, edge, scrim, text sizes) is the
dark theme, and the light theme re-points the colour variables in two
places the file asks editors to keep in step — the `prefers-color-scheme:
light` media query and `:root[data-theme="light"]`. This script reads
that one source and writes:

  - design/tokens.css — every variable as a CSS custom property under
    `:root` (dark defaults), plus the light overrides under the media
    query and `[data-theme="light"]`, and the themed set re-declared dark
    under `[data-theme="dark"]`. The `[data-theme]` rules are not tied to
    `:root`, so a mockup can scope a subtree (`<section data-theme=
    "light">`) without flipping the whole page.
  - design/tokens.json — the same values for non-CSS tools:
    `dark` holds the full variable set, `light` only what it overrides,
    `themed` the variable names (sans `--`) that change between themes.

The run is deterministic: declarations are emitted in source order and
the JSON is stable for identical input. `--check` regenerates in memory
and fails when either output is stale against styles.css — that check
runs in CI (the `fmt` job), so tokens cannot drift from the theme.

Run from anywhere:

    scripts/design-kit           regenerate design/tokens.css + tokens.json
    scripts/design-kit --check   verify both are fresh; exit 1 if stale
"""

from __future__ import annotations

import difflib
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "ui" / "src" / "styles.css"
OUT_CSS = ROOT / "design" / "tokens.css"
OUT_JSON = ROOT / "design" / "tokens.json"

HEADER = """\
/* Generated by scripts/design-kit from ui/src/styles.css — do not edit.
 * Regenerate: `scripts/design-kit`. Verify: `scripts/design-kit --check`.
 *
 * `:root` carries the dark theme (the @theme defaults). The light theme
 * re-points only the variables listed under `themed` in tokens.json, via
 * the system preference or a `data-theme` pick. The [data-theme] rules
 * are deliberately not tied to :root, so a mockup can scope a subtree
 * (`<section data-theme="light">`) without flipping the whole page.
 */
"""


def braces(text: str, start: int) -> str:
    """The brace-balanced block whose `{` follows offset `start`."""
    open_at = text.index("{", start)
    depth = 0
    for i in range(open_at, len(text)):
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
            if depth == 0:
                return text[open_at + 1 : i]
    raise ValueError("unbalanced braces")


def find_block(text: str, selector: str) -> str:
    """The declarations inside `selector { ... }`."""
    at = text.find(selector)
    if at == -1:
        raise ValueError(f"{selector!r} not found in {SOURCE.name}")
    return braces(text, at)


def declarations(block: str) -> list[tuple[str, str]]:
    """`name: value` pairs in order, comments stripped, values trimmed."""
    clean = re.sub(r"/\*.*?\*/", "", block, flags=re.S)
    return [
        (m.group(1).strip(), m.group(2).strip())
        for m in re.finditer(r"([\w-]+)\s*:\s*([^;{}]+);", clean)
    ]


def read_source() -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
    """(theme vars incl. color-scheme, light overrides) from styles.css."""
    text = SOURCE.read_text()

    theme = find_block(text, "@theme")
    dark = declarations(theme)
    if not dark or not any(k == "--color-ink-900" for k, _ in dark):
        raise ValueError("@theme block did not yield the ink scale")

    # The file keeps the light theme twice (a media query cannot share a
    # selector list) and asks editors to keep them in step — enforce it.
    media = find_block(text, "@media (prefers-color-scheme: light)")
    via_media = dict(declarations(find_block(media, ":root:not([data-theme")))
    via_attr = dict(declarations(find_block(text, ':root[data-theme="light"]')))
    if via_media != via_attr:
        keys = sorted(set(via_media) | set(via_attr))
        drift = [
            f"  {k}: media={via_media.get(k)!r} attr={via_attr.get(k)!r}"
            for k in keys
            if via_media.get(k) != via_attr.get(k)
        ]
        raise ValueError(
            "the two light-theme blocks in styles.css disagree:\n" + "\n".join(drift)
        )
    return dark, list(via_media.items())


def render_css(dark: list[tuple[str, str]], light: list[tuple[str, str]]) -> str:
    themed = {k for k, _ in light} - {"color-scheme"}
    dark_themed = [(k, v) for k, v in dark if k in themed]
    light_vars = [(k, v) for k, v in light if k != "color-scheme"]

    def decls(pairs: list[tuple[str, str]], indent: str) -> str:
        return "\n".join(f"{indent}{k}: {v};" for k, v in pairs)

    return (
        HEADER
        + "\n:root {\n  color-scheme: dark;\n\n"
        + decls(dark, "  ")
        + "\n}\n\n@media (prefers-color-scheme: light) {\n"
        + "  :root:not([data-theme=\"dark\"]) {\n    color-scheme: light;\n"
        + decls(light_vars, "    ")
        + "\n  }\n}\n\n[data-theme=\"light\"] {\n  color-scheme: light;\n"
        + decls(light_vars, "  ")
        + "\n}\n\n[data-theme=\"dark\"] {\n  color-scheme: dark;\n"
        + decls(dark_themed, "  ")
        + "\n}\n"
    )


def render_json(dark: list[tuple[str, str]], light: list[tuple[str, str]]) -> str:
    strip = lambda pairs: {k.removeprefix("--"): v for k, v in pairs if k != "color-scheme"}
    doc = {
        "comment": "generated by scripts/design-kit from ui/src/styles.css — do not edit",
        "dark": {**strip(dark), "color-scheme": "dark"},
        "light": {**strip(light), "color-scheme": "light"},
        "themed": [k.removeprefix("--") for k, _ in light if k != "color-scheme"],
    }
    return json.dumps(doc, indent=2, ensure_ascii=False) + "\n"


def main() -> int:
    check = "--check" in sys.argv[1:]
    unknown = [a for a in sys.argv[1:] if a != "--check"]
    if unknown:
        print(f"design-kit: unknown argument(s): {' '.join(unknown)}", file=sys.stderr)
        return 2
    try:
        dark, light = read_source()
    except (ValueError, OSError) as e:
        print(f"design-kit: {e}", file=sys.stderr)
        return 1
    outputs = {OUT_CSS: render_css(dark, light), OUT_JSON: render_json(dark, light)}

    if check:
        stale = []
        for path, want in outputs.items():
            if not path.exists() or path.read_text() != want:
                stale.append(path)
        if stale:
            names = ", ".join(str(p.relative_to(ROOT)) for p in stale)
            print(f"design-kit: {names} stale against {SOURCE.relative_to(ROOT)}", file=sys.stderr)
            have = stale[0].read_text() if stale[0].exists() else ""
            diff = difflib.unified_diff(
                have.splitlines(),
                outputs[stale[0]].splitlines(),
                fromfile=str(stale[0].relative_to(ROOT)),
                tofile="regenerated",
                lineterm="",
            )
            print("\n".join(list(diff)[:60]), file=sys.stderr)
            print("run `scripts/design-kit` and commit the result", file=sys.stderr)
            return 1
        print("design-kit: tokens.css and tokens.json are up to date")
        return 0

    for path, content in outputs.items():
        path.parent.mkdir(exist_ok=True)
        path.write_text(content)
        print(f"wrote {path.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
