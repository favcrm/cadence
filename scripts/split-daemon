# rustc is authoritative on unused imports: a trait leaf kept by
# method-name evidence that really resolved to an inherent method is
# dropped here so the generated tree stays warning-free.
DROP_USES = {
    # `uid`/`gid` evidence in serve.rs resolves to other receivers —
    # rustc flags the trait import unused.
    "src/daemon/serve.rs": ("std::os::unix::fs::MetadataExt",),
}


# --------------------------------------------------------------------------
# Lexer: mask comments, strings and char literals so brace tracking is safe.
# --------------------------------------------------------------------------


def mask(src):
    """Blank comments, strings and char literals with spaces, preserving
    length and line structure. Inline format captures (`"{name}"`) are
    real identifier references and stay unblanked."""
    out = list(src)
    i, n = 0, len(src)

    def blank(a, b):
        for j in range(a, b):
            if out[j] != "\n":
                out[j] = " "

    while i < n:
        c = src[i]
        if src.startswith("//", i):
            j = src.find("\n", i)
            j = n if j < 0 else j
            blank(i, j)
            i = j
        elif src.startswith("/*", i):
            depth = 1
            j = i + 2
            while j < n and depth:
                if src.startswith("/*", j):
                    depth += 1
                    j += 2
                elif src.startswith("*/", j):
                    depth -= 1
                    j += 2
                else:
                    j += 1
            blank(i, j)
            i = j
        elif c == "r" and i + 1 < n and src[i + 1] in '"#':
            m = re.match(r'r(#+)"', src[i:])
            if m:
                hashes = m.group(1)
                end = '"' + hashes
                j = src.find(end, i + len(hashes) + 2)
                j = n if j < 0 else j + len(end)
            else:
                j = src.find('"', i + 2)
                j = n if j < 0 else j + 1
            blank(i, j)
            i = j
        elif c == '"':
            j = i + 1
            while j < n:
                if src[j] == "\\":
                    j += 2
                    continue
                if src[j] == '"':
                    j += 1
                    break
                j += 1
            caps = [
                (m.start(1), m.end(1))
                for m in re.finditer(r"\{([A-Za-z_]\w*)[}:]", src[i:j])
            ]
            blank(i, min(j, n))
            for a, b in caps:
                out[i + a : i + b] = src[i + a : i + b]
            i = j
        elif c == "'":
            m = re.match(r"'(\\.|[^\\'])'", src[i:])
            if m:
                blank(i, i + m.end())
                i += m.end()
            else:
                i += 1
        else:
            i += 1
    return "".join(out)


def depth_map(masked):
    """Curly depth at each line start — used to find top-level items and,
    inside an `impl` block, method boundaries."""
    depths = []
    d = 0
    for line in masked.split("\n"):
        depths.append(d)
        d += line.count("{") - line.count("}")
    return depths


def top_offsets(text):
    """Offsets of `,` at depth 0 of `{`/`(`/`[`/`<` in `text`."""
    out = []
    a = b = c = g = 0
    prev = ""
    for i, ch in enumerate(text):
        if ch == "{":
            a += 1
        elif ch == "}":
            a -= 1
        elif ch == "(":
            b += 1
        elif ch == ")":
            b -= 1
        elif ch == "[":
            c += 1
        elif ch == "]":
            c -= 1
        elif ch == "<" and prev != "-" and not g:
            g += 1
        elif ch == ">" and g:
            g -= 1
        elif ch == "," and a == b == c == g == 0:
            out.append(i)
        prev = ch
    return out


def split_top(text):
    offs = top_offsets(text)
    parts, last = [], 0
    for o in offs:
        parts.append(text[last:o])
        last = o + 1
    parts.append(text[last:])
    return parts


# --------------------------------------------------------------------------
# Top-level item scan.
# --------------------------------------------------------------------------

# The ABI string in `extern "C"` is blanked by the mask before this runs,
# so the optional ABI token must tolerate whitespace-only text.
ITEM_START = re.compile(
    r"^(?:pub(?:\([^)]*\))?\s+)?(?:unsafe\s+)?"
    r"(?:extern\s+(?:\"[A-Za-z]+\"\s+)?)?"
    r"(fn|enum|struct|const|static|type|impl|mod|trait|use|macro_rules!)\b"
)
ITEM_HEAD = re.compile(r"^(?:pub(?:\([^)]*\))?\s+)?(fn|enum|struct|const|static|type|impl|mod|trait)\b")


def item_name(kind, masked_head, masked_body):
    if kind == "use":
        return None
    if kind == "impl":
        # `impl Default for Notify` follows Notify, not Default.
        m = re.search(
            r"\bimpl\b(?:\s*<[^>]*>)?\s+([A-Za-z_]\w*)\s+for\s+([A-Za-z_]\w*)",
            masked_body,
        )
        if m:
            return m.group(2)
        m = re.search(r"\bimpl\b(?:\s*<[^>]*>)?\s+([A-Za-z_]\w*)", masked_body)
        return m.group(1) if m else None
    m = re.search(rf"\b{kind}\s+([A-Za-z_]\w*)", masked_head)
    return m.group(1) if m else None


def scan_items(src, masked):
    lines = src.split("\n")
    mlines = masked.split("\n")
    depths = depth_map(masked)
    items = []
    i, n = 0, len(lines)
    while i < n:
        ml = mlines[i].strip()
        if depths[i] == 0 and mlines[i] == mlines[i].lstrip() and ITEM_START.match(ml):
            kind = ITEM_START.match(ml).group(1)
            # preamble: everything since the previous item's end, minus
            # leading blank lines — keeps multi-line #[...] attrs, doc
            # comments and section banners attached to their item, and
            # loses no text.
            prev_end = items[-1]["end"] if items else -1
            block_start = prev_end + 1
            while block_start < i and lines[block_start].strip() == "":
                block_start += 1
            # item end
            if kind in ("use", "static", "const", "type"):
                # `;` terminator at top bracket depth — a `;` inside
                # `[T; N]` array types or `(...)` does not end the item.
                end = i
                da = db = dc = 0
                while True:
                    for ch in mlines[end]:
                        if ch == "(":
                            db += 1
                        elif ch == ")":
                            db -= 1
                        elif ch == "[":
                            dc += 1
                        elif ch == "]":
                            dc -= 1
                        elif ch == "{":
                            da += 1
                        elif ch == "}":
                            da -= 1
                        elif ch == ";" and da == db == dc == 0:
                            break
                    else:
                        end += 1
                        continue
                    break
            else:
                d = 0
                end = i
                opened = False
                for jj in range(i, n):
                    d += mlines[jj].count("{") - mlines[jj].count("}")
                    if "{" in mlines[jj]:
                        opened = True
                    if opened and d == 0:
                        end = jj
                        break
                    if not opened and ";" in mlines[jj]:
                        end = jj
                        break
            items.append(
                {
                    "kind": kind,
                    "name": item_name(kind, ml, "\n".join(mlines[i : end + 1])),
                    "start": block_start,
                    "code": i,
                    "end": end,
                    "text": "\n".join(lines[block_start : end + 1]),
                }
            )
            i = end + 1
        else:
            i += 1
    return items


def scan_methods(item, lines, mlines, depths):
    """Method boundaries at brace depth 1 inside an `impl` block, each
    carrying its attribute/doc preamble."""
    out = []
    i, end = item["code"], item["end"]
    fn_head = re.compile(
        r"^(?:pub\s+|pub\([^)]*\)\s+)?(?:const\s+)?(?:unsafe\s+)?"
        r"(?:async\s+)?fn\s+([A-Za-z_]\w*)"
    )
    while i <= end:
        if depths[i] == 1 and fn_head.match(mlines[i].strip()):
            name = fn_head.match(mlines[i].strip()).group(1)
            j = i
            while j <= end and not (depths[j + 1] == 1 and depths[j] > 1):
                j += 1
            k = i - 1
            while k > item["code"] and (
                mlines[k].strip().startswith("#[")
                or lines[k].strip().startswith("///")
                or lines[k].strip().startswith("//")
                or mlines[k].strip() == ""
            ):
                k -= 1
            out.append(
                {
                    "kind": "fn",
                    "name": name,
                    "method": True,
                    "impl": item,
                    "start": k + 1,
                    "code": i,
                    "end": j,
                    "text": "\n".join(lines[k + 1 : j + 1]),
                }
            )
            i = j + 1
        else:
            i += 1
    return out


def vis_of(text):
    """The item's existing visibility: 'pub', 'pub(crate)', 'pub(super)'
    or '' (private). Comments and attributes are skipped."""
    for ln in text.split("\n"):
        s = ln.strip()
        if not s or s.startswith("//") or s.startswith("#["):
            continue
        m = re.match(r"(pub(?:\([^)]*\))?)\s+", s)
        return m.group(1) if m else ""
    return ""


def set_vis(text, vis):
    """Set an item's visibility: private items get `vis` prepended on the
    keyword line (methods keep their indentation); existing pub* is left
    alone (re-exports keep it)."""
    if not vis:
        return text
    lines = text.split("\n")
    for i, ln in enumerate(lines):
        m = re.match(r"^(\s*)(fn|enum|struct|const|static|type|mod|impl)\b", ln)
        if m:
            if not ln.lstrip().startswith("pub"):
                lines[i] = f"{m.group(1)}{vis} {ln.lstrip()}"
            break
    return "\n".join(lines)


def promote_fields(text, vis):
    """A struct promoted to `vis` needs its fields at the same scope: in
    the flat source file a private field was visible module-wide, which
    post-split means `pub(super)` inside `daemon`. Enum variants already
    share the enum's visibility, so this is structs only."""
    mtext = mask(text)
    bi = mtext.find("{")
    if bi < 0:
        # tuple struct `struct S(T1, T2);` — promote positionals
        pi, pe = mtext.find("("), mtext.rfind(")")
        if pi < 0 or pe <= pi:
            return text
        inner = text[pi + 1 : pe]
        parts = top_offsets(inner)
        seg, last = [], 0
        for off in parts + [len(inner)]:
            fld = inner[last:off]
            seg.append(fld)
            last = off + 1
        fixed = []
        for fld in seg:
            s = fld.lstrip()
            lead = fld[: len(fld) - len(s)]
            if s.strip() and not s.startswith("pub"):
                fld = lead + f"{vis} " + s
            fixed.append(fld)
        return text[: pi + 1] + ",".join(fixed) + text[pe:]
    close = text.rfind("}")
    lines = text[bi + 1 : close].split("\n")
    out = []
    for ln in lines:
        m = re.match(r"^(\s+)(pub(?:\([^)]*\))?\s+)?([A-Za-z_]\w*)\s*:", ln)
        if m and not m.group(2):
            ln = f"{m.group(1)}{vis} {ln.lstrip()}"
        out.append(ln)
    return text[: bi + 1] + "\n".join(out) + text[close:]


def use_stmt(text):
    """The `use …;` statement inside an item's text (attrs and doc
    comments may precede it), whitespace-normalised."""
    ls = text.strip().split("\n")
    for i, ln in enumerate(ls):
        if re.match(r"^(pub(?:\([^)]*\))?\s+)?use ", ln):
            return " ".join(" ".join(ls[i:]).split())
    raise SystemExit(f"no use statement in {text[:80]!r}")


def use_bindings(u):
    """'use a::b::{c, d::e, self, f as g};' → [(name, full-path)]."""
    m = re.match(r"^(?:pub(?:\([^)]*\))?\s+)?use (.*);$", u.strip())
    assert m, u
    s = m.group(1).strip()

    def join(a, b):
        if not a:
            return b
        return a + "::" + b.rstrip(":")

    def rec(prefix, node):
        node = node.strip()
        if not node:
            return
        if node == "self":
            yield prefix.rsplit("::", 1)[-1], prefix
            return
        if node == "*":
            yield "*", prefix + "::*"
            return
        m = re.match(r"([\w:]+)\s+as\s+(\w+)$", node)
        if m:
            yield m.group(2), join(prefix, m.group(1))
            return
        if "{" in node:
            head, rest = node.split("{", 1)
            inner = rest.rsplit("}", 1)[0]
            for part in split_top(inner):
                yield from rec(join(prefix, head.strip().rstrip(":")), part)
            return
        yield node.rsplit("::", 1)[-1], join(prefix, node)

    return list(rec("", s))


def rustfmt(text):
    """Format emitted Rust the way `cargo fmt` will, so generated files are
    fmt-clean the moment they land (and `--check` compares the formatted
    form)."""
    try:
        p = subprocess.run(
            ["rustfmt", "--edition", "2021", "--emit", "stdout"],
            input=text,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        raise SystemExit("rustfmt not found on PATH")
    if p.returncode != 0:
        raise SystemExit("rustfmt failed on generated output:\n" + p.stderr)
    return p.stdout


def external_names():
    """Names the rest of the crate reaches as `crate::daemon::<name>` —
    they must keep resolving from the split root."""
    names = set()
    pat = re.compile(r"\bdaemon::([A-Za-z_]\w*)")
    brace = re.compile(r"\bdaemon::\{([^}]*)\}")
    for root in ("src", "tests"):
        for path in Path(root).rglob("*.rs"):
            if str(path).startswith("src/daemon/"):
                continue
            text = path.read_text()
            names.update(pat.findall(text))
            for inner in brace.findall(text):
                for part in inner.split(","):
                    part = part.strip()
                    if part:
                        names.add(part.split(" as ")[0].strip())
    names.discard("mod")
    return names


def existing_area_texts():
    """Masked text of the hand-written sibling area files already in
    src/daemon/ — their `self.<method>` calls and `super::<item>` paths are
    real referencers that decide visibility promotion. The generator's own
    output files are skipped, so a re-run over a split tree produces the
    same plan as a run over the pre-split file."""
    out = []
    for path in sorted(Path(DIR).glob("*.rs")):
        if path.name == "mod.rs" or path.stem in AREAS:
            continue
        out.append(mask(path.read_text()))
    return out


# --------------------------------------------------------------------------
# Post-split `--check`: the manifest is the source of truth once the
# pre-split file is consumed.
# --------------------------------------------------------------------------


def inventory_of(path):
    """Item names in a generated file: top-level items (impl blocks
    replaced by their methods) and `mod` declarations."""
    text = Path(path).read_text()
    masked = mask(text)
    lines = text.split("\n")
    mlines = masked.split("\n")
    depths = depth_map(masked)
    found = set()
    for it in scan_items(text, masked):
        if it["kind"] == "use":
            continue
        if it["kind"] == "impl" and it["name"] == "Shared":
            found.update(
                m["name"] for m in scan_methods(it, lines, mlines, depths)
            )
            continue
        if it["name"]:
            found.add(it["name"])
    return found


def check_consistency():
    if not Path(MANIFEST).exists():
        raise SystemExit(f"{MANIFEST} missing — run scripts/split-daemon")
    sections = {}
    stem = None
    for line in Path(MANIFEST).read_text().split("\n"):
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            stem = line[1:-1]
            sections[stem] = []
        elif line.startswith("items = [") and stem is not None:
            sections[stem].extend(re.findall(r'"([^"]+)"', line))
    bad = []
    files = {"mod": SRC}
    for stem, names in sections.items():
        path = files.get(stem, f"{DIR}/{stem}.rs")
        if not Path(path).exists():
            bad.append(f"missing: {path}")
            continue
        found = inventory_of(path)
        want = {n for n in names if not n.startswith("<")}
        if found - want:
            bad.append(f"{path}: unlisted items {sorted(found - want)}")
        if want - found:
            bad.append(f"{path}: missing items {sorted(want - found)}")
    expected = {f"{DIR}/{s}.rs" for s in sections if s != "mod"} | {SRC}
    bad += [
        f"extra: {p}"
        for p in sorted(Path(DIR).glob("*.rs"))
        if str(p) not in expected and p.stem not in SIBLINGS
    ]
    if bad:
        print("\n".join(bad))
        sys.exit(1)
    print("split-daemon: generated tree consistent with manifest")


def main():
    check = "--check" in sys.argv
    dump = "--dump" in sys.argv
    src_path = Path(SRC)
    if not src_path.exists():
        raise SystemExit(f"{SRC} is gone — restore it from the base commit")
    src = src_path.read_text()
    if MARKER in src:
        if check or dump:
            check_consistency()
            return
        raise SystemExit(
            f"{SRC} is already the split root ({MARKER!r}); restore the "
            "pre-split file from the base commit to regenerate"
        )

    masked = mask(src)
    lines = src.split("\n")
    mlines = masked.split("\n")
    depths = depth_map(masked)
    top_items = scan_items(src, masked)
    if not top_items:
        raise SystemExit(f"no items found in {SRC}")

    # ---- module docs ride the first item's preamble; slice them out ----
    leading_docs = []
    for ln in lines:
        if ln.startswith("//!") or (not ln.strip() and leading_docs):
            leading_docs.append(ln)
        else:
            break
    while leading_docs and not leading_docs[-1].strip():
        leading_docs.pop()

    # ---- inventory: top-level items, `impl Shared` blocks expanded ----
    uses, units, impl_blocks = [], [], []
    for it in top_items:
        if it["kind"] == "use":
            last = it["text"].strip().split("\n")[-1]
            if last.startswith("pub"):
                it["keep"] = True  # `pub use` — module surface, verbatim
                units.append(it)
            else:
                uses.append(it)
            continue
        if it["kind"] == "impl" and it["name"] == "Shared":
            it["methods"] = scan_methods(it, lines, mlines, depths)
            if not it["methods"]:
                raise SystemExit(
                    f"no methods found in impl at line {it['code'] + 1}"
                )
            impl_blocks.append(it)
            units.extend(it["methods"])
            continue
        units.append(it)

    by_name = {}
    for it in units:
        if it.get("keep") or it["kind"] == "mod":
            continue
        if it["name"]:
            by_name.setdefault(it["name"], []).append(it)
        else:
            raise SystemExit(f"unnamed {it['kind']} at line {it['code'] + 1}")

    # ---- placement ----
    external = external_names()
    area_set = set(AREAS)

    def seed_home(it):
        if it.get("keep") or it["kind"] == "mod":
            return "mod"
        n = it["name"]
        if n in external:
            return "mod"
        if n in PLACE:
            home = PLACE[n]
            if home != "mod" and home not in area_set:
                raise SystemExit(f"PLACE[{n}] names unknown area {home}")
            return home
        for rx, area in AREA_SEED_RULES:
            if rx.match(n or ""):
                return area
        return None

    home = {id(it): seed_home(it) for it in units}
    texts = {id(it): mask(it["text"]) for it in units}
    by_id = {id(it): it for it in units}
    test_ids = {
        id(it)
        for it in units
        if it["kind"] == "mod" and it["name"] in TEST_MODS
    }

    def refs(text, name):
        return len(re.findall(rf"\b{re.escape(name)}\b", text))

    # The root's own text anchors references to 'mod'; the sibling area
    # files already in src/daemon/ see the root's scope, so they anchor
    # there too (a `super::<item>` path keeps resolving from the root).
    core_text = "\n".join(
        texts[id(it)] for it in units if home.get(id(it)) == "mod"
    )
    other_text = "\n".join(existing_area_texts())

    def referencers(name, exclude_id, with_tests=False):
        """Placement referencers: test modules never anchor a home. The
        visibility pass (`with_tests=True`) counts them, because they
        reach moved names through the root's scope."""
        out = set()
        for iid, t in texts.items():
            if iid == exclude_id:
                continue
            if not with_tests and iid in test_ids:
                continue
            it = by_id[iid]
            if it["kind"] == "impl" and it["name"] == name:
                continue  # `impl X` follows X's home, never anchors it
            if refs(t, name):
                out.add(iid)
        if refs(core_text, name):
            out.add(("core",))
        if refs(other_text, name):
            out.add(("other",))
        return out

    def key_home(k):
        if k in (("core",), ("other",)):
            return "mod"
        return home.get(k)

    def fixpoint():
        moved = True
        while moved:
            moved = False
            for it in units:
                iid = id(it)
                if it["kind"] in ("use", "impl") or home.get(iid) is not None:
                    continue
                rs = referencers(it["name"], iid)
                pending = any(key_home(k) is None for k in rs)
                hs = {key_home(k) for k in rs}
                hs.discard(None)
                if len(hs) > 1 or (len(hs) == 0 and not pending):
                    home[iid] = "mod"
                    moved = True
                elif len(hs) == 1 and not pending:
                    home[iid] = next(iter(hs))
                    moved = True
                # pending referencers: defer to a later pass

    fixpoint()
    # impls follow their type's home; then re-run for deferred items.
    for it in units:
        if it["kind"] == "impl" and it["name"] and home.get(id(it)) is None:
            th = next(
                (
                    home.get(id(o))
                    for o in units
                    if o["name"] == it["name"] and o["kind"] != "impl"
                ),
                None,
            )
            home[id(it)] = th or "mod"
    fixpoint()
    # unresolvable cycles / deferred → root.
    for iid, h in home.items():
        if h is None:
            home[iid] = "mod"

    # ---- visibility: private items named across files get `pub(super)` ----
    def ref_files(it):
        iid = id(it)
        out = set()
        for r in referencers(it["name"], iid, with_tests=True):
            if r in (("core",), ("other",)) or r in test_ids:
                out.add("mod")
            else:
                out.add(home.get(r) or "mod")
        return out

    needs_super = set()
    for it in units:
        if it["kind"] in ("use", "impl") or not it["name"]:
            continue
        h = home[id(it)]
        if h == "mod" or vis_of(it["text"]):
            continue
        if any(f != h for f in ref_files(it)):
            needs_super.add(id(it))
    # A private item the rest of the crate names as `crate::daemon::<X>`
    # needs the root to re-bind it (`use <area>::X;`) — promote it even
    # when nothing inside `daemon` crosses files for it.
    for it in units:
        if (
            it["name"] in external
            and home.get(id(it)) not in (None, "mod")
            and not vis_of(it["text"]).startswith("pub")
        ):
            needs_super.add(id(it))

    # Signature propagation: a `pub(super)` fn must not expose a private
    # sibling type (`fn foo() -> Bar` needs Bar promoted too), likewise
    # struct fields and enum-variant payload types.
    def sig_head(it):
        mt = texts.get(id(it)) or mask(it["text"])
        if it["kind"] in ("enum", "struct"):
            return mt  # fields/variant payload types live inside the braces
        bi = mt.find("{")
        return mt[:bi] if bi >= 0 else mt

    changed = True
    while changed:
        changed = False
        for it in units:
            iid = id(it)
            if iid not in needs_super:
                continue
            h = home.get(iid)
            head = sig_head(it)
            for o in units:
                oid = id(o)
                if (
                    oid in needs_super
                    or o["kind"] in ("use", "impl")
                    or not o["name"]
                    or home.get(oid) != h
                    or vis_of(o["text"])
                    or not re.search(r"\b" + re.escape(o["name"]) + r"\b", head)
                ):
                    continue
                needs_super.add(oid)
                changed = True

    # ---------------- use lines ----------------
    bindings = []
    for u in uses:
        bindings += use_bindings(use_stmt(u["text"]))

    def bare(name, text):
        """A leaf survives only when its bound name occurs as a *bare*
        identifier — `Arc` inside `std::sync::Arc::new` does not need
        `use std::sync::Arc`."""
        return re.search(r"(?<![\w:.])" + re.escape(name) + r"\b", text)

    def bound_name(line):
        """`use a::b;` binds `b`; `use a::b as c;` binds `c`."""
        s = line[len("use ") : -1]
        if " as " in s:
            return s.rsplit(" as ", 1)[1].strip()
        if s.endswith("::*"):
            return None
        return s.rsplit("::", 1)[-1].strip()

    def uses_for(text, path=None):
        text = mask(text)
        out = []
        for name, use_path in bindings:
            if name == "*":
                keep = True
            else:
                keep = bool(bare(name, text))
            if not keep:
                # Trait leaves additionally survive on method-call
                # (`.m(`) or macro (`m!`) evidence, since a method call
                # never names its trait.
                meths = TRAIT_METHODS.get(use_path)
                keep = bool(meths) and any(
                    re.search(
                        r"\." + re.escape(m) + r"\s*\(|\b" + re.escape(m) + r"\s*!",
                        text,
                    )
                    for m in meths
                )
            if keep:
                leaf = use_path.rsplit("::", 1)[-1]
                line = (
                    f"use {use_path};" if leaf == name else f"use {use_path} as {name};"
                )
                if line not in out:
                    out.append(line)
        drop = set(DROP_USES.get(path or "", ()))
        return [u for u in out if u[len("use ") : -1].split(" as ")[0] not in drop]

    # ---------------- emit ----------------
    out = {}
    manifest = {"mod": []}
    for a in AREAS:
        manifest[a] = []

    def promote_impl(text):
        """`impl T` whose T crosses files: private methods were visible
        module-wide pre-split — restore that scope with `pub(super)`.
        Members sit at brace depth 1; trait impls (`impl X for Y`) are
        skipped — their members cannot carry visibility."""
        head = text[: mask(text).find("{")]
        if re.search(r"\bfor\b", head):
            return text
        out_lines = []
        depth = 0
        mlines2 = mask(text).split("\n")
        for ln, mln in zip(text.split("\n"), mlines2):
            if (
                depth == 1
                and re.match(r"^\s*(fn|const|type)\b", ln.lstrip())
                and not ln.lstrip().startswith("pub")
            ):
                ln = re.sub(r"^(\s*)", r"\1pub(super) ", ln)
            depth += mln.count("{") - mln.count("}")
            out_lines.append(ln)
        return "\n".join(out_lines)

    def emit_unit(it):
        """Visibility rewrite for one moved item in a child file."""
        t, promote, vis = it["text"], "", vis_of(it["text"])
        if not vis and id(it) in needs_super:
            promote = "pub(super)"
        if it["kind"] == "struct" and (vis or promote):
            t = promote_fields(t, "pub(super)")
        if it["kind"] == "impl" and it["name"] in crosses:
            t = promote_impl(t)
        return set_vis(t, promote)

    # Types whose fields/methods may be touched by other files: the item
    # already has visibility, or the move promoted it.
    crosses = {
        it["name"]
        for it in units
        if it["name"]
        and it["kind"] != "impl"
        and (vis_of(it["text"]) or id(it) in needs_super)
        and home.get(id(it)) not in ("mod", None)
    }

    # ---- chunk assembly: source order, `impl Shared` blocks filtered ----
    def is_decl(it):
        return (
            it["kind"] == "mod"
            and it["text"].strip().startswith("mod ")
            and it["text"].strip().endswith(";")
        )

    def chunks_for(target):
        chunks = []
        for it in top_items:
            if it["kind"] == "use":
                if it.get("keep") and target == "mod":
                    chunks.append(("item", it["code"], it["text"]))
                continue
            if it["kind"] == "impl" and it["name"] == "Shared":
                methods = [m for m in it["methods"] if home[id(m)] == target]
                if not methods:
                    continue
                # The root keeps its core verbatim; only a move into a
                # child rewrites visibility.
                body = "\n\n".join(
                    m["text"] if target == "mod" else emit_unit(m) for m in methods
                )
                head = it["text"][: mask(it["text"]).find("{") + 1]
                chunks.append(("impl", it["code"], head + "\n" + body + "\n}"))
                continue
            if home[id(it)] != target:
                continue
            if target == "mod" and is_decl(it):
                continue  # the declaration block is emitted whole
            text = it["text"] if target == "mod" else emit_unit(it)
            chunks.append(("item", it["code"], text))
        chunks.sort(key=lambda c: c[1])
        return chunks

    # ---- the split root (src/daemon.rs) ----
    mod_chunks = chunks_for("mod")
    # The `mod <x>;` block stays one contiguous block: the existing
    # declarations verbatim, then the new areas.
    decl_items = [it for it in top_items if is_decl(it)]
    decl_block = "\n".join(
        [it["text"].strip() for it in decl_items]
        + [f"mod {a};" for a in AREAS]
    )

    core_text_for_uses = "\n\n".join(
        c[2] for c in mod_chunks if not c[2].strip().startswith("#[cfg(test)]")
    )
    mod_body = "\n\n".join(c[2] for c in mod_chunks)
    # The root's `use` lines must carry everything the core and the test
    # suites reach through `use super::*`; names a test module binds
    # itself are not re-imported (that import would go unused).
    inner_bound = set()
    for it in units:
        if id(it) not in test_ids:
            continue
        for ln in it["text"].split("\n"):
            s = ln.strip()
            if s.startswith("use ") and s.endswith(";"):
                inner_bound.add(bound_name(s))
    inner_bound.discard(None)
    test_text = "\n".join(texts[i] for i in test_ids)
    mod_uses = list(
        dict.fromkeys(uses_for(core_text_for_uses, SRC) + uses_for(test_text, SRC))
    )
    mod_uses = [u for u in mod_uses if bound_name(u) not in inner_bound]
    covered = {bound_name(u) for u in mod_uses} - {None}

    reexports = []
    for a in AREAS:
        pub_names, crate_names, super_names = [], [], []
        for it in units:
            if home.get(id(it)) != a or it["kind"] in ("use", "impl") or not it["name"]:
                continue
            if it.get("method"):
                # An inherent method is reached through `Shared`, never
                # imported: the move only widens its visibility.
                continue
            v = vis_of(it["text"])
            if v == "pub":
                pub_names.append(it["name"])
            elif v == "pub(crate)":
                crate_names.append(it["name"])
            elif id(it) in needs_super:
                super_names.append(it["name"])
        if pub_names:
            reexports.append(f"pub use {a}::{{{', '.join(pub_names)}}};")
        for n in crate_names:
            reexports.append(f"#[allow(unused_imports)]\npub(crate) use {a}::{n};")
        if super_names:
            reexports.append(
                f"#[allow(unused_imports)]\nuse {a}::{{{', '.join(super_names)}}};"
            )

    root = (
        "\n".join(leading_docs)
        + f"\n\n{MARKER} — the RPC handlers live in src/daemon/<area>.rs;\n"
        "// the item→file map is src/daemon/split-map.toml\n"
        "// (scripts/split-daemon regenerates both). The core stays here:\n"
        "// the `Shared` struct, the actor loop / wake / lifecycle, the\n"
        "// constants, the RPC dispatch and the test suites.\n\n"
        + decl_block
        + "\n"
    )
    if mod_uses:
        root += "\n" + "\n".join(dict.fromkeys(mod_uses)) + "\n"
    root += "\n" + mod_body + "\n"
    if reexports:
        root += (
            "\n// Re-exports — every name the areas moved keeps resolving\n"
            "// at `crate::daemon::<Item>`; `pub(super)` lines re-bind moved\n"
            "// helpers at module scope (CAD-534).\n"
            + "\n".join(reexports)
            + "\n"
        )
    out[SRC] = root

    # ---- area files ----
    for a in AREAS:
        chunks = chunks_for(a)
        body_all = "\n\n".join(c[2] for c in chunks)
        fu = [
            u
            for u in uses_for(body_all, f"{DIR}/{a}.rs")
            if bound_name(u) not in covered
        ]
        ftxt = (
            f"//! CAD-534: `cadence daemon` {a.removesuffix('_rpc').replace('_', ' ')}"
            " RPC handlers — moved verbatim from src/daemon.rs; the\n"
            "//! item→file map is src/daemon/split-map.toml\n"
            "//! (scripts/split-daemon regenerates it).\n"
        )
        ftxt += "\nuse super::*;\n"
        if fu:
            ftxt += "\n" + "\n".join(dict.fromkeys(fu)) + "\n"
        ftxt += "\n" + body_all + "\n"
        out[f"{DIR}/{a}.rs"] = ftxt
        manifest[a] = [
            it["name"] for it in units if home.get(id(it)) == a and it["name"]
        ]

    # ---- manifest: the root lists its items, methods and test modules ----
    manifest["mod"] = [
        it["name"]
        for it in top_items
        if it["kind"] != "use"
        and it["name"]
        and not (it["kind"] == "impl" and it["name"] == "Shared")
        and home.get(id(it)) == "mod"
    ] + [
        m["name"]
        for it in impl_blocks
        for m in it["methods"]
        if home[id(m)] == "mod"
    ]

    # The new `mod <area>;` declarations live in the root too.
    manifest["mod"] += list(AREAS)

    # Format generated Rust the way `cargo fmt` will, so files land
    # fmt-clean and `--check` compares the formatted form.
    out = {p: (rustfmt(t) if p.endswith(".rs") else t) for p, t in out.items()}

    if dump:
        for p, t in sorted(out.items()):
            print(f"== {p}: {len(t.splitlines())} lines")
        print("== manifest")
        for stem, names in manifest.items():
            print(f"[{stem}] {len(names)} items")
        return

    if check:
        bad = [
            p
            for p, want in sorted(out.items())
            if not Path(p).exists() or Path(p).read_text() != want
        ]
        extra = [
            str(p)
            for p in Path(DIR).glob("*.rs")
            if str(p) not in out
        ]
        if bad or extra:
            for p in bad + extra:
                print(f"stale: {p}")
            sys.exit(1)
        print("split-daemon: outputs current")
        return

    for path, text in out.items():
        Path(path).parent.mkdir(parents=True, exist_ok=True)
        Path(path).write_text(text)
    ml = [
        "# CAD-534 split map — regenerated by scripts/split-daemon; do not edit."
    ]
    for stem in ["mod"] + AREAS:
        ml.append(f"[{stem}]")
        ml.append("items = [" + ", ".join(f'"{n}"' for n in manifest[stem]) + "]")
        ml.append("")
    Path(MANIFEST).write_text("\n".join(ml))
    print(f"wrote {len(out)} files (root + {len(AREAS)} areas) + manifest")


if __name__ == "__main__":
    main()
