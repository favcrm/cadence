#!/usr/bin/env python3
"""CAD-534: split src/daemon.rs into src/daemon/<area>.rs — RPC handlers by
area, move-only.

Reads the item inventory of src/daemon.rs (item heads, masked
comments/strings/char literals, attribute and doc preambles) and expands
every `impl Shared` block into its methods — depth-aware on masked text, so
a `fn` nested inside a method body is never mistaken for one — then emits:

    src/daemon.rs            — the split root: the `//!` module docs,
                               `mod <area>;` declarations, the shared `use`
                               surface, the core (the `Shared` struct,
                               `Notify`, constants, the actor loop / wake /
                               lifecycle, caller gates, serve machinery,
                               watch timers), the RPC dispatch
                               (`dispatch_method`, arms verbatim), the
                               `#[cfg(test)]` suites verbatim and the
                               re-exports that keep every moved name
                               resolving at `crate::daemon::<Item>`.
    src/daemon/<area>.rs     — one file per RPC area: its `rpc_*` methods,
                               the helpers and machinery only that area
                               references, emitted as `impl Shared { … }`
                               blocks (every method keeps its text
                               verbatim).
    src/daemon/split-map.toml — the generated item→file map.

Placement of a `rpc_*` method is its dispatch-arm prefix (AREA_SEED_RULES);
everything else is placed by, in order:

  1. PLACE      — explicit assignments in the table below (the core);
  2. usage      — referenced by exactly one home's items and by nothing
                  else, it follows that home (a referencer graph over
                  masked text);
  3. impl       — `impl X` follows wherever `X` lands;
  4. otherwise the item stays in src/daemon.rs.

A private item named by a referencer outside its own file becomes
`pub(super)` (visible inside `daemon`, unchanged from the outside);
`pub`/`pub(crate)` items keep their visibility plus a re-export line in
src/daemon.rs. `use` lines are rebuilt per file from bare-identifier
evidence plus trait-method calls; every area file gets `use super::*;`,
and names the root already binds are not re-imported (the glob carries
them). Test modules never anchor a placement, but they do force
`pub(super)`: they reach moved names through the root's scope.

Run from the repo root:

    scripts/split-daemon            # regenerate
    scripts/split-daemon --check    # verify outputs are current
    scripts/split-daemon --dump     # print the plan, write nothing
"""

import re
import subprocess
import sys
from pathlib import Path

SRC = "src/daemon.rs"
DIR = "src/daemon"
MANIFEST = f"{DIR}/split-map.toml"

# Marker the generated root carries; `--check` uses it to tell the split
# root from the pre-split file.
MARKER = "// CAD-534: split root"

