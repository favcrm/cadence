# `rpc_<verb>` → area, first match wins. These are the dispatch-arm
# prefixes (`"job_new" => self.rpc_job_new(…)`).
AREA_SEED_RULES = [
    (re.compile(r"^rpc_thread_"), "threads_rpc"),
    (re.compile(r"^rpc_memory_"), "memory_rpc"),
    (re.compile(r"^rpc_slot_"), "slots_rpc"),
    (re.compile(r"^rpc_(plan_|epic_|workflow_|app_|project_)"), "plans_rpc"),
    (re.compile(r"^rpc_(rollout_|approval_)"), "approvals_rpc"),
    (
        re.compile(
            r"^rpc_(register|set|stop|unfence|inbox|inbox_ack|ready|capture"
            r"|probe|events)$"
        ),
        "agents_rpc",
    ),
    (
        re.compile(
            r"^rpc_(send|send_from|ask|answer|message_report|interrupt"
            r"|cancel|reconcile|recover_submit)$"
        ),
        "messages_rpc",
    ),
    (
        re.compile(r"^rpc_(respond|request_open|request_wait|request_close)$"),
        "requests_rpc",
    ),
    (re.compile(r"^rpc_(job_|task_)"), "jobs_rpc"),
    (re.compile(r"^rpc_monitor_"), "monitors_rpc"),
    (re.compile(r"^rpc_model_defaults_"), "models_rpc"),
    # CAD-551: the master's provider-session state/commands (Pi slash
    # verbs) — the master area itself is the hand-written master_rpc.rs.
    (re.compile(r"^rpc_master_(state|command)$"), "master_session_rpc"),
]

