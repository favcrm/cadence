#!/usr/bin/env python3
"""CAD-426 phase 2: per-test assertion inventory for tests/*.rs.

For every fn, lists each assert-family macro's argument text (whitespace
collapsed, otherwise verbatim — the message is part of the contract).
One line per assertion:

    <file>::<fn> | <macro> | <args>

Test fns are labelled ` (test)`; asserts that live inside a helper carry
the helper's name — when phase 2 moves an assert into tests/common, its
line keeps identical args and only the file::fn prefix changes (the
expected mechanical rename).

Usage: scripts/assert-inventory [dir]   (default: tests/)
"""
import re
import sys
from pathlib import Path

BRSTR_RE = re.compile(r'br(#*)"')
RAWSTR_RE = re.compile(r'r(#*)"')
CHAR_LIT_RE = re.compile(r"'(?:[^'\\]|\\.)'")

FN_RE = re.compile(
    r"(?:^|\n)\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?fn\s+"
    r"([A-Za-z_][A-Za-z0-9_]*)"
)
TEST_ATTR_RE = re.compile(r"#\[[^\]]*\btest\b[^\]]*\]")
MACRO_RE = re.compile(r"\b(assert_eq!|assert_ne!|assert_matches!|assert!|panic!)")


def mask_src(text: str) -> str:
    """Replace comments and string/char literal contents with spaces so
    bracket matching and fn scanning never see them."""
    out = []
    i, n = 0, len(text)
    while i < n:
        if text.startswith("//", i):
            j = text.find("\n", i)
            j = n if j < 0 else j
            out.append(" " * (j - i))
            i = j
        elif text.startswith("/*", i):
            j = text.find("*/", i)
            j = n if j < 0 else j + 2
            out.append(" " * (j - i))
            i = j
        elif text[i] == '"':
            j = i + 1
            while j < n and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            out.append(" " * (j + 1 - i))
            i = j + 1
        elif text[i] == "b" and BRSTR_RE.match(text, i):
            m = BRSTR_RE.match(text, i)
            hashes = m.group(1)
            endmark = '"' + hashes
            j = text.find(endmark, i + 2 + len(hashes))
            j = n if j < 0 else j + len(endmark)
            out.append(" " * (j - i))
            i = j
        elif text[i] == "r":
            # raw string r"..." / r#"..."# / r##"..."##
            m = RAWSTR_RE.match(text, i)
            if m:
                hashes = m.group(1)
                endmark = '"' + hashes
                j = text.find(endmark, i + 1 + len(hashes))
                j = n if j < 0 else j + len(endmark)
                out.append(" " * (j - i))
                i = j
            elif i + 1 < n and text[i + 1] == '"':
                j = i + 2
                while j < n and text[j] != '"':
                    j += 1
                out.append(" " * (j + 1 - i))
                i = j + 1
            else:
                out.append(text[i])
                i += 1
        elif text[i] == "'":
            m = CHAR_LIT_RE.match(text, i)
            if m:
                out.append(" " * len(m.group(0)))
                i += len(m.group(0))
            else:
                out.append(text[i])
                i += 1
        else:
            out.append(text[i])
            i += 1
    return "".join(out)


def matching_paren(masked: str, open_pos: int) -> int:
    depth, k = 0, open_pos
    while k < len(masked):
        if masked[k] == "(":
            depth += 1
        elif masked[k] == ")":
            depth -= 1
            if depth == 0:
                return k
        k += 1
    return -1


def matching_brace(masked: str, open_pos: int) -> int:
    depth, k = 0, open_pos
    while k < len(masked):
        if masked[k] == "{":
            depth += 1
        elif masked[k] == "}":
            depth -= 1
            if depth == 0:
                return k
        k += 1
    return -1


def fn_spans(masked: str):
    """[(name, brace_start, brace_end, is_test)] for every top-level fn."""
    test_attrs = [a for a in TEST_ATTR_RE.finditer(masked)]
    spans = []
    ai = 0
    for m in FN_RE.finditer(masked):
        brace = masked.find("{", m.end())
        if brace < 0:
            continue
        end = matching_brace(masked, brace)
        if end < 0:
            continue
        # a test iff the nearest #[..test..] attr above it has only attrs /
        # ws / comments between it and the fn keyword
        while ai < len(test_attrs) and test_attrs[ai].end() <= m.start():
            ai += 1
        is_test = False
        if ai > 0:
            last = test_attrs[ai - 1]
            between = masked[last.end() : m.start()]
            if re.fullmatch(r"[\s#\[\]\w=(),:\"'/._-]*", between):
                is_test = True
        spans.append((m.group(1), brace, end, is_test))
    return spans


def norm_args(argtext: str) -> str:
    return re.sub(r"\s+", " ", argtext).strip()


def inventory(path: Path):
    text = path.read_text()
    masked = mask_src(text)
    spans = fn_spans(masked)
    spans.sort(key=lambda s: s[1])
    rows = []
    for m in MACRO_RE.finditer(masked):
        pos = m.start()
        host = None
        for _n, s, e, _t in spans:
            if s < pos < e:
                host = (_n, s, e, _t)
            elif s > pos:
                break
        if host is None:
            continue
        close = matching_paren(masked, masked.find("(", m.end() - 1))
        if close < 0:
            continue
        args = norm_args(text[masked.find("(", m.end() - 1) + 1 : close])
        tag = f"{host[0]}{' (test)' if host[3] else ''}"
        rows.append(f"{path}::{tag} | {m.group(1)} | {args}")
    return rows


def main():
    root = Path(sys.argv[1]) if len(sys.argv) > 1 else Path("tests")
    out = []
    for f in sorted(root.rglob("*.rs")):
        out.extend(inventory(f))
    print("\n".join(out))


if __name__ == "__main__":
    main()
