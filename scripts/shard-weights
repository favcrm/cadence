#!/usr/bin/env python3
"""Generate tests/shard-weights.json from nextest-cost artifacts.

Usage: scripts/shard-weights <costs-dir>... > tests/shard-weights.json

Each costs dir holds `nextest-costs-<run>-<attempt>-shard-<n>/` dirs;
every shard's `nextest-costs.json` lists executed tests under `slowest`
as `{suite, name, duration_s}` where `suite` is the nextest binary id.
Dirs are newest run first — a test's weight comes from the first dir
that has it — and for one run the highest attempt's shard wins. Only
tests at or above MIN_SECONDS are weighted; anything else falls back to
the runner's default weight at assignment time.
"""
import json
import math
import re
import sys
from pathlib import Path

MIN_SECONDS = 5.0

SHARD_DIR = re.compile(r"^nextest-costs-\d+-(\d+)-shard-\d+$")


def weights_from(costs_dir):
    """{key: seconds} for one run, highest attempt per shard."""
    # Attempt is numeric — lexicographic order would rank 10 below 9.
    # A directory that doesn't match the artifact naming fails loud
    # rather than being silently skipped.
    reports = {}
    for entry in Path(costs_dir).iterdir():
        if not entry.is_dir():
            continue
        match = SHARD_DIR.match(entry.name)
        if not match:
            raise ValueError(f"{costs_dir}: unparseable artifact dir {entry.name!r}")
        shard = int(entry.name.rsplit("-shard-", 1)[1])
        attempt = int(match.group(1))
        report = entry / "nextest-costs.json"
        if report.is_file() and attempt > reports.get(shard, (0, None))[0]:
            reports[shard] = (attempt, report)
    weights = {}
    for _, report in sorted(reports.values()):
        data = json.loads(report.read_text())
        for entry in data.get("slowest", []):
            try:
                suite, name = entry["suite"], entry["name"]
                seconds = entry["duration_s"]
            except (KeyError, TypeError):
                raise ValueError(
                    f"{report}: malformed slowest entry: {entry!r}"
                ) from None
            if not isinstance(suite, str) or not isinstance(name, str):
                raise ValueError(f"{report}: non-string id in {entry!r}")
            if " " in suite or " " in name:
                raise ValueError(f"{report}: id contains a space: {suite!r} {name!r}")
            if (
                not isinstance(seconds, (int, float))
                or isinstance(seconds, bool)
                or not math.isfinite(seconds)
            ):
                raise ValueError(f"{report}: non-numeric duration_s: {entry!r}")
            weights[f"{suite} {name}"] = seconds
    return weights


def main(argv):
    if not argv:
        raise SystemExit(__doc__)
    merged = {}
    sources = []
    for costs_dir in argv:
        sources.append(Path(costs_dir).name.replace("costs-", ""))
        for key, seconds in weights_from(costs_dir).items():
            merged.setdefault(key, seconds)
    out = {
        "schema": 1,
        "source": " ".join(sources),
        "min_seconds": int(MIN_SECONDS),
        "weights": {
            key: round(seconds, 1)
            for key, seconds in sorted(merged.items())
            if seconds >= MIN_SECONDS
        },
    }
    print(json.dumps(out, indent=2, sort_keys=False))


if __name__ == "__main__":
    main(sys.argv[1:])
