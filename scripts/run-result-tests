#!/bin/bash
# CAD-1334: run every integration test target from scripts/result-test-args,
# the lib suite and binary unit tests in one pinned nextest invocation. Keep
# the exact target scope from CI and `scripts/pre-push --tests`.
#  - --features test-seam: some targets are cfg(feature = "test-seam") and
#    would otherwise run 0 tests and pass.
#  - the post-run JUnit guard rejects any selected integration target without
#    a runnable test, an empty lib suite, or a bins selection with no tests.
#  - the pinned cadence nextest profile disables fail-fast and retries; -j 2
#    parallelizes across targets with bounded concurrency.
#  - HOME/XDG/TMPDIR are private; toolchain homes pass through.
#  - CAD-1197: every CADENCE_* variable is dropped before cargo runs, except
#    CADENCE_SUITE_LOCK. A pane's CADENCE_PM_DIR/CADENCE_STATE_DIR once made
#    tests hold the production tracker's write lock. Refuse any path under
#    the invoking user's real ~/pm or cadence state dir.
#  - CARGO_TARGET_DIR is handed to cargo as CARGO_BUILD_TARGET_DIR, so code
#    under test that reads CARGO_TARGET_DIR (src/worktree.rs) sees a clean
#    environment while Cargo still uses the requested build directory.
#  - test processes run with PATH limited to the generated cargo shim, its
#    resolved compiler, and system dirs. `doctor::run` probes provider CLIs
#    with --version, and a host CLI writes under HOME and makes results host-dependent.
#  - CAD-1370: --test-selection FILE narrows ONLY the integration targets
#    (the lib and bins suites and every guard below always run). FILE is
#    one target identifier [A-Za-z0-9_]+ per line, nonempty and distinct,
#    and every line must be a member of the full result-test-args
#    inventory of THIS checkout — the workflow writes it from the
#    trusted-base classifier, and ambient scope env is never read. The
#    flag is honored only when GITHUB_EVENT_NAME is exactly pull_request;
#    any other event, a missing/empty file, an unknown or duplicate
#    identifier refuses the run rather than narrowing or silently passing.
set -euo pipefail
caller_cwd=$PWD
real_home=${HOME:-}
lane_build_slot=${CADENCE_BUILD_SLOT:-}
original_xdg_data=${XDG_DATA_HOME:-$real_home/.local/share}
manifest_path=
selection_file=
runner_args=("$@")
while [ "$#" -gt 0 ]; do
  case $1 in
    --manifest-path|--test-selection)
      if [ "$#" -lt 2 ]; then
        echo "usage: $0 [--manifest-path CARGO_TOML] [--test-selection FILE]" >&2
        exit 2
      fi
      case $1 in
        --manifest-path) manifest_path=$2 ;;
        --test-selection) selection_file=$2 ;;
      esac
      shift 2 ;;
    *)
      echo "usage: $0 [--manifest-path CARGO_TOML] [--test-selection FILE]" >&2
      exit 2 ;;
  esac
done
if [ -n "$manifest_path" ]; then
  case $manifest_path in
    /*) ;;
    *) manifest_path=$caller_cwd/$manifest_path ;;
  esac
  if [ ! -f "$manifest_path" ]; then
    echo "::error::manifest does not exist: $manifest_path" >&2
    exit 2
  fi
fi
if [ -n "$selection_file" ]; then
  case $selection_file in
    /*) ;;
    *) selection_file=$caller_cwd/$selection_file ;;
  esac
  # Refuse ineligible requests before metadata, tool installation or builds.
  if [ "${GITHUB_EVENT_NAME:-}" != "pull_request" ]; then
    echo "::error::--test-selection is pull_request feedback only; refusing on event '${GITHUB_EVENT_NAME:-unset}'" >&2
    exit 1
  fi
  if [ ! -f "$selection_file" ]; then
    echo "::error::test selection file does not exist: $selection_file" >&2
    exit 1
  fi
  if [ ! -s "$selection_file" ]; then
    echo "::error::test selection file selected no targets" >&2
    exit 1
  fi
fi
# Resolve shared lock configuration before metadata, installation or builds.
# Capture the wait setting before the routing scrub; only nextest receives it.
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/scripts/suite-lock-config"
suite_lock_config

# Resolve the lane shim before trusting the helper setting. The helper may be
# executed only when it is the absolute executable embedded in that generated
# shim; CADENCE_BUILD_SLOT by itself is caller-controlled input.
cargo_entry=$(command -v cargo) || { echo "::error::cargo is not on PATH" >&2; exit 1; }
shim_dir=
case $cargo_entry in
  */cadence-hooks/bin/cargo) shim_dir=$(dirname "$cargo_entry") ;;
esac
if [ -n "$lane_build_slot" ]; then
  if [ -z "$shim_dir" ] || [ ! -x "$lane_build_slot" ] ||
     ! python3 - "$cargo_entry" "$lane_build_slot" <<'PY'
import sys
from pathlib import Path
shim, helper = sys.argv[1:]
if not Path(helper).is_absolute():
    raise SystemExit(1)
quoted = "'" + helper.replace("'", "'\\''") + "'"
expected = "cad=" + quoted
try:
    lines = Path(shim).read_text(encoding="utf-8").splitlines()
except OSError:
    raise SystemExit(1)
raise SystemExit(0 if lines.count(expected) == 1 else 1)
PY
  then
    echo "::error::CADENCE_BUILD_SLOT does not match an executable helper embedded in the lane cargo shim" >&2
    exit 1
  fi
fi
# The lane shim's admission helper needs the caller's original XDG state.
# Admit the whole runner before this script scrubs CADENCE_* and isolates XDG.
# On re-entry, a slot is trusted only when the daemon's status RPC exposes the
# exact token for this process and lane (the caller PID chain is checked by the
# daemon); a live or supplied PID alone is never proof. CI/direct runs without
# a lane helper retain their existing non-daemon path.
slot_admitted=0
if [ -n "$lane_build_slot" ]; then
  if [ -n "${CADENCE_BUILD_SLOT_PID:-}${CADENCE_BUILD_SLOT_TOKEN:-}${CADENCE_BUILD_SLOT_LANE:-}" ]; then
    if [ "${CADENCE_BUILD_SLOT_PID:-}" != "$$" ] ||
       [ -z "${CADENCE_BUILD_SLOT_TOKEN:-}" ] ||
       [ -z "${CADENCE_BUILD_SLOT_LANE:-}" ]; then
      echo "::error::incomplete or mismatched inherited build-slot identity" >&2
      exit 1
    fi
    if ! slot_status=$("$lane_build_slot" build-slot status --json \
        --lane "$CADENCE_BUILD_SLOT_LANE" 2>/dev/null) ||
       ! printf '%s\n' "$slot_status" | python3 -c 'import json, os, sys
try:
    status = json.load(sys.stdin)
    pid = int(os.environ["CADENCE_BUILD_SLOT_PID"])
    lane = os.environ["CADENCE_BUILD_SLOT_LANE"]
    token = os.environ["CADENCE_BUILD_SLOT_TOKEN"]
    suite_holds = status["pools"]["suite"]["held"]
    valid = any(
        row.get("kind") == "suite" and row.get("pid") == pid and
        row.get("lane") == lane and row.get("token") == token
        for row in suite_holds
    )
    raise SystemExit(0 if valid else 1)
except (KeyError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)'; then
      echo "::error::daemon did not validate the inherited build-slot identity" >&2
      exit 1
    fi
    slot_admitted=1
  else
    exec "$lane_build_slot" build-slot run suite -- "$0" "${runner_args[@]}"
  fi
fi
# CAD-1197: allowlist of CADENCE_* variables that may reach cargo.
cadence_env_allow=" CADENCE_SUITE_LOCK "
for v in $(compgen -e | grep '^CADENCE_' || true); do
  case $cadence_env_allow in *" $v "*) ;; *) unset "$v" ;; esac
done
for v in $(compgen -e | grep '^CADENCE_' || true); do
  case $cadence_env_allow in
    *" $v "*) ;;
    *) echo "::error::$v is still set after the CADENCE_* scrub" >&2; exit 1 ;;
  esac
done
# Refuse any path at or under the real production tracker/state dirs.
refuse_prod_path() { # <label> <path>
  [ -n "$2" ] || return 0
  [ -n "$real_home" ] || return 0
  local p
  p=$(realpath -m -- "$2")
  for prod in "$real_home/pm" "$real_home/.local/state/cadence"; do
    prod=$(realpath -m -- "$prod")
    case $p in "$prod"|"$prod"/*)
      echo "::error::$1 ($p) is inside the production path $prod; refusing" >&2
      exit 1 ;;
    esac
  done
}
refuse_prod_path CADENCE_SUITE_LOCK "${CADENCE_SUITE_LOCK:-}"
refuse_prod_path TMPDIR "${TMPDIR:-}"
cd "$root"
targets=$("$root/scripts/result-test-args")
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
if [ -n "${CARGO_TARGET_DIR:-}" ]; then
  case $CARGO_TARGET_DIR in
    /*) CARGO_BUILD_TARGET_DIR=$CARGO_TARGET_DIR ;;
    *) CARGO_BUILD_TARGET_DIR=$caller_cwd/$CARGO_TARGET_DIR ;;
  esac
  export CARGO_BUILD_TARGET_DIR
fi
unset CARGO_TARGET_DIR
if [ -n "$lane_build_slot" ] && [ -z "$shim_dir" ]; then
  echo "::error::lane build-slot helper is set but generated cargo shim is not first on PATH" >&2
  exit 1
fi
# Resolve the compiler without treating the generated shim as Cargo. Prefer
# rustup's selected toolchain; non-rustup installs use the first cargo after
# removing only the shim directory from the caller's PATH.
compiler_cargo=
compiler_rustc=
if rustup_bin=$(command -v rustup 2>/dev/null); then
  compiler_cargo=$("$rustup_bin" which cargo 2>/dev/null || true)
  if [ -n "$compiler_cargo" ] && [ -x "$compiler_cargo" ]; then
    compiler_rustc=$("$rustup_bin" which rustc 2>/dev/null || true)
  fi
fi
if [ -z "$compiler_cargo" ] || [ ! -x "$compiler_cargo" ]; then
  lookup_path=$PATH
  if [ -n "$shim_dir" ]; then
    lookup_path=$(printf '%s' "$lookup_path" | tr ':' '\n' | grep -vxF "$shim_dir" | paste -sd: -)
  fi
  compiler_cargo=$(PATH=$lookup_path command -v cargo 2>/dev/null || true)
  compiler_rustc=$(PATH=$lookup_path command -v rustc 2>/dev/null || true)
fi
if [ -z "$compiler_cargo" ] || [ ! -x "$compiler_cargo" ]; then
  echo "::error::could not resolve an executable real cargo (rustup and PATH lookup failed)" >&2
  exit 1
fi
if [ -z "$compiler_rustc" ] || [ ! -x "$compiler_rustc" ]; then
  echo "::error::could not resolve an executable rustc matching the selected cargo/toolchain" >&2
  exit 1
fi
if [ -n "$shim_dir" ] && [ "$(realpath -e -- "$compiler_cargo")" = "$(realpath -e -- "$cargo_entry")" ]; then
  echo "::error::cargo resolution returned the generated shim, not a compiler" >&2
  exit 1
fi
scratch=$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/result-tests.XXXXXX")
trap 'rm -rf "$scratch"' EXIT
compiler_dir=$scratch/cargo-toolchain
mkdir -m 700 "$compiler_dir"
ln -s "$(realpath -e -- "$compiler_cargo")" "$compiler_dir/cargo"
ln -s "$(realpath -e -- "$compiler_rustc")" "$compiler_dir/rustc"
lib_path="${shim_dir:+$shim_dir:}$compiler_dir:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
cargo_entry_dir=$(dirname "$cargo_entry")
for cli in claude codex cursor-agent cursor agent devin pi gemini; do
  if found=$(PATH="$cargo_entry_dir:$lib_path" command -v "$cli"); then
    echo "::error::provider CLI $cli resolves on the lib suite PATH ($found)" >&2
    exit 1
  fi
done
export HOME="$scratch/home" XDG_CONFIG_HOME="$scratch/xdg-config" \
       XDG_DATA_HOME="$scratch/xdg-data" XDG_STATE_HOME="$scratch/xdg-state" \
       XDG_CACHE_HOME="$scratch/xdg-cache" TMPDIR="$scratch/tmp"
mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME" "$TMPDIR"
refuse_prod_path "scratch HOME" "$HOME"
# Reuse only the repository-pinned tool in the original XDG data home;
# otherwise install the trusted artifact into this run's isolated XDG data
# directory. The nextest wrapper verifies its version and checksum either way.
if [ -x "$original_xdg_data/cadence/tools/cadence-nextest-0.9.145/cargo-nextest" ]; then
  export CADENCE_NEXTTEST_BIN="$original_xdg_data/cadence/tools/cadence-nextest-0.9.145/cargo-nextest"
else
  "$root/scripts/install-cadence-nextest"
fi
status=0

mapfile -t target_args <<< "$targets"
integration_targets=()
for ((i = 0; i < ${#target_args[@]}; i += 2)); do
  if [ "${target_args[$i]}" != "--test" ] || [ -z "${target_args[$((i + 1))]:-}" ]; then
    echo "::error::malformed integration target selection from result-test-args" >&2
    exit 1
  fi
  integration_targets+=("${target_args[$((i + 1))]}")
done
if [ "${#integration_targets[@]}" -eq 0 ]; then
  echo "::error::result-test-args selected no integration targets" >&2
  exit 1
fi
# CAD-1370: a narrowed integration selection is honored only for a real
# pull_request event and only when every requested identifier is a
# nonempty distinct member of THIS checkout's full inventory (validated
# above, untrusted by callers). The lib/bins suites and the JUnit
# zero-target guards still run; failure, a missing file, or a selection
# that resolves to zero targets refuses rather than narrowing.
if [ -n "$selection_file" ]; then
  selected=()
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      "") continue ;; # tolerate trailing blank lines only
      *[!A-Za-z0-9_]*)
        echo "::error::test selection line is not an identifier: $line" >&2
        exit 1 ;;
    esac
    match=0
    for full in "${integration_targets[@]}"; do
      if [ "$full" = "$line" ]; then match=1; break; fi
    done
    if [ "$match" -ne 1 ]; then
      echo "::error::test selection names a target outside this checkout's inventory: $line" >&2
      exit 1
    fi
    for seen in ${selected[@]+"${selected[@]}"}; do
      if [ "$seen" = "$line" ]; then
        echo "::error::test selection repeats a target: $line" >&2
        exit 1
      fi
    done
    selected+=("$line")
  done < "$selection_file"
  if [ "${#selected[@]}" -eq 0 ]; then
    echo "::error::test selection file selected no targets" >&2
    exit 1
  fi
  target_args=()
  integration_targets=("${selected[@]}")
  for name in "${selected[@]}"; do
    target_args+=(--test "$name")
  done
fi
manifest_args=()
if [ -n "$manifest_path" ]; then
  manifest_args=(--manifest-path "$manifest_path")
fi
printf 'running %d integration targets, plus lib and bins\n' "${#integration_targets[@]}"
manifest_for_coverage=${manifest_path:-$root/Cargo.toml}
package_name=$(python3 - "$manifest_for_coverage" <<'PY'
import sys
import tomllib
with open(sys.argv[1], "rb") as manifest:
    print(tomllib.load(manifest)["package"]["name"])
PY
)
workspace_dir=$(dirname "$manifest_for_coverage")
junit_report=$workspace_dir/target/nextest/cadence/junit.xml
rm -f "$junit_report"

# One pinned nextest invocation replaces 56 serial cargo test invocations.
# Its JUnit report is checked against the exact target list afterward so a
# missing or zero-test target cannot silently shrink the required CI scope.
# cargo-nextest honors CARGO for its Cargo subprocess while preserving PATH for
# test processes. Under an admitted lane run this selects the compiler symlink
# directly; tests retain the lane shim first on PATH but receive no slot identity.
cargo_env=("PATH=$lib_path" "CADENCE_SUITE_LOCK_WAIT_SECS=$SUITE_LOCK_WAIT_SECS")
if [ "$slot_admitted" -eq 1 ]; then
  cargo_env+=("CARGO=$compiler_dir/cargo")
fi
if ! env "${cargo_env[@]}" "$root/scripts/cadence-nextest" --locked --features test-seam \
    "${target_args[@]}" --lib --bins "${manifest_args[@]}" \
    -j 2 2>&1 | tee "$scratch/nextest.log"; then
  status=1
  printf '::error::integration target selection or test run failed: %s\n' \
    "${integration_targets[*]}" >&2
fi

if [ ! -f "$junit_report" ]; then
  echo "::error::nextest did not produce its required JUnit report: $junit_report" >&2
  status=1
else
  if ! python3 - "$junit_report" "$package_name" "${integration_targets[@]}" <<'PY'
import sys
import xml.etree.ElementTree as ET

path, package, *expected = sys.argv[1:]
try:
    report = ET.parse(path).getroot()
except (OSError, ET.ParseError) as error:
    print(f"::error::could not read nextest JUnit report: {error}", file=sys.stderr)
    raise SystemExit(1)

suites = report.findall(".//testsuite")
def has_runnable(suite):
    return any(case.find("skipped") is None for case in suite.findall("testcase"))

failed = False
for target in expected:
    name = f"{package}::{target}"
    matches = [suite for suite in suites if suite.get("name") == name]
    if not matches or not any(has_runnable(suite) for suite in matches):
        print(f"::error::integration target {target} has no runnable tests", file=sys.stderr)
        failed = True
if not any(suite.get("name") == package and has_runnable(suite) for suite in suites):
    print("::error::lib selection has no runnable tests", file=sys.stderr)
    failed = True
if not any(
    suite.get("name", "").startswith(f"{package}::bin/") and has_runnable(suite)
    for suite in suites
):
    print("::error::bins selection has no runnable tests", file=sys.stderr)
    failed = True
if failed:
    raise SystemExit(1)
print(f"validated {len(expected)} integration targets and runnable lib/bin suites")
PY
  then
    status=1
  fi
fi
exit "$status"
