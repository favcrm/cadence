#!/bin/bash
# CAD-1090/CAD-1105: run every cargo test target (scripts/result-test-args)
# and the lib unit tests the same way in CI and in `scripts/pre-push --tests`.
#  - --features test-seam: some targets are cfg(feature = "test-seam") and
#    would otherwise run 0 tests and pass.
#  - fails when any selected target reports `running 0 tests`.
#  - --no-fail-fast: every target reports, not just the first red one; the
#    lib suite runs even when an integration target failed.
#  - HOME/XDG/TMPDIR are private; toolchain homes pass through.
#  - CAD-1197: every CADENCE_* variable is dropped before cargo runs, except
#    an allowlist (CADENCE_SUITE_LOCK, which CI sets and this script
#    defaults). A pane's CADENCE_PM_DIR/CADENCE_STATE_DIR once made the lib
#    suite hold the production tracker's write lock. The script then refuses
#    if any other CADENCE_* is still set or if a path the tests would use
#    sits at or under the invoking user's real ~/pm or cadence state dir.
#  - CARGO_TARGET_DIR is handed to cargo as CARGO_BUILD_TARGET_DIR, so the
#    build lands in the same place but code under test that reads
#    CARGO_TARGET_DIR (src/worktree.rs) sees a clean environment.
#  - the lib suite runs with PATH limited to the cargo toolchain dir and the
#    system dirs, and refuses to start if a provider CLI still resolves:
#    `doctor::run` probes every registry provider with `--version`, and a
#    host CLI writes under HOME and makes the result depend on the host.
set -euo pipefail
caller_cwd=$PWD
real_home=${HOME:-}
# CAD-1197: allowlist of CADENCE_* variables that may reach cargo.
cadence_env_allow=" CADENCE_SUITE_LOCK "
for v in $(compgen -e | grep '^CADENCE_' || true); do
  case $cadence_env_allow in *" $v "*) ;; *) unset "$v" ;; esac
done
for v in $(compgen -e | grep '^CADENCE_' || true); do
  case $cadence_env_allow in
    *" $v "*) ;;
    *) echo "::error::$v is still set after the CADENCE_* scrub" >&2; exit 1 ;;
  esac
done
# Refuse any path at or under the real production tracker/state dirs.
refuse_prod_path() { # <label> <path>
  [ -n "$2" ] || return 0
  [ -n "$real_home" ] || return 0
  local p
  p=$(realpath -m -- "$2")
  for prod in "$real_home/pm" "$real_home/.local/state/cadence"; do
    prod=$(realpath -m -- "$prod")
    case $p in "$prod"|"$prod"/*)
      echo "::error::$1 ($p) is inside the production path $prod; refusing" >&2
      exit 1 ;;
    esac
  done
}
refuse_prod_path CADENCE_SUITE_LOCK "${CADENCE_SUITE_LOCK:-}"
refuse_prod_path TMPDIR "${TMPDIR:-}"
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
targets=$("$root/scripts/result-test-args")
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
if [ -n "${CARGO_TARGET_DIR:-}" ]; then
  case $CARGO_TARGET_DIR in
    /*) CARGO_BUILD_TARGET_DIR=$CARGO_TARGET_DIR ;;
    *) CARGO_BUILD_TARGET_DIR=$caller_cwd/$CARGO_TARGET_DIR ;;
  esac
  export CARGO_BUILD_TARGET_DIR
fi
unset CARGO_TARGET_DIR
cargo_bin=$(command -v cargo) || { echo "::error::cargo is not on PATH" >&2; exit 1; }
lib_path="$(dirname "$cargo_bin"):/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
for cli in claude codex cursor-agent cursor agent devin pi gemini; do
  if found=$(PATH=$lib_path command -v "$cli"); then
    echo "::error::provider CLI $cli resolves on the lib suite PATH ($found)" >&2
    exit 1
  fi
done
scratch=$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/result-tests.XXXXXX")
trap 'rm -rf "$scratch"' EXIT
export HOME="$scratch/home" XDG_CONFIG_HOME="$scratch/xdg-config" \
       XDG_DATA_HOME="$scratch/xdg-data" XDG_STATE_HOME="$scratch/xdg-state" \
       XDG_CACHE_HOME="$scratch/xdg-cache" TMPDIR="$scratch/tmp"
mkdir -p "$HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$XDG_CACHE_HOME" "$TMPDIR"
export CADENCE_SUITE_LOCK="${CADENCE_SUITE_LOCK:-$scratch/cadence-suite.lock}"
refuse_prod_path "scratch HOME" "$HOME"
status=0

# Fails when a target ran 0 tests (cfg-gated off?) or none reported at all.
zero_guard() {
  if grep -q '^running 0 tests' "$1" || ! grep -q '^running [1-9]' "$1"; then
    echo "::error::$2: a selected test target ran 0 tests (cfg-gated off?)" >&2
    status=1
  fi
}

echo "integration targets:" $(echo "$targets" | grep -v '^--test$')
# shellcheck disable=SC2086
cargo test --locked --features test-seam --no-fail-fast $targets -- --test-threads 2 \
  2>&1 | tee "$scratch/integration.log" || status=1
zero_guard "$scratch/integration.log" integration

echo "lib suite PATH: $lib_path"
PATH=$lib_path cargo test --locked --features test-seam --lib --no-fail-fast -- --test-threads 2 \
  2>&1 | tee "$scratch/lib.log" || status=1
zero_guard "$scratch/lib.log" lib
exit "$status"
