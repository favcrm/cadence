# --------------------------------------------------------------------------
# Rules for tests PINNED does not know (new code on a newer main). Name
# rules run before section rules; first match wins. Names that match
# nothing land in board_unplaced.rs and fail the run — add a pin.
# --------------------------------------------------------------------------

split.PREFIX_RULES = [
    (r"^ui_tailscale|^ui_(start|stop)_tailscale|^tailnet_|^forged_tailscale",
     "board_tailnet"),
    (r"^memory_", "board_memory"),
    (r"^overview_|^version_reports", "board_overview"),
    (r"^retro_", "board_retro"),
    (r"^project_context_", "board_context"),
    (r"^(platform|board_session)_|^a_member_session", "board_sign_in"),
    (r"^sync_|^post_commit_hook", "board_sync"),
    (r"^(issue_(start|finish|claim)|dispatch|lane)_", "board_lanes"),
    (r"^(ui|in_process_daemon|board_stops)_", "board_ui_daemon"),
    (r"^(a_login_link|a_session|a_cookie|an_early_closed|an_allowed|"
     r"only_the_operator|links_and_sessions|without_a_session|"
     r"every_classified|every_operator|operator_secret|route_classes|"
     r"bogus_sign_ins|the_daemon_binds)", "board_sessions"),
    (r"^(issue|epic|tracker|pm_commit|plan_commit|symlinks|writes|init)_",
     "board_issue"),
]

split.SECTION_RULES = [
    (r"^CAD-39\b", "board_sync"),
    (r"^I3\b", "board_ui_daemon"),
    (r"^CAD-4[123]\b|^CAD-81\b", "board_issue"),
    (r"^CAD-55\b|^CAD-274\b|^CAD-275\b|^CAD-383\b", "board_lanes"),
    (r"^CAD-69\b", "board_tailnet"),
    (r"^CAD-313\b|^CAD-327\b|^CAD-428\b", "board_sessions"),
    (r"^CAD-526\b", "board_sign_in"),
    # 'request-level' and 'issue retro' sections mix areas — no rule;
    # unmatched names there are unplaced on purpose.
]

# --------------------------------------------------------------------------
# Text edits applied to named items while emitting. `mod op` moves down a
# level (tests/board_common/mod.rs), so its #[path] needs one more ".."
# to reach tests/support/operator.rs.
# --------------------------------------------------------------------------

split.TEXT_EDITS = {
    "op": [
        (
            '#[path = "support/operator.rs"]',
            '#[path = "../support/operator.rs"]',
        ),
    ],
}

split.COMMON_PIN = set()

# rustc is authoritative on unused imports — see DROP_USES in
# scripts/split-integration-tests. Trait leafs kept on method-name
# evidence that resolved to inherent methods (BufRead::lines on str,
# Write::write on String) and `issue::{board, plan, write}` leafs kept
# on `name::` path mentions are dropped here so the generated tree is
# warning-free.
split.DROP_USES = {
    "tests/board_common/mod.rs": [
        "cadence_agent::issue::board",
        "cadence_agent::issue::write",
        "std::io::BufRead",
    ],
    "tests/board_http.rs": ["cadence_agent::issue::write"],
    "tests/board_issue.rs": ["std::io::BufRead"],
    "tests/board_lanes.rs": [
        "cadence_agent::issue::plan",
        "std::io::BufRead",
    ],
    "tests/board_overview.rs": ["std::io::BufRead"],
    "tests/board_retro.rs": ["std::io::BufRead"],
    "tests/board_sessions.rs": [
        "cadence_agent::issue::write",
        "std::io::BufRead",
    ],
    "tests/board_sign_in.rs": [
        "cadence_agent::issue::board",
        "std::io::BufRead",
    ],
    "tests/board_ui_daemon.rs": [
        "cadence_agent::issue::board",
        "cadence_agent::issue::write",
    ],
}

split.BIN_PREAMBLE = """//! {area}: area tests split from tests/board.rs (CAD-537).
//! Board e2e: the `cadence issue` CLI against a temp PM dir, and the
//! `cadence ui` HTTP server in-process.
// A test binary never runs the CAD-308 reaper (only `daemon run` does),
// so its own spawns need not go through `cadence_agent::reaper`.
#![allow(clippy::disallowed_methods)]
mod {cm};
use {cm}::*;
"""

split.COMMON_PREAMBLE = """//! Shared harness for the split board binaries (CAD-537): the `cadence`
//! CLI runners, HTTP helpers, board/daemon starters and fixtures that
//! more than one board area uses. Not every binary uses every helper.
#![allow(dead_code)]
"""

# A test before the first section marker with no rule is unplaced — the
# preamble tests are all pinned, and a new unsectioned test needs a
# decision, not a default.
split.PREMARKER_AREA = None

split.MAP_HEADER = [
    "# CAD-537 — generated by scripts/split-board-tests;",
    "# do not hand-edit. Re-run the script on a newer",
    "# tests/board.rs to regenerate this map.",
]


if __name__ == "__main__":
    sys.exit(split.main())
