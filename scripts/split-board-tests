#!/usr/bin/env python3
"""CAD-537: deterministic split of tests/board.rs into per-area binaries.

Same machinery as scripts/split-integration-tests (CAD-426), loaded as a
module and pointed at the board suite:

  - tests/board_common/mod.rs — the board-only harness: every item used by
    more than one area plus all type/impl/mod declarations, promoted to
    `pub` so binaries see them through `use board_common::*`. The shared
    integration harness in tests/common/ is untouched — board.rs never
    linked it.
  - tests/board_<area>.rs    — one test binary per area: its #[test] fns
    and any helper no other area references.
  - tests/split-map-board.toml — manifest mapping every test fn and helper
    to its binary (regenerated; do not hand-edit).

Placement of a test is decided by, in order:

  1. PINNED        — the reviewed CAD-537 cut (every test in board.rs at
                     split time is listed below);
  2. PREFIX_RULES  — first matching regex on the test name;
  3. SECTION_RULES — first matching regex on the `// ---- <section> ----`
                     marker that introduces the test;
  4. otherwise the test lands in tests/board_unplaced.rs and the run
     fails — an explicit pin is required.

Running it again on a newer board.rs reproduces the same layout for every
test the manifest knows and files new ones by the rules. Run from the
repo root:

    scripts/split-board-tests            # regenerate + remove source
    scripts/split-board-tests --check    # verify outputs are current

The one text edit is `mod op`'s #[path]: from board_common/mod.rs it
needs one more ".." to reach tests/support/operator.rs (TEXT_EDITS).
"""

import importlib.machinery
import importlib.util
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_loader = importlib.machinery.SourceFileLoader(
    "split_integration_tests",
    os.path.join(_HERE, "split-integration-tests"),
)
_spec = importlib.util.spec_from_loader("split_integration_tests", _loader)
split = importlib.util.module_from_spec(_spec)
_loader.exec_module(split)

split.SRC = "tests/board.rs"
split.COMMON = "tests/board_common/mod.rs"
split.MANIFEST = "tests/split-map-board.toml"
split.UNPLACED = "tests/board_unplaced.rs"

# --------------------------------------------------------------------------
# Area binaries, in emission order.
# --------------------------------------------------------------------------

split.AREAS = [
    "board_issue",
    "board_lanes",
    "board_sync",
    "board_http",
    "board_ui_daemon",
    "board_tailnet",
    "board_memory",
    "board_overview",
    "board_retro",
    "board_context",
    "board_sessions",
    "board_sign_in",
]

