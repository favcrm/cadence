#!/bin/sh
# CAD-1090: the one selection rule for CI and `scripts/pre-push --tests`.
# Prints `--test` / `<name>` pairs, one per line, for every target of kind
# `test` that cargo itself reports (tests/*.rs and tests/<dir>/main.rs, plus
# any [[test]] entry), so a new result-test is picked up with no workflow
# edit. Fails closed when cargo reports none: an empty selection would pass
# without running anything.
set -eu
cd "$(dirname "$0")/.."
cargo metadata --no-deps --format-version 1 --locked | python3 -c '
import json, sys
meta = json.load(sys.stdin)
names = sorted({t["name"] for p in meta["packages"] for t in p["targets"]
                if "test" in t["kind"]})
# CAD-1970: integration targets are retired; the lib and bins suites are the
# selection. Still fail closed when cargo reports nothing runnable at all.
suites = sorted({t["name"] for p in meta["packages"] for t in p["targets"]
                 if {"lib", "bin"} & set(t["kind"])})
if not suites:
    sys.exit("result-test-args: cargo reports no lib or bin suite")
for n in names:
    print("--test")
    print(n)
'
