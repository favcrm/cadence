#!/bin/sh
# CAD-1090: the one selection rule for CI and `scripts/pre-push --tests`.
# Print one nextest binary ID (package::target) for every workspace
# integration target Cargo reports. Target names alone lose package ownership.
set -eu
cd "$(dirname "$0")/.."
cargo metadata --manifest-path "${1:-Cargo.toml}" --no-deps --format-version 1 --locked | python3 -c '
import json, sys
meta = json.load(sys.stdin)
names = sorted(p["name"] + "::" + t["name"]
               for p in meta["packages"] for t in p["targets"] if "test" in t["kind"])
if not names:
    sys.exit("result-test-args: cargo reports no integration targets")
print("\n".join(names))
'
