#!/usr/bin/env python3
"""CAD-922: one local command that catches the cheap failures before CI.

    scripts/pre-push              # run every step the diff calls for
    scripts/pre-push --tests      # also run every tests/*.rs target, regardless of diff
    scripts/pre-push --list       # print the plan, run nothing
    scripts/pre-push --base REF   # diff base (default origin/main, else main)

Steps run in order and stop at the first failure:

  1. fmt          cargo fmt --all -- --check                 (always)
  2. split-map    scripts/split-map-sync --check             (if legacy inventory exists)
     doctor split scripts/split-doctor-host --check          (live source inventory)
  3. clippy       cargo clippy --all-targets --locked -- -D warnings, and again with
                  --features test-seam                       (Rust changed)
  4. ui typecheck pnpm --dir ui run typecheck                (ui/ changed)
  5. contracts    active Python test commands in CI's fmt job
                                                              (scripts/, .github/ or tests/scripts/ changed)
  6. nextest wrapper  scripts/test-cadence-nextest, which includes the
                  `flock -o` leak regression (CAD-968)
                                                              (scripts/cadence-nextest or its test/installer changed)
  7. tests        scripts/run-result-tests (every test target, then the lib
                  unit tests)                                (--tests only)

Every step is judged by its exit code alone and gets one summary line. Host
limits from AGENTS.md apply: CARGO_BUILD_JOBS defaults to 4 and tests run with
--test-threads 2. The safety floor is not full behavior coverage. "Changed" is
the union of commits since the base, working-tree edits and untracked files;
if git cannot tell, everything counts as changed.
"""

import argparse
import os
import re
import shlex
import subprocess
import sys
import time


def git_lines(root, *args):
    try:
        r = subprocess.run(["git", "-C", root, *args], capture_output=True, text=True)
    except OSError:
        return None
    if r.returncode != 0:
        return None
    return [l for l in r.stdout.splitlines() if l]


def default_base(root):
    for ref in ("origin/main", "main"):
        if git_lines(root, "rev-parse", "--verify", "--quiet", ref) is not None:
            return ref
    return None


def changed_files(root, base):
    """Set of changed paths, or None when git cannot say (treat all as changed)."""
    if base is None:
        return None
    committed = git_lines(root, "diff", "--name-only", f"{base}...HEAD")
    worktree = git_lines(root, "diff", "--name-only", "HEAD")
    untracked = git_lines(root, "ls-files", "--others", "--exclude-standard")
    if committed is None or worktree is None or untracked is None:
        return None
    return set(committed) | set(worktree) | set(untracked)


def touched(changed, *prefixes):
    return changed is None or any(p.startswith(prefixes) for p in changed)


def rust_changed(changed):
    if changed is None:
        return True
    return any(p.endswith(".rs") or p in ("Cargo.toml", "Cargo.lock", "build.rs", "rust-toolchain.toml")
               or p.endswith("/Cargo.toml") for p in changed)


def contract_scripts(root):
    """The python contract tests CI's fmt job runs, in workflow order."""
    try:
        with open(os.path.join(root, ".github/workflows/ci.yml")) as f:
            text = f.read()
    except OSError:
        return []
    fmt = text.split("\n  fmt:\n", 1)[-1].split("\n  clippy:\n", 1)[0]
    seen = []
    # Only standalone test commands, not arbitrary shell or workflow expressions.
    # A named missing test still fails locally; discovery never filters by existence.
    pattern = r"^\s*(?:-\s*)?(?:run:\s*)?(python3\s+[^\n]+)$"
    for m in re.finditer(pattern, fmt, re.M):
        command = shlex.split(m.group(1), comments=True)
        test_script = len(command) > 1 and re.fullmatch(
            r"(?:scripts/test[-_][\w.-]+|tests/scripts/test_\w+\.py)", command[1])
        unittest = command[1:3] == ["-m", "unittest"]
        if (test_script or unittest) and command not in seen:
            seen.append(command)
    return seen


def focused_tests(root, changed):
    """CAD-1021: cheap invariant unit tests run when their input file
    changes — a path → test-target map. Each entry is
    (paths-it-watches, [cargo test filter args]). The test runs with
    the same --test-threads budget as every other step."""
    MAP = {
        # CAD-1024: a new top-level verb in src/cli/commands.rs went red
        # on CI — the help-bucket invariant lives in cli::help tests.
        "src/cli/commands.rs": ["cargo", "test", "--bin", "cadence", "cli::help"],
        "src/cli/help.rs": ["cargo", "test", "--bin", "cadence", "cli::help"],
    }
    out = []
    for path, argv in MAP.items():
        if changed is None or path in changed:
            out.append((f"focused {path}", argv))
    return out


def plan(root, changed, with_tests):
    """[(name, argv or None, skip reason)] in run order."""
    rs = rust_changed(changed)
    steps = [
        ("fmt", ["cargo", "fmt", "--all", "--", "--check"], None),
        # CAD-1073: split-map's manifest was retired with tests/ — a
        # missing tests/split-map.toml means there is nothing to check.
        ("split-map", ["python3", "scripts/split-map-sync", "--check"],
         None if os.path.exists(os.path.join(root, "tests/split-map.toml"))
         else "tests/split-map.toml retired"),
    ]
    steps.append(("doctor split", ["scripts/split-doctor-host", "--check"], None))
    why = None if rs else "no Rust changes"
    steps.append(("clippy", ["cargo", "clippy", "--all-targets", "--locked", "--", "-D", "warnings"], why))
    steps.append(("clippy test-seam", ["cargo", "clippy", "--all-targets", "--locked",
                                      "--features", "test-seam", "--", "-D", "warnings"], why))
    ui = touched(changed, "ui/")
    steps.append(("ui typecheck", ["pnpm", "--dir", "ui", "run", "typecheck"],
                  None if ui else "ui/ unchanged"))
    cs = contract_scripts(root)
    need = touched(changed, "scripts/", ".github/", "tests/scripts/")
    if not need:
        steps.append(("contracts", None, "scripts/, .github/, tests/scripts/ unchanged"))
    elif not cs:
        steps.append(("contracts", None, "no active Python test commands in fmt job"))
    else:
        steps += [(f"contract {os.path.basename(c[-1])}", c, None) for c in cs]
    wrapper = {"scripts/cadence-nextest", "scripts/test-cadence-nextest",
               "scripts/install-cadence-nextest"}
    steps.append(("nextest wrapper", ["scripts/test-cadence-nextest"],
                  None if changed is None or wrapper & set(changed)
                  else "nextest wrapper scripts unchanged"))
    # CAD-1021: cheap focused unit tests gated on the file they guard.
    for name, argv in focused_tests(root, changed):
        steps.append((name, argv, None))
    # CAD-1073 clean-slate: every tests/*.rs target is wired to --tests.
    if not with_tests:
        steps.append(("tests", None, "pass --tests to run every test target"))
    else:
        # CAD-1090/CAD-1105: the same runner CI uses, integration and lib.
        steps.append(("tests integration+lib", ["scripts/run-result-tests"], None))
    return steps


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--tests", action="store_true",
                    help="also run every tests/*.rs target")
    ap.add_argument("--list", action="store_true", help="print the plan and exit")
    ap.add_argument("--base", help="diff base ref (default origin/main, else main)")
    ap.add_argument("--root", default=os.path.dirname(os.path.dirname(
        os.path.abspath(__file__))), help="repo root (default: this checkout)")
    ap.add_argument("--receipt", action="store_true",
                    help="print one receipt line: head= lane= kind= steps=… rc= at=")
    args = ap.parse_args(argv)
    root = args.root
    changed = changed_files(root, args.base or default_base(root))
    steps = plan(root, changed, args.tests)
    env = dict(os.environ)
    env.setdefault("CARGO_BUILD_JOBS", "4")

    # CAD-1021: the receipt a lane's pre-push hook and report share.
    # `head` binds the verdict to the pushed SHA; `lane` is CADENCE_ALIAS/
    # USER; `kind` is the slot class the check ran under (the hook passes
    # the acquired kind; unset here reads `none`).
    def receipt(rc):
        head = (git_lines(root, "rev-parse", "HEAD") or ["?"])[0]
        lane = os.environ.get("CADENCE_ALIAS") or os.environ.get("USER", "?")
        kind = os.environ.get("CADENCE_SLOT_KIND", "none")
        codes = ",".join(f"{n}:{r}" for n, r in step_rcs)
        print(f"head={head} lane={lane} kind={kind} steps={codes} "
              f"rc={rc} at={int(time.time())}")

    ran = skipped = 0
    step_rcs = []
    for name, argv_, skip in steps:
        if skip or args.list:
            label = "SKIP" if skip else "PLAN"
            print(f"[{label}] {name}: {skip or ' '.join(argv_)}")
            skipped += bool(skip)
            continue
        t0 = time.monotonic()
        try:
            r = subprocess.run(argv_, cwd=root, env=env, capture_output=True, text=True)
            rc, out = r.returncode, (r.stdout + r.stderr)
        except OSError as e:
            rc, out = 127, f"{argv_[0]}: {e}\n"
        step_rcs.append((name, rc))
        dt = time.monotonic() - t0
        if rc == 0:
            ran += 1
            print(f"[ OK ] {name} ({dt:.1f}s)")
            continue
        print(f"[FAIL] {name}: exit {rc} ({dt:.1f}s): {' '.join(argv_)}")
        sys.stdout.write("".join(out.splitlines(True)[-40:]))
        print(f"pre-push: FAILED at {name} ({ran} passed, {skipped} skipped)")
        if args.receipt:
            receipt(1)
        return 1
    if args.list:
        return 0
    print(f"pre-push: all ok ({ran} passed, {skipped} skipped)")
    if args.receipt:
        receipt(0)
    return 0


if __name__ == "__main__":
    sys.exit(main())
