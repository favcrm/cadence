#!/usr/bin/env python3
"""CAD-2307: the nextest filterset for the tests a pull request adds or changes.

    scripts/changed-test-filter --base BASE_SHA [--head HEAD] [--github-output FILE]

Prints the filterset on stdout (empty when the diff touches no selectable
test) and notices on stderr. With --github-output it also writes `selected=`
(true/false), `filter=` and `cargo_args=` (the cargo flags that narrow the
build to the targets holding the selected tests).

Selection, from the merge-base diff of added, copied, modified and renamed files:

  src/daemon/tests/<path>.rs   every test under daemon::tests::<path>:: (lib).
                               `mod.rs` selects its directory; the root
                               `src/daemon/tests/mod.rs` selects the modules
                               whose `mod x;` line the diff adds.
  tests/suite.rs               the single integration target (CAD-1727). Each
                               changed line maps to its enclosing `#[test]`
                               fn; a changed helper selects its enclosing
                               `mod`. A change outside any test fn or mod
                               (top-level helper, `use`) cannot be bounded and
                               is reported on stderr, not widened to the suite.

Nothing here runs a test; the workflow runs the filterset under test-seam.
"""

import argparse
import re
import subprocess
import sys

DAEMON_ROOT = "src/daemon/tests/"
SUITE = "tests/suite.rs"
LIB = "binary_id(=cadence-agent)"
SUITE_BIN = "binary_id(=cadence-agent::suite)"


def git(*args):
    r = subprocess.run(["git", *args], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"changed-test-filter: git {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout


def daemon_prefix(path):
    """daemon::tests:: module path for a file under src/daemon/tests/."""
    parts = path[len(DAEMON_ROOT):-len(".rs")].split("/")
    if parts[-1] == "mod":
        parts.pop()
    return "daemon::tests::" + "".join(p + "::" for p in parts)


def root_mod_prefixes(base, head):
    """Modules newly declared in src/daemon/tests/mod.rs."""
    diff = git("diff", "-U0", f"{base}...{head}", "--", DAEMON_ROOT + "mod.rs")
    return [f"daemon::tests::{m}::" for m in re.findall(r"^\+\s*mod (\w+);", diff, re.M)]


def mask(text):
    """`text` with string, char and comment contents blanked (newlines kept).

    Braces, `;` and item keywords inside a raw string, a string, a char literal
    or a comment must not move the scanner. Handles r"..", r#".."#, any `#`
    count, b/c prefixes, escapes, lifetimes (not char literals) and nested
    block comments.
    """
    out, i, n = [], 0, len(text)

    def blank(chunk):
        return "".join(c if c == "\n" else " " for c in chunk)

    while i < n:
        c = text[i]
        if text.startswith("//", i):
            j = text.find("\n", i)
            j = n if j < 0 else j
            out.append(blank(text[i:j]))
            i = j
        elif text.startswith("/*", i):
            depth, j = 1, i + 2
            while j < n and depth:
                if text.startswith("/*", j):
                    depth, j = depth + 1, j + 2
                elif text.startswith("*/", j):
                    depth, j = depth - 1, j + 2
                else:
                    j += 1
            out.append(blank(text[i:j]))
            i = j
        else:
            m = re.compile(r'(?:b|c)?r(#*)"').match(text, i) if c in "rbc" else None
            prev_ident = i > 0 and (text[i - 1].isalnum() or text[i - 1] == "_")
            if m and not prev_ident:
                close = '"' + m.group(1)
                j = text.find(close, m.end())
                j = n if j < 0 else j + len(close)
                out.append(blank(text[i:j]))
                i = j
            elif c == '"' or (c in "bc" and text.startswith('"', i + 1) and not prev_ident):
                j = i + (2 if c != '"' else 1)
                while j < n and text[j] != '"':
                    j += 2 if text[j] == "\\" else 1
                j = min(j + 1, n)
                out.append(blank(text[i:j]))
                i = j
            elif c == "'":
                m = re.compile(r"'(?:\\(?:x[0-9a-fA-F]{2}|u\{[0-9a-fA-F_]+\}|.)|[^\\'])'").match(text, i)
                if m:
                    out.append(blank(m.group(0)))
                    i = m.end()
                else:  # a lifetime or label
                    out.append(c)
                    i += 1
            else:
                out.append(c)
                i += 1
    return "".join(out)


def suite_spans(text):
    """[(start, end, kind, qualified name, is_test)] for fns and mods, 1-based.

    Items are delimited by brace depth over the masked text, so braces in
    strings and comments cannot desync it. An item ends at the `}` that closes
    its first `{`, or at a `;` reached before any `{` (a bodyless fn). A span
    starts at the first attribute or comment line directly above the item.
    """
    lines = text.splitlines()
    masked = mask(text).splitlines()
    spans, stack, depth, above = [], [], 0, None
    item_re = re.compile(
        r"(?:pub(?:\([\w:]+\))? )?(?:(mod) (\w+)\b|(?:const )?(?:async )?(?:unsafe )?(fn) (\w+))"
    )
    for i, (orig, line) in enumerate(zip(lines, masked), 1):
        s = orig.strip()
        if s.startswith(("#[", "//")):
            above = above or i
            continue
        item = item_re.match(line.strip())
        if item:
            kind = item.group(1) or item.group(3)
            name = item.group(2) or item.group(4)
            start = above or i
            is_test = any(
                re.match(r"#\[(?:\w+::)?test\b", lines[j - 1].strip()) for j in range(start, i)
            )
            mods = [x["name"].rsplit("::", 1)[-1] for x in stack if x["kind"] == "mod"]
            stack.append(dict(start=start, kind=kind, name="::".join(mods + [name]),
                              is_test=is_test, base=depth, opened=False))
        above = None
        for ch in line:
            if ch == "{":
                depth += 1
                if stack and not stack[-1]["opened"] and depth == stack[-1]["base"] + 1:
                    stack[-1]["opened"] = True
            elif ch == "}":
                depth -= 1
                if stack and stack[-1]["opened"] and depth == stack[-1]["base"]:
                    it = stack.pop()
                    spans.append((it["start"], i, it["kind"], it["name"], it["is_test"]))
            elif ch == ";" and stack and not stack[-1]["opened"] and depth == stack[-1]["base"]:
                it = stack.pop()
                spans.append((it["start"], i, it["kind"], it["name"], it["is_test"]))
    return spans


def changed_lines(base, head, path):
    diff = git("diff", "-U0", f"{base}...{head}", "--", path)
    out = set()
    for m in re.finditer(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@", diff, re.M):
        start = int(m.group(1))
        count = 1 if m.group(2) is None else int(m.group(2))
        out.update(range(start, start + max(count, 1)))
    return out


def suite_filters(base, head):
    spans = suite_spans(git("show", f"{head}:{SUITE}"))
    exact, mods, unbounded = set(), set(), []
    for line in sorted(changed_lines(base, head, SUITE)):
        inside = [s for s in spans if s[0] <= line <= s[1]]
        fns = [s for s in inside if s[2] == "fn"]
        ms = [s for s in inside if s[2] == "mod"]
        inner = min(fns, key=lambda s: s[1] - s[0]) if fns else None
        if inner and inner[4]:
            exact.add(inner[3])
        elif ms:
            mods.add(min(ms, key=lambda s: s[1] - s[0])[3])
        else:
            unbounded.append(line)
    # A mod selected whole subsumes its exact tests.
    mods = {m for m in mods if not any(m.startswith(o + "::") for o in mods)}
    exact = {e for e in exact if not any(e.startswith(m + "::") for m in mods)}
    parts = [f"test(={e})" for e in sorted(exact)]
    parts += [f"test(/^{m}::/)" for m in sorted(mods)]
    return parts, unbounded


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--base", required=True)
    ap.add_argument("--head", default="HEAD")
    ap.add_argument("--github-output")
    args = ap.parse_args()
    files = git("diff", "--name-only", "--diff-filter=ACMR",
                f"{args.base}...{args.head}").splitlines()
    daemon, suite = [], []
    for p in files:
        if p.startswith(DAEMON_ROOT) and p.endswith(".rs"):
            if p == DAEMON_ROOT + "mod.rs":
                daemon += root_mod_prefixes(args.base, args.head)
            else:
                daemon.append(daemon_prefix(p))
    if SUITE in files:
        suite, unbounded = suite_filters(args.base, args.head)
        if unbounded:
            print(f"changed-test-filter: {SUITE} lines {unbounded[:10]} are outside any "
                  "test fn or mod; not selected", file=sys.stderr)
    cargo, clauses = [], []
    if daemon:
        cargo.append("--lib")
        keep = {p for p in daemon if not any(p != o and p.startswith(o) for o in daemon)}
        alts = " or ".join(f"test(/^{p}/)" for p in sorted(keep))
        clauses.append(f"({LIB} and ({alts}))")
    if suite:
        cargo += ["--test", "suite"]
        clauses.append(f"({SUITE_BIN} and ({' or '.join(suite)}))")
    flt = " or ".join(clauses)
    print(flt)
    if args.github_output:
        with open(args.github_output, "a") as f:
            f.write(f"selected={'true' if flt else 'false'}\n")
            f.write(f"filter={flt}\n")
            f.write(f"cargo_args={' '.join(cargo)}\n")


if __name__ == "__main__":
    main()
