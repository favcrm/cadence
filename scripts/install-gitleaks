#!/bin/sh
# CAD-109 CI backstop: install the pinned gitleaks release into a task-local
# directory after verifying the archive and the extracted binary against
# .config/gitleaks.sha256. Never writes PATH, the repository, or a
# production state directory.
set -eu

VERSION=8.30.1
ARCHIVE="gitleaks_${VERSION}_linux_x64.tar.gz"
URL="https://github.com/gitleaks/gitleaks/releases/download/v$VERSION/$ARCHIVE"
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
MANIFEST="$ROOT/.config/gitleaks.sha256"
INSTALL_DIR=${CADENCE_GITLEAKS_INSTALL_DIR:-/tmp/cadence-gitleaks-$VERSION}
TASK_TMP=${TMPDIR:-/tmp}

die() {
    echo "install-gitleaks: $*" >&2
    exit 1
}

case "$INSTALL_DIR" in
    /*) ;;
    *) die "CADENCE_GITLEAKS_INSTALL_DIR must be an absolute task-local path" ;;
esac
case "$TASK_TMP" in
    /*) ;;
    *) die "TMPDIR must be an absolute path" ;;
esac
case "$INSTALL_DIR" in
    "$TASK_TMP"|"$TASK_TMP"/*) ;;
    *) die "refusing install outside task-local TMPDIR ($TASK_TMP)" ;;
esac
case "$INSTALL_DIR" in
    "$ROOT"|"$ROOT"/*) die "refusing to install inside the repository" ;;
esac

for tool in awk sha256sum tar curl; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is required"
done
[ -f "$MANIFEST" ] || die "missing trusted artifact manifest: $MANIFEST"

archive_sha256=$(awk -v name="$ARCHIVE" \
    '$1 !~ /^#/ && $2 == name { print $1; exit }' "$MANIFEST")
binary_sha256=$(awk -v name=gitleaks \
    '$1 !~ /^#/ && $2 == name { print $1; exit }' "$MANIFEST")
[ -n "$archive_sha256" ] || die "no trusted checksum for archive $ARCHIVE"
[ -n "$binary_sha256" ] || die "no trusted checksum for extracted gitleaks"

mkdir -p "$INSTALL_DIR"
binary_path="$INSTALL_DIR/gitleaks"
if [ -f "$binary_path" ]; then
    existing_sha256=$(sha256sum "$binary_path" | awk '{print $1}')
    [ "$existing_sha256" = "$binary_sha256" ] ||
        die "existing binary checksum mismatch: refusing to overwrite $binary_path"
    printf '%s\n' "trusted gitleaks $VERSION already installed at $binary_path"
    exit 0
fi

archive_path="$INSTALL_DIR/$ARCHIVE"
if [ ! -f "$archive_path" ]; then
    download=$(mktemp "$INSTALL_DIR/.gitleaks-download.XXXXXX")
    trap 'rm -f "$download"' EXIT HUP INT TERM
    curl --fail --location --proto '=https' --tlsv1.2 --output "$download" "$URL" \
        || die "download failed: $URL"
    mv "$download" "$archive_path"
    trap - EXIT HUP INT TERM
fi
printf '%s  %s\n' "$archive_sha256" "$archive_path" | sha256sum -c - >/dev/null \
    || die "archive checksum mismatch: $archive_path"

extract_dir=$(mktemp -d "$INSTALL_DIR/.gitleaks-extract.XXXXXX")
trap 'rm -rf "$extract_dir"' EXIT HUP INT TERM
entries=$(tar -tzf "$archive_path" | sort | tr '\n' ' ')
[ "$entries" = "LICENSE README.md gitleaks " ] ||
    die "unexpected archive entries ($entries); refusing extraction"
tar -xzf "$archive_path" -C "$extract_dir" gitleaks || die "archive extraction failed"
actual_sha256=$(sha256sum "$extract_dir/gitleaks" | awk '{print $1}')
[ "$actual_sha256" = "$binary_sha256" ] ||
    die "extracted binary checksum mismatch: expected $binary_sha256, got $actual_sha256"
chmod 755 "$extract_dir/gitleaks"
mv "$extract_dir/gitleaks" "$binary_path"
trap - EXIT HUP INT TERM
rm -rf "$extract_dir"

version=$("$binary_path" version 2>&1) || die "installed binary could not report its version"
[ "$version" = "$VERSION" ] || die "installed binary reported unexpected version: $version"
printf '%s\n' "installed trusted gitleaks $VERSION at $binary_path"
