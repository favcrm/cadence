#!/usr/bin/env python3
"""Run a worktree command in this worktree's Boat sandbox.

The first command creates the sandbox and compiles cold. A later command
reuses it, so Cargo keeps target/ and the cargo registry. The sandbox stays
up for 30 minutes after the last command, then stops and is erased
(--no-snapshots). --down deletes it now, --fresh replaces it, and --once
deletes it when the command exits.

What is copied: a shallow git snapshot of the candidate commit and the base
(from their merge-base forward) and a binary patch of tracked edits. Not an
rsync, and not a pull from GitHub. Untracked files are refused. The shared
host does not compile. Required CI, review and approval remain authoritative.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
import uuid


OWNED = None
PUBLISHED = False
ONCE = False
LOG_FILE = None
CREATE_TTL = '3600'
IDLE_TTL = '1800'
SANDBOX_ID = re.compile(r'bx_[23456789abcdefghjkmnpqrstuvwxyz]{8}')
SHA = re.compile(r'[0-9a-f]{40}|[0-9a-f]{64}')
REMOTE_HOME = '/home/user'
PROBE = (
    'import os,subprocess,sys\n'
    'repo="/home/user/boat-worktree"\n'
    'shas=sys.argv[1:]\n'
    'if not os.path.isdir(os.path.join(repo,".git")):\n'
    '    print("repo miss")\n'
    '    print("\\n".join("miss "+s for s in shas))\n'
    '    raise SystemExit(0)\n'
    'print("repo have")\n'
    'for s in shas:\n'
    '    rc=subprocess.run(["git","-C",repo,"cat-file","-e",s+"^{commit}"],'
    'stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode\n'
    '    print(("have " if rc==0 else "miss ")+s)\n'
)


def _stop(signum, frame):
    # A published session stays up so the next command can reuse it.
    # An unpublished create, or an explicit one-shot run, is deleted.
    if OWNED and (not PUBLISHED or ONCE):
        try:
            cleanup(OWNED)
        except BaseException:
            pass
    os._exit(128 + signum)


signal.signal(signal.SIGTERM, _stop)
signal.signal(signal.SIGINT, _stop)


REMOTE = r'''import json, os, platform, re, shutil, signal, subprocess, sys, tarfile, time, zipfile
from pathlib import Path
home = Path(os.environ.get('CADENCE_BOAT_REMOTE_ROOT', '/home/user'))
job = json.loads((home / 'boat-job.json').read_text())
