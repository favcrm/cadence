#!/bin/sh
# CAD-173: pinned, zero-retry nextest runner.
#
# Usage (after human approval installs the pinned binary):
#   scripts/cadence-nextest --all-targets          # the whole suite
#   scripts/cadence-nextest --test daemon          # one area binary
#
# Direct invocations take the canonical outer host lock. `cadence review`
# already owns that lock in src/review.rs; it clears the child lock path and
# sets CADENCE_REVIEW_SUITE_LOCK_HELD=1, so this wrapper never nests flock.
set -eu

# CAD-1210: drop every CADENCE_* routing variable before nextest or any test
# binary runs, except the ones this script reads, so a pane's production
# CADENCE_PM_DIR/CADENCE_STATE_DIR never reaches the tests (CAD-1197 approach).
cadence_env_allow=" CADENCE_SUITE_LOCK CADENCE_NEXTTEST_BIN CADENCE_REVIEW_SUITE_LOCK_HELD CADENCE_REVIEW_PR CADENCE_REVIEW_HEAD "
for v in $(env | sed -n 's/^\(CADENCE_[A-Za-z0-9_]*\)=.*/\1/p'); do
    case $cadence_env_allow in *" $v "*) ;; *) unset "$v" ;; esac
done

PINNED_NEXTEST_VERSION=0.9.145
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# CADENCE_NEXTTEST_BIN wins; else the durable tools dir that
# scripts/install-cadence-nextest writes by default (CAD-273); else PATH.
# The checksum check below applies to whichever is chosen.
TOOLS_BIN="${XDG_DATA_HOME:-${HOME:-}/.local/share}/cadence/tools/cadence-nextest-$PINNED_NEXTEST_VERSION/cargo-nextest"
if [ -n "${CADENCE_NEXTTEST_BIN:-}" ]; then
    BIN=$CADENCE_NEXTTEST_BIN
elif [ -x "$TOOLS_BIN" ]; then
    BIN=$TOOLS_BIN
else
    BIN=cargo-nextest
fi
PROFILE="$ROOT/.config/nextest.toml"
TRUST_MANIFEST="$ROOT/.config/cargo-nextest.sha256"

die() {
    echo "cadence-nextest: $*" >&2
    exit 1
}

[ -f "$PROFILE" ] || die "missing pinned profile: $PROFILE"
[ -f "$TRUST_MANIFEST" ] || die "missing trusted artifact manifest: $TRUST_MANIFEST"

BIN_PATH=$(command -v "$BIN" 2>/dev/null) ||
    die "pinned cargo-nextest $PINNED_NEXTEST_VERSION is not installed"
[ -f "$BIN_PATH" ] && [ -x "$BIN_PATH" ] ||
    die "cargo-nextest path is not an executable file: $BIN_PATH"
command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required to verify cargo-nextest"
command -v awk >/dev/null 2>&1 || die "awk is required to read the trusted artifact manifest"

artifact_name=${BIN_PATH##*/}
expected_sha256=$(awk -v name="$artifact_name" \
    '$1 !~ /^#/ && $2 == name { print $1; exit }' "$TRUST_MANIFEST")
[ -n "$expected_sha256" ] ||
    die "no trusted checksum for executable '$artifact_name'"
actual_sha256=$(sha256sum "$BIN_PATH" 2>/dev/null) ||
    die "could not checksum cargo-nextest executable: $BIN_PATH"
actual_sha256=${actual_sha256%% *}
[ "$actual_sha256" = "$expected_sha256" ] ||
    die "untrusted cargo-nextest executable checksum: expected $expected_sha256, got $actual_sha256"

version=$("$BIN_PATH" --version 2>&1) || die "could not query $BIN_PATH --version"
case "$version" in
    "cargo-nextest $PINNED_NEXTEST_VERSION"*) ;;
    *) die "wrong cargo-nextest version: expected $PINNED_NEXTEST_VERSION, got '$version'" ;;
esac

SUBCOMMAND=run
case "${1:-}" in
    list|archive) SUBCOMMAND=$1; shift ;;
esac

blocked_no_tests=
for arg in "$@"; do
    if [ -n "$blocked_no_tests" ]; then
        case "$arg" in
            -*) ;;
            *) die "profile, config and retries are pinned; do not override '$blocked_no_tests $arg'" ;;
        esac
    fi
    case "$arg" in
        --retries|--retries=*|--profile|--profile=*|--config-file|--config-file=*)
            die "profile, config and retries are pinned; do not override '$arg'" ;;
        --no-tests)
            blocked_no_tests=$arg
            ;;
        --no-tests=*)
            die "profile, config and retries are pinned; do not override '$arg'" ;;
    esac
done
if [ -n "$blocked_no_tests" ]; then
    die "profile, config and retries are pinned; do not override '$blocked_no_tests'"
fi

cd "$ROOT" || die "cannot enter cadence repository root: $ROOT"

run_nextest() {
    if [ "$SUBCOMMAND" = run ]; then
        exec env -u NEXTEST_RETRIES -u NEXTEST_PROFILE \
            "$BIN_PATH" nextest "$SUBCOMMAND" \
            --config-file "$PROFILE" \
            --profile cadence \
            --retries 0 \
            --no-tests fail \
            "$@"
    fi
    exec env -u NEXTEST_RETRIES -u NEXTEST_PROFILE \
        "$BIN_PATH" nextest "$SUBCOMMAND" \
        --config-file "$PROFILE" \
        --profile cadence \
        "$@"
}

# Listing skips test execution and the host suite lock, but can compile test
# binaries. Obtain build admission before ordinary listing on a shared host.
if [ "$SUBCOMMAND" = list ]; then
    run_nextest "$@"
fi

if [ "${CADENCE_REVIEW_SUITE_LOCK_HELD:-}" = 1 ]; then
    [ -z "${CADENCE_SUITE_LOCK:-}" ] ||
        die "review-owned nextest child must receive an empty CADENCE_SUITE_LOCK"
    [ -n "${CADENCE_REVIEW_PR:-}" ] ||
        die "review-owned marker missing CADENCE_REVIEW_PR"
    [ -n "${CADENCE_REVIEW_HEAD:-}" ] ||
        die "review-owned marker missing CADENCE_REVIEW_HEAD"
    run_nextest "$@"
fi

LOCK=${CADENCE_SUITE_LOCK:-}
[ -n "$LOCK" ] ||
    die "direct nextest requires CADENCE_SUITE_LOCK; use cadence review or set an explicit lock path"
command -v flock >/dev/null 2>&1 || die "flock is required for the outer suite lock"

# The outer process owns the lock. Its child has an empty path and an
# explicit review-style marker, so process-per-test nextest workers cannot
# re-flock the same descriptor and deadlock.
# Archive also compiles and must retain its subcommand through lock re-entry.
if [ "$SUBCOMMAND" = archive ]; then
    set -- archive "$@"
fi
#
# CAD-955: `-o` closes the lock fd in the command's own process. Without
# it every process the suite starts inherits the fd, and a detached child
# that outlives nextest (a tmux server) keeps the lock held after the run.
exec flock -o "$LOCK" env \
    CADENCE_SUITE_LOCK= \
    CADENCE_REVIEW_SUITE_LOCK_HELD=1 \
    CADENCE_REVIEW_PR="${CADENCE_REVIEW_PR:-direct}" \
    CADENCE_REVIEW_HEAD="${CADENCE_REVIEW_HEAD:-direct}" \
    "$0" "$@"
