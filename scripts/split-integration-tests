# --------------------------------------------------------------------------
# Lexer: blank out strings / char literals / comments so structural scans
# never see their contents (raw-string bodies start at column 0 and would
# otherwise look like items).
# --------------------------------------------------------------------------

_STRING_PREFIX = re.compile(r"(br|cr|b|c|r)?(#*)\"")


def lex(src):
    """Return (mask, spans).

    mask is src with every string literal, char literal and comment blanked
    to spaces (newlines kept, positions preserved). spans lists the literal
    contents ranges, for the co-location scan.
    """
    n = len(src)
    mask = list(src)
    spans = []
    i = 0
    while i < n:
        c = src[i]
        if c == "/" and src[i:i + 2] == "//":
            j = src.find("\n", i)
            j = n if j < 0 else j
            for k in range(i, j):
                mask[k] = " "
            i = j
        elif c == "/" and src[i:i + 2] == "/*":
            depth = 1
            j = i + 2
            while j < n and depth:
                if src[j:j + 2] == "/*":
                    depth += 1
                    j += 2
                elif src[j:j + 2] == "*/":
                    depth -= 1
                    j += 2
                else:
                    j += 1
            for k in range(i, min(j, n)):
                if src[k] != "\n":
                    mask[k] = " "
            i = j
        elif c == "'":
            j = i + 1
            if j < n and src[j] == "\\":
                j += 1
                while j < n and src[j] != "'":
                    j += 1
                for k in range(i, min(j + 1, n)):
                    mask[k] = " "
                i = j + 1
            elif j + 1 < n and src[j + 1] == "'" and src[j] != "\n":
                for k in range(i, i + 3):
                    mask[k] = " "
                i += 3
            else:
                i += 1  # lifetime or malformed — leave for rustc
        else:
            m = _STRING_PREFIX.match(src, i)
            if c == '"' or m:
                if c == '"':
                    pre, hashes = "", ""
                    j = i + 1
                else:
                    pre, hashes = m.group(1) or "", m.group(2)
                    j = m.end()
                raw = "r" in pre
                content_start = j
                if raw:
                    close = '"' + hashes
                    k = src.find(close, j)
                    j = n if k < 0 else k + len(close)
                else:
                    while j < n:
                        if src[j] == "\\":
                            j += 2
                        elif src[j] == '"':
                            j += 1
                            break
                        else:
                            j += 1
                spans.append((content_start, min(j, n)))
                for k in range(i, min(j, n)):
                    if src[k] != "\n":
                        mask[k] = " "
                i = j
            else:
                i += 1
    return "".join(mask), spans


# --------------------------------------------------------------------------
# Item splitting.
# --------------------------------------------------------------------------

ITEM_HEAD = re.compile(
    r"(?:pub(?:\s*\([^)]*\))?\s+)?(?:unsafe\s+)?(?:async\s+)?"
    r"(use|const|static|struct|enum|union|trait|impl|fn|mod|type|"
    r"macro_rules!|extern)\b"
)
NAME_RES = [
    re.compile(r"\bfn\s+(\w+)"),
    re.compile(
        r"\b(?:const|static|struct|enum|union|trait|type|mod)\s+(\w+)"),
    re.compile(
        r"\bimpl\b(?:\s*<[^>]*>)?\s+(?:(?:[\w:]+(?:<[^>]*>)?)\s+for\s+)?"
        r"([\w:]+)"),
    re.compile(r"\bmacro_rules!\s*(\w+)"),
]

SECTION_RE = re.compile(r"^//\s*-{3,}\s*(.*?)\s*-*\s*$")


class Item:
    __slots__ = ("kind", "name", "lead", "start", "end", "text", "masked",
                 "section", "is_test", "order")

    def __init__(self, kind, name, lead, start, end, text, masked, section,
                 order):
        self.kind = kind
        self.name = name
        self.lead = lead            # raw trivia text preceding the head
        self.start = start          # offset of trivia start
        self.end = end              # offset just past the item
        self.text = text            # raw item text (head..end)
        self.masked = masked        # masked item text
        self.section = section      # // ---- marker title in effect
        self.is_test = False
        self.order = order

    @property
    def chunk(self):
        """lead + item text as emitted (trivia travels with the item)."""
        return self.lead + self.text


def _item_end(mask, start, kind, n):
    """Offset just past the item beginning at `start` in `mask`."""
    b = p = s = 0
    semi_only = kind in ("use", "mod", "const", "static", "type")
    for i in range(start, n):
        c = mask[i]
        if c == "{":
            b += 1
        elif c == "}":
            if b == 1 and p == 0 and s == 0 and not semi_only:
                return i + 1
            b -= 1
        elif c == "(":
            p += 1
        elif c == ")":
            p -= 1
        elif c == "[":
            s += 1
        elif c == "]":
            s -= 1
        elif c == ";" and b == 0 and p == 0 and s == 0:
            return i + 1
    raise ValueError(f"unterminated {kind} item at byte {start}")


def parse_items(src):
    """Split src into items; the file preamble becomes the first item's lead.

    Returns (items, mask, string_spans).
    """
    mask, spans = lex(src)
    lines = src.split("\n")
    mlines = mask.split("\n")
    offs = [0]
    for l in lines:
        offs.append(offs[-1] + len(l) + 1)
    items = []
    section = ""
    prev_end = 0
    for i, ml in enumerate(mlines):
        m = ITEM_HEAD.match(ml)
        if not m:
            continue
        kind = m.group(1)
        start = offs[i]
        end = _item_end(mask, start, kind, len(src))
        lead = src[prev_end:start]
        for ll in lead.split("\n"):
            sm = SECTION_RE.match(ll)
            if sm and sm.group(1).strip():
                section = sm.group(1).strip()
        mtext = mask[start:end]
        name = None
        for rx in NAME_RES:
            nm = rx.search(mtext)
            if nm:
                name = nm.group(1)
                break
        if kind == "impl" and name:
            name = "impl:" + name
        it = Item(kind, name, lead, prev_end, end, src[start:end], mtext,
                  section, len(items))
        it.is_test = bool(re.search(r"(?m)^\s*#\[\s*test\s*\]", lead))
        items.append(it)
        prev_end = end
    if items:
        tail = src[prev_end:]
        if tail.strip():
            items[-1].text += tail  # trailing comments ride the last item
    return items, mask, spans


# --------------------------------------------------------------------------
# `use` pruning.
# --------------------------------------------------------------------------

def _use_leaves(masked_stmt):
    """Flatten `use a::{b, c::{d}};` to [(path_tuple, bind_name)].

    Returns None when the item has a `*` leaf — the caller keeps it whole.
    """
    body = masked_stmt.strip()
    assert body.startswith("use ") and body.endswith(";")
    toks = re.findall(r"[A-Za-z_]\w*|::|\{|\}|,|\*", body[4:-1])
    out = []

    def parse_path(i, prefix):
        prefix = prefix + (toks[i],)
        i += 1
        while i < len(toks) and toks[i] == "::":
            i += 1
            t = toks[i]
            if t == "{":
                i += 1
                while toks[i] != "}":
                    if toks[i] == ",":
                        i += 1
                        continue
                    i = parse_path(i, prefix)[0]
                i += 1
                return i, None
            if t == "*":
                out.append((prefix + ("*",), "*"))
                return i + 1, None
            prefix = prefix + (t,)
            i += 1
        bind = prefix[-1]
        if i < len(toks) and toks[i] == "as":
            bind = toks[i + 1]
            i += 2
        out.append((prefix, bind))
        return i, None

    parse_path(0, ())
    if any(b == "*" for _, b in out):
        return None
    fixed = []
    for path, bind in out:
        if path[-1] == "self":
            path = path[:-1]
            bind = path[-1]
        fixed.append((path, bind))
    return fixed


def pruned_uses(use_items, masked_chunks):
    """Keep only leaves whose bound name appears in the emitted code.

    A leaf survives only when its bound name occurs as a *bare* identifier
    — `Arc` inside `std::sync::Arc::new` does not need `use std::sync::Arc`.
    Trait leaves additionally survive on method-call (`.m(`) or macro
    (`m!`) evidence, since a method call never names its trait; that test
    can over-keep when the call resolves to an inherent method, and the
    residual is listed in DROP_USES.
    """

    def bare(name):
        return re.search(r"(?<![\w:.])" + re.escape(name) + r"\b",
                         masked_chunks)

    emitted = []
    for it in use_items:
        leaves = _use_leaves(it.masked)
        if leaves is None:
            emitted.append(it.text.strip())
            continue
        for path, bind in leaves:
            full = "::".join(path)
            keep = bool(bare(bind))
            if not keep:
                meths = TRAIT_METHODS.get(full)
                keep = bool(meths) and any(
                    re.search(r"\." + re.escape(m) + r"\s*\(|"
                              r"\b" + re.escape(m) + r"\s*!",
                              masked_chunks)
                    for m in meths)
            if keep:
                if bind != path[-1]:
                    emitted.append(f"use {full} as {bind};")
                else:
                    emitted.append(f"use {full};")
    seen, out = set(), []
    for u in emitted:
        if u not in seen:
            seen.add(u)
            out.append(u)
    return out


def pruned_uses_for(path, use_items, masked_chunks):
    drop = set(DROP_USES.get(path, ()))
    return [u for u in pruned_uses(use_items, masked_chunks)
            if u[len("use "):-1].split(" as ")[0] not in drop]


# --------------------------------------------------------------------------
# pub-promotion for items emitted into tests/common/mod.rs.
# --------------------------------------------------------------------------

def _pub_members(text, pred):
    """Add `pub` to depth-1 member lines matching `pred` inside the item."""
    m, _ = lex(text)
    lines = text.split("\n")
    mlines = m.split("\n")
    out = []
    depth = 0
    for l, ml in zip(lines, mlines):
        if depth == 1 and not ml.lstrip().startswith("pub"):
            sm = pred(ml.lstrip())
            if sm:
                indent = re.match(r"\s*", l).group(0)
                l = indent + "pub " + l[len(indent):]
        out.append(l)
        depth += ml.count("{") - ml.count("}")
    return "\n".join(out)


def _promote(item):
    """Item text with pub visibility where common membership needs it."""
    k = item.kind
    text = item.text
    if k == "impl":
        head = item.masked.split("{", 1)[0]
        if re.search(r"\bfor\b", head):
            return text
        return _pub_members(
            text, lambda s: re.match(r"(?:fn|const|static|type)\b", s))
    if k in ("struct", "enum", "union"):
        text = re.sub(r"^(\s*)", "pub ", text, count=1)
        if k == "struct":
            text = _pub_members(
                text, lambda s: re.match(r"[A-Za-z_]\w*\s*:", s))
            m = re.search(r"(\bstruct\s+\w+(?:\s*<[^>]*>)?)\s*\(", text)
            if m:  # tuple struct: pub on every top-level field
                depth = 0
                i = text.index("(", m.end() - 1)
                inner_start = i + 1
                j = inner_start
                parts = []
                cur = []
                while j < len(text):
                    c = text[j]
                    if c in "(<[":
                        depth += 1
                    elif c in ")>]":
                        if depth == 0:
                            break
                        depth -= 1
                    if c == "," and depth == 0:
                        parts.append("".join(cur))
                        cur = []
                    else:
                        cur.append(c)
                    j += 1
                parts.append("".join(cur))
                inner = ",".join(
                    p if re.match(r"\s*pub\b", p) else "pub " + p.lstrip()
                    for p in parts)
                text = text[:inner_start] + inner + text[j:]
        return text
    if k == "mod":
        return re.sub(r"^(\s*)", "pub ", text, count=1)
    if k in ("fn", "const", "static", "type", "trait"):
        return re.sub(r"^(\s*)", "pub ", text, count=1)
    if k == "macro_rules!":
        raise SystemExit("macro_rules! items are not supported; add handling")
    return text


def _apply_edits(name, text):
    for old, new in TEXT_EDITS.get(name, []):
        if old not in text:
            raise SystemExit(f"TEXT_EDITS: pattern not found in {name!r}")
        text = text.replace(old, new, 1)
    return text


# --------------------------------------------------------------------------
# Placement.
# --------------------------------------------------------------------------

def place_test(name, section):
    if name in PINNED:
        return PINNED[name]
    for rx, area in PREFIX_RULES:
        if re.match(rx, name):
            return area
    for rx, area in SECTION_RULES:
        if re.search(rx, section):
            return area
    if not section:
        return "daemon"  # pre-marker core tests
    return None


def assign_helpers(items, area_of_test):
    """Split non-test items into common vs per-area via a reachability BFS.

    A helper reached from exactly one area's tests stays local to that
    binary; anything else lands in common. Name scans run on masked text and
    over-approximate — a false positive only pushes an item into common.
    """
    named = [it for it in items if it.kind != "use" and not it.is_test]
    by_name = {}
    for it in named:
        if it.name:
            by_name[it.name] = it
    word = re.compile(r"\b(" + "|".join(
        re.escape(n) for n in sorted(by_name, key=len, reverse=True))
        + r")\b") if by_name else None

    reach = {}
    tests_by_area = {}
    for it in items:
        if it.is_test and area_of_test.get(it.name):
            tests_by_area.setdefault(area_of_test[it.name], []).append(it)
    for area, roots in tests_by_area.items():
        seen = set()
        stack = list(roots)
        while stack:
            it = stack.pop()
            if id(it) in seen:
                continue
            seen.add(id(it))
            if word:
                for nm in word.findall(it.masked):
                    tgt = by_name.get(nm)
                    if tgt is not None and tgt is not it:
                        stack.append(tgt)
        for it in named:
            if id(it) in seen:
                reach.setdefault(it.name, set()).add(area)

    # A helper a common item calls must live in common too — impl blocks
    # are never reached by name (nothing in code spells "impl:X"), so a
    # fn called only inside an impl plus one area's tests would otherwise
    # land in that binary while common/mod.rs still calls it. Compute the
    # per-item dependency set and close over common until stable.
    deps = {}
    for it in named:
        deps[id(it)] = {
            by_name[nm] for nm in word.findall(it.masked)
            if nm in by_name and by_name[nm] is not it
        } if word else set()

    in_common = {}
    for it in named:
        areas = reach.get(it.name) or set()
        in_common[it] = (
            not (it.kind == "fn" and len(areas) == 1)
            or it.name in COMMON_PIN)
    moved = True
    while moved:
        moved = False
        for it in named:
            if not in_common[it]:
                continue
            for d in deps.get(id(it), ()):
                if not in_common[d]:
                    in_common[d] = True
                    moved = True

    common, local = [], {}
    for it in named:
        if in_common[it]:
            common.append(it)
        else:
            areas = reach[it.name]
            local.setdefault(next(iter(areas)), []).append(it)
    return common, local


# --------------------------------------------------------------------------
# Emission.
# --------------------------------------------------------------------------

def emit_common(common_items, use_items):
    emitted = []
    for it in common_items:
        emitted.append(_apply_edits(it.name, it.lead + _promote(it)))
    joined = "".join(emitted)
    uses = pruned_uses_for(COMMON, use_items, lex(joined)[0])
    body = COMMON_PREAMBLE + "\n" + "\n".join(uses) + "\n\n"
    return body + joined.lstrip("\n")


def emit_binary(area, chunks, use_items, common_names):
    masked_all = "".join(c.masked for c in chunks)
    uses = pruned_uses_for(f"tests/{area}.rs", use_items, masked_all)
    head = BIN_PREAMBLE.format(area=area)
    if not common_names.intersection(
            set(re.findall(r"[A-Za-z_]\w*", masked_all))):
        head = head.replace(
            "use common::*;", "#[allow(unused_imports)]\nuse common::*;")
    body = head + "\n"
    if uses:
        body += "\n".join(uses) + "\n"
    body += "\n"
    body += "".join(_apply_edits(c.name, c.chunk) for c in chunks)
    return body


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text if text.endswith("\n") else text + "\n")


def rustfmt(text):
    """Format emitted Rust the way `cargo fmt` will, so generated files are
    fmt-clean the moment they land (and `--check` compares the formatted
    form)."""
    try:
        p = subprocess.run(
            ["rustfmt", "--edition", "2021", "--emit", "stdout"],
            input=text, capture_output=True, text=True)
    except FileNotFoundError:
        raise SystemExit("rustfmt not found on PATH")
    if p.returncode != 0:
        raise SystemExit("rustfmt failed on generated output:\n" + p.stderr)
    return p.stdout


def read_manifest_pins():
    """tests/split-map.toml, if present, pins its listed tests to their
    binary — the map survives as the seed of the next run."""
    pins = {}
    if not os.path.exists(MANIFEST):
        return pins
    area = None
    in_tests = False
    for line in open(MANIFEST):
        s = line.strip()
        m = re.match(r"\[binaries\.(\w+)\]", s)
        if m:
            area = m.group(1)
        elif s == "tests = [":
            in_tests = area is not None
        elif s.startswith("]"):
            in_tests = False
        elif in_tests and s.startswith('"'):
            pins[s.strip('",')] = area
    return pins


def main():
    check = "--check" in sys.argv
    src = open(SRC).read()
    items, mask, spans = parse_items(src)
    if not items:
        raise SystemExit(f"no items found in {SRC}")

    tests = [it for it in items if it.is_test]
    use_items = [it for it in items if it.kind == "use"]

    prior = read_manifest_pins()
    if prior:
        PINNED.update({k: v for k, v in prior.items()})

    area_of = {}
    unplaced = []
    for it in tests:
        area = place_test(it.name, it.section)
        (area_of.__setitem__(it.name, area) if area
         else unplaced.append(it))

    # Co-location: a test that names another test inside a string literal
    # re-runs it via current_exe(); force the pair into one binary.
    test_names = {it.name for it in tests}
    name_re = re.compile(r"\b(" + "|".join(
        re.escape(n) for n in sorted(test_names, key=len, reverse=True))
        + r")\b")
    ends = [it.end for it in tests]
    name_of = {it.name: it for it in tests}

    def owner(pos):
        i = bisect_left(ends, pos)
        if i < len(tests) and tests[i].start <= pos < tests[i].end:
            return tests[i]
        return None

    for s0, s1 in spans:
        it = owner(s0)
        if it is None:
            continue
        for nm in set(name_re.findall(src[s0:s1])) - {it.name}:
            other = name_of[nm]
            pa, pb = area_of.get(it.name), area_of.get(other.name)
            if pa and pb and pa != pb:
                raise SystemExit(
                    f"co-location conflict: {it.name} ({pa}) spawns "
                    f"{other.name} ({pb})")
            if pa and not pb:
                area_of[other.name] = pa
                if other in unplaced:
                    unplaced.remove(other)
            elif pb and not pa:
                area_of[it.name] = pb
                if it in unplaced:
                    unplaced.remove(it)

    common, local = assign_helpers(items, area_of)

    outputs = {COMMON: emit_common(common, use_items)}
    common_names = {it.name for it in common if it.name}
    for area in AREAS:
        local_ids = {id(x) for x in local.get(area, [])}
        chunks = [it for it in items
                  if it.kind != "use"
                  and ((it.is_test and area_of.get(it.name) == area)
                       or (not it.is_test and id(it) in local_ids))]
        if not chunks:
            continue
        outputs[f"tests/{area}.rs"] = emit_binary(
            area, chunks, use_items, common_names)

    if unplaced:
        body = BIN_PREAMBLE.format(area="unplaced").replace(
            "mod common;\nuse common::*;\n", "")
        body += "".join(it.chunk for it in unplaced)
        outputs[UNPLACED] = body

    lines = ["# CAD-426 — generated by scripts/split-integration-tests;",
             "# do not hand-edit. Re-run the script on a newer",
             "# tests/integration.rs to regenerate this map.",
             "",
             "[common]",
             "helpers = ["]
    lines += [f'    "{it.name}",' for it in common if it.name]
    lines += ["]", ""]
    for area in AREAS:
        if f"tests/{area}.rs" not in outputs:
            continue
        lines.append(f"[binaries.{area}]")
        lines.append("tests = [")
        for it in items:
            if it.is_test and area_of.get(it.name) == area:
                lines.append(f'    "{it.name}",')
        lines.append("]")
        lines.append("helpers = [")
        for it in local.get(area, []):
            if it.name:
                lines.append(f'    "{it.name}",')
        lines += ["]", ""]
    outputs[MANIFEST] = "\n".join(lines)

    for p in list(outputs):
        if p.endswith(".rs"):
            outputs[p] = rustfmt(outputs[p])

    if check:
        stale = [p for p, t in outputs.items()
                 if not os.path.exists(p) or open(p).read() != t]
        if stale:
            print("stale generated files:", *stale, sep="\n  ")
            return 1
        print("generated files are current")
        return 0

    for path, text in outputs.items():
        write(path, text)
    if not unplaced:
        if os.path.exists(UNPLACED):
            os.remove(UNPLACED)
        os.remove(SRC)
        print(f"removed {SRC}")
    for path in outputs:
        print("wrote", path)
    if unplaced:
        print(f"\n{len(unplaced)} unplaced test(s) -> {UNPLACED}:",
              file=sys.stderr)
        for it in unplaced:
            print(f"  {it.name}  (section: {it.section!r})", file=sys.stderr)
        return 1
    n_bins = len([p for p in outputs
                  if p.startswith("tests/") and p.endswith(".rs")
                  and p != COMMON and p != UNPLACED])
    print(f"{len(tests)} tests -> {n_bins} binaries")
    return 0



if __name__ == "__main__":
    sys.exit(main())
