{
  "name": "@cadence/hosted-runtime",
  "version": "0.1.0",
  "description": "Provider-neutral hosted agent conversation runtime behind one Durable Object.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/runtime.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/build.mjs",
    "verify": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "agents": "0.30.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.4.0",
    "@cloudflare/workers-types": "5.20260930.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
