{
  "name": "cadence-board-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:url-state": "pnpm test",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "tmp_dir=$(mktemp -d \"${TMPDIR:-/tmp}/cadence-ui-tests.XXXXXX\") && trap 'rm -rf \"$tmp_dir\"' EXIT && tsc -p tsconfig.tests.json --outDir \"$tmp_dir\" && for t in \"$tmp_dir\"/tests/*.test.js; do NODE_PATH=\"$PWD/node_modules\" node \"$t\" || exit 1; done"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "1.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "17.4.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
