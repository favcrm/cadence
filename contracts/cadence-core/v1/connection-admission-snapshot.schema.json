        {
          "type": "null"
        }
      ]
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeFactsV1"
    },
    "snapshot_id": {
      "$ref": "#/$defs/UuidV1"
    },
    "test_send_record": {
