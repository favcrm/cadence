    "ConnectionFactsV1": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/Ident"
        },
        "authorization_revision": {
          "$ref": "#/$defs/Revision"
        },
        "connection_id": {
          "$ref": "#/$defs/Ident"
        },
        "credential_revision": {
          "$ref": "#/$defs/Revision"
        },
        "custody_domain": {
          "$ref": "#/$defs/Ident"
        },
        "enabled": {
          "type": "boolean"
        },
        "exchange": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
