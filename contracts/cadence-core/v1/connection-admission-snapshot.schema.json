        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityV1"
          }
        },
        "manifest_id": {
          "$ref": "#/$defs/Ident"
        },
        "material_digest": {
          "$ref": "#/$defs/Digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/Digest"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "v": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "v",
        "manifest_id",
        "revision",
        "artifacts",
        "capabilities",
        "policy_digest",
        "material_digest"
      ]
