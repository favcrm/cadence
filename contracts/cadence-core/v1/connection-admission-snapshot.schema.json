    "DestinationKindV1": {
      "type": "string",
      "enum": [
        "smtp",
        "https"
      ]
    },
    "Digest": {
      "description": "`sha256:` plus 64 lowercase hex digits.",
      "type": "string"
    },
    "DispatchStateV1": {
      "type": "string",
      "enum": [
        "committed",
        "done",
        "refused",
        "unknown",
        "overrun"
      ]
    },
    "EffectClassV1": {
      "type": "string",
      "enum": [
        "read",
        "draft"
      ]
    },
    "EpochMs": {
      "description": "Trusted epoch milliseconds: a checked safe JSON integer, never a float.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "ExistingDispatchV1": {
      "type": "object",
      "properties": {
        "commitment_digest": {
          "$ref": "#/$defs/Digest"
        },
        "dispatch_id": {
          "$ref": "#/$defs/UuidV1"
        },
        "idempotency_digest": {
          "$ref": "#/$defs/Digest"
        },
        "payload_digest": {
          "$ref": "#/$defs/Digest"
        },
        "request_id": {
          "$ref": "#/$defs/UuidV1"
        },
        "reserved_micros": {
          "$ref": "#/$defs/UsdMicros"
        },
        "state": {
          "$ref": "#/$defs/DispatchStateV1"
        },
        "v": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "v",
