        "kind": {
          "$ref": "#/$defs/NativeBindingKindV1"
        },
        "launch_digest": {
          "$ref": "#/$defs/Digest"
        },
        "owner_generation": {
          "$ref": "#/$defs/Revision"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "launch_digest",
        "continuity_digest",
        "agent_generation",
        "owner_generation"
      ]
    },
    "NativeSessionV1": {
      "type": "object",
      "properties": {
        "generation": {
          "$ref": "#/$defs/Revision"
