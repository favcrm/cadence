          }
        },
        "allowed_human_operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationKindV1"
          }
        },
        "allowed_models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelId"
          }
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperationKindV1"
          }
        },
        "approved_document_digest": {
          "$ref": "#/$defs/Digest"
        },
        "data_scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DataScopeV1"
          }
        },
        "policy_revision": {
          "$ref": "#/$defs/Revision"
        },
        "provider_profile": {
          "$ref": "#/$defs/Ident"
        }
