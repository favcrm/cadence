    "FenceStateV1": {
      "type": "string",
      "enum": [
        "clear",
        "revoking",
        "revoked",
        "unknown"
      ]
    },
    "GrantStateV1": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ]
    },
    "HostedBindingKindV1": {
      "type": "string",
      "enum": [
        "hosted"
      ]
    },
    "HostedRuntimeBindingV1": {
      "type": "object",
      "properties": {
        "activation_id": {
          "$ref": "#/$defs/UuidV1"
