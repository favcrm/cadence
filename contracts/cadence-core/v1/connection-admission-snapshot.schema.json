          "$ref": "#/$defs/FenceStateV1"
        },
        "incarnation": {
          "$ref": "#/$defs/Ident"
        },
        "key_id": {
          "$ref": "#/$defs/Ident"
        },
        "policy_revision": {
          "$ref": "#/$defs/Revision"
        },
        "provider_kind": {
          "$ref": "#/$defs/ProviderKindV1"
        },
        "workspace_id": {
          "$ref": "#/$defs/Ident"
        }
      },
      "additionalProperties": false,
      "required": [
        "connection_id",
        "provider_kind",
        "workspace_id",
        "custody_domain",
        "account",
        "incarnation",
        "credential_revision",
        "authorization_revision",
        "policy_revision",
        "key_id",
        "enabled",
        "fence"
      ]
    },
    "Counter": {
      "description": "Nonnegative canonical decimal counter (`0|[1-9][0-9]*`, <= i64::MAX).",
      "type": "string"
    },
    "DataScopeSourceV1": {
      "type": "string",
      "enum": [
        "caller_text",
        "immutable_source"
      ]
    },
    "DataScopeV1": {
      "type": "object",
      "properties": {
        "allow_caller_text": {
          "type": "boolean"
        },
        "content_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
