      "properties": {
        "authorization_revision": {
          "$ref": "#/$defs/Revision"
        },
        "body_digest": {
          "$ref": "#/$defs/Digest"
        },
        "connection_id": {
          "$ref": "#/$defs/Ident"
        },
        "credential_revision": {
          "$ref": "#/$defs/Revision"
        },
        "destination_digest": {
          "$ref": "#/$defs/Digest"
        },
        "human_decision_ref": {
          "$ref": "#/$defs/Ident"
        },
        "kind": {
          "$ref": "#/$defs/OperationKindV1"
        },
        "policy_revision": {
          "$ref": "#/$defs/Revision"
        },
        "record_id": {
          "$ref": "#/$defs/Ident"
        }
      },
      "additionalProperties": false,
      "required": [
        "record_id",
        "kind",
        "connection_id",
        "credential_revision",
        "authorization_revision",
        "policy_revision",
        "body_digest",
        "destination_digest",
        "human_decision_ref"
      ]
    },
    "Ident": {
      "description": "Bounded printable ASCII identifier (`0x21..=0x7e`, 1..=128 bytes).",
      "type": "string"
    },
    "LedgerHeadV1": {
      "type": "object",
      "properties": {
        "database_epoch": {
          "$ref": "#/$defs/Revision"
        },
        "digest": {
