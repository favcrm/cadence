    "CapabilityV1": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Ident"
        },
        "callable": {
          "$ref": "#/$defs/CallableV1"
        },
        "capability_id": {
          "$ref": "#/$defs/Ident"
        },
        "connection_scope": {
          "$ref": "#/$defs/Ident"
        },
        "effect": {
          "$ref": "#/$defs/EffectClassV1"
        },
        "operation": {
          "$ref": "#/$defs/OperationKindV1"
        },
        "policy_scope": {
          "$ref": "#/$defs/Ident"
        }
      },
      "additionalProperties": false,
      "required": [
        "capability_id",
        "callable",
        "artifact_id",
        "operation",
        "effect",
        "connection_scope",
        "policy_scope"
      ]
