    "LimitSetV1": {
      "type": "object",
      "properties": {
        "daily_micros": {
          "$ref": "#/$defs/UsdMicros"
        },
        "lifetime_micros": {
          "$ref": "#/$defs/UsdMicros"
        },
        "per_call_micros": {
          "$ref": "#/$defs/UsdMicros"
        },
        "requests_per_60s": {
          "$ref": "#/$defs/Counter"
        },
        "unresolved": {
          "$ref": "#/$defs/Counter"
        }
      },
      "additionalProperties": false,
      "required": [
        "requests_per_60s",
        "unresolved",
        "daily_micros",
        "lifetime_micros",
        "per_call_micros"
      ]
