          "$ref": "#/$defs/LimitSetV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "principal",
        "account",
        "workspace"
      ]
    },
    "PrincipalBindingV1": {
      "description": "The persisted principal binding. Untrusted selectors never reach this\nshape; it is built by the trusted adapter from durable rows.",
      "type": "object",
      "properties": {
        "agent_uid": {
          "$ref": "#/$defs/AgentUid"
        },
        "alias": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding": {
          "$ref": "#/$defs/RuntimeBindingV1"
        },
        "conversation_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "custody_domain": {
          "$ref": "#/$defs/Ident"
        },
        "enrollment_generation": {
          "$ref": "#/$defs/Revision"
        },
        "kind": {
          "$ref": "#/$defs/PrincipalKindV1"
        },
        "native_session": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeSessionV1"
            },
            {
              "type": "null"
            }
          ]
        },
        "principal_id": {
          "$ref": "#/$defs/Ident"
        },
        "session_authority_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace_id": {
          "$ref": "#/$defs/Ident"
        }
      },
      "additionalProperties": false,
      "required": [
        "custody_domain",
        "workspace_id",
        "kind",
        "principal_id",
        "agent_uid",
        "enrollment_generation",
        "binding"
      ]
    },
    "PrincipalKindV1": {
      "type": "string",
      "enum": [
        "agent",
        "human"
      ]
    },
    "ProviderKindV1": {
      "type": "string",
      "enum": [
        "smtp",
        "openrouter"
      ]
    },
    "RequesterV1": {
      "type": "object",
      "properties": {
        "agent_uid": {
          "$ref": "#/$defs/AgentUid"
        },
        "runtime_generation": {
