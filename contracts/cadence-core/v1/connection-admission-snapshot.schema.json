    "v",
    "snapshot_id",
    "dispatch_id",
    "request_id",
    "now_ms",
    "clock_floor_ms",
    "database_epoch",
    "ledger_head",
    "requester",
    "principal",
    "runtime",
    "connection",
    "policy",
    "grants",
    "limits",
    "exposure",
    "manifest",
    "observed_registry_digest",
    "policy_digest",
    "resolved"
