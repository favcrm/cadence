    },
    "connection": {
      "$ref": "#/$defs/ConnectionFactsV1"
    },
    "database_epoch": {
      "$ref": "#/$defs/Revision"
    },
    "dispatch_id": {
      "$ref": "#/$defs/UuidV1"
    },
    "existing": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExistingDispatchV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "exposure": {
      "$ref": "#/$defs/ExposureFactsV1"
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UidGrantV1"
      }
    },
    "ledger_head": {
      "$ref": "#/$defs/LedgerHeadV1"
    },
    "limits": {
      "$ref": "#/$defs/OwnerLimitsV1"
    },
    "manifest": {
      "$ref": "#/$defs/ManifestV1"
    },
    "now_ms": {
      "$ref": "#/$defs/EpochMs"
    },
    "observed_registry_digest": {
      "$ref": "#/$defs/Digest"
    },
    "policy": {
      "$ref": "#/$defs/OperationPolicyV1"
    },
    "policy_digest": {
      "$ref": "#/$defs/Digest"
    },
    "principal": {
      "$ref": "#/$defs/PrincipalBindingV1"
    },
    "request_id": {
      "$ref": "#/$defs/UuidV1"
    },
    "requester": {
      "$ref": "#/$defs/RequesterV1"
    },
    "resolved": {
      "$ref": "#/$defs/ResolvedMaterialV1"
    },
    "role_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/RoleModelPolicyV1"
