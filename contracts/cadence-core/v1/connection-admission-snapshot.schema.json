        "session_id": {
          "$ref": "#/$defs/Ident"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "generation"
      ]
    },
    "OperationKindV1": {
      "description": "The typed operations a protected Connection dispatch may name.",
      "type": "string",
      "enum": [
        "text.generate@1",
        "smtp.send@1",
        "smtp.test_send@1",
        "smtp.verify@1"
      ]
    },
    "OperationPolicyV1": {
      "type": "object",
      "properties": {
        "active": {
