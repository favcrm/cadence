        },
        "input_schema_digest": {
          "$ref": "#/$defs/Digest"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKindV1"
        },
        "output_schema_digest": {
          "$ref": "#/$defs/Digest"
        },
        "resource_digest": {
          "$ref": "#/$defs/Digest"
        },
        "version": {
          "$ref": "#/$defs/Ident"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "version",
        "content_digest",
        "implementation_digest",
        "resource_digest",
