    "ExposureFactsV1": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/ExposureScopeV1"
        },
        "principal": {
          "$ref": "#/$defs/ExposureScopeV1"
        },
        "workspace": {
          "$ref": "#/$defs/ExposureScopeV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "principal",
        "account",
        "workspace"
      ]
    },
    "ExposureScopeV1": {
      "type": "object",
      "properties": {
        "daily_settled_micros": {
          "$ref": "#/$defs/UsdMicros"
        },
        "lifetime_settled_micros": {
          "$ref": "#/$defs/UsdMicros"
        },
        "recent_request_ms": {
          "description": "Request timestamps inside the caller's durable view of the window.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EpochMs"
