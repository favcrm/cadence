{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelQuoteV1",
  "type": "object",
  "properties": {
    "authorization_revision": {
      "$ref": "#/$defs/Revision"
    },
    "connection_id": {
      "$ref": "#/$defs/Ident"
    },
    "context_bound": {
      "$ref": "#/$defs/Counter"
    },
    "credential_revision": {
      "$ref": "#/$defs/Revision"
    },
    "endpoints": {
      "description": "Exact fixed routing endpoint set; the destination must be one of them.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/HttpsUrl"
      }
    },
    "fallback": {
      "$ref": "#/$defs/FallbackPolicyV1"
    },
    "max_cost_micros": {
      "$ref": "#/$defs/UsdMicros"
    },
    "max_output_bound": {
      "$ref": "#/$defs/Counter"
    },
    "metadata_digest": {
      "$ref": "#/$defs/Digest"
    },
    "metadata_expires_ms": {
      "$ref": "#/$defs/EpochMs"
    },
    "metadata_observed_ms": {
      "$ref": "#/$defs/EpochMs"
    },
    "model": {
      "$ref": "#/$defs/ModelId"
    },
    "parameters": {
      "$ref": "#/$defs/ParameterPolicyV1"
    },
    "policy_revision": {
      "$ref": "#/$defs/Revision"
    },
    "price": {
      "$ref": "#/$defs/QuotePriceV1"
    },
    "privacy_policy": {
      "$ref": "#/$defs/Ident"
    },
    "provider_profile": {
      "$ref": "#/$defs/Ident"
    },
    "quote_id": {
      "$ref": "#/$defs/UuidV1"
    },
    "routing_profile": {
      "$ref": "#/$defs/Ident"
    },
    "service_tier": {
      "$ref": "#/$defs/Ident"
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "v",
    "quote_id",
    "connection_id",
    "credential_revision",
    "authorization_revision",
    "policy_revision",
    "provider_profile",
    "routing_profile",
    "model",
    "endpoints",
    "fallback",
    "parameters",
    "service_tier",
    "metadata_digest",
    "metadata_observed_ms",
    "metadata_expires_ms",
    "context_bound",
    "max_output_bound",
    "price",
    "privacy_policy",
    "max_cost_micros"
  ],
  "$defs": {
    "Counter": {
      "description": "Nonnegative canonical decimal counter (`0|[1-9][0-9]*`, <= i64::MAX).",
      "type": "string"
    },
    "CurrencyV1": {
      "type": "string",
      "enum": [
        "USD"
      ]
    },
    "Digest": {
      "description": "`sha256:` plus 64 lowercase hex digits.",
      "type": "string"
    },
    "EpochMs": {
      "description": "Trusted epoch milliseconds: a checked safe JSON integer, never a float.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "FallbackPolicyV1": {
      "description": "Provider routing is fixed: no fallback and required parameters. The closed\nenums make any other routing shape unrepresentable, so it refuses at parse.",
      "type": "string",
      "enum": [
        "disallowed"
      ]
    },
    "HttpsUrl": {
      "description": "A fixed-https destination: scheme, host, optional absolute path; no query,\nfragment, userinfo, whitespace or non-https scheme can be represented.",
      "type": "string"
    },
    "Ident": {
      "description": "Bounded printable ASCII identifier (`0x21..=0x7e`, 1..=128 bytes).",
      "type": "string"
    },
    "ModelId": {
      "description": "An explicitly named model id; whitespace and control bytes refuse.",
      "type": "string"
    },
    "ParameterPolicyV1": {
      "type": "string",
      "enum": [
        "required"
      ]
    },
    "PicoUsd": {
      "description": "Pico-dollar rate (`1e-12 USD`) as a canonical decimal string.",
      "type": "string"
    },
    "QuotePriceV1": {
      "type": "object",
      "properties": {
        "completion_pico_per_token": {
          "$ref": "#/$defs/PicoUsd"
        },
        "currency": {
          "$ref": "#/$defs/CurrencyV1"
        },
        "prompt_pico_per_token": {
          "$ref": "#/$defs/PicoUsd"
        },
        "reasoning_billing": {
          "$ref": "#/$defs/ReasoningBillingV1"
        },
        "request_pico": {
          "$ref": "#/$defs/PicoUsd"
        }
      },
      "additionalProperties": false,
      "required": [
        "currency",
        "prompt_pico_per_token",
        "completion_pico_per_token",
        "request_pico",
        "reasoning_billing"
      ]
    },
    "ReasoningBillingV1": {
      "oneOf": [
        {
          "description": "Hidden reasoning tokens are billed inside the completion rate. Every\nother billing shape is unrepresentable, so it refuses at parse.",
          "type": "string",
          "const": "included_in_completion"
        }
      ]
    },
    "Revision": {
      "description": "Positive canonical decimal revision (0 refuses).",
      "type": "string"
    },
    "UsdMicros": {
      "description": "Nonnegative exact USD micro-dollars as a canonical decimal string.",
      "type": "string"
    },
    "UuidV1": {
      "description": "Canonical lowercase UUID selector (`8-4-4-4-12`).",
      "type": "string"
    }
  }
}
