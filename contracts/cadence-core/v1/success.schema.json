{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Success",
  "description": "Success response.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "app.manifest.preflight"
        },
        "value": {
          "$ref": "#/$defs/ManifestPreflightValue"
        }
      },
      "required": [
        "op",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "issue.validate"
        },
        "value": {
          "$ref": "#/$defs/ValidateValue"
        }
      },
      "required": [
        "op",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "issue.readiness"
        },
        "value": {
          "$ref": "#/$defs/ReadinessValue"
        }
      },
      "required": [
        "op",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "works.draft.validate"
        },
        "value": {
          "$ref": "#/$defs/DraftValue"
        }
      },
      "required": [
        "op",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "works.review.check"
        },
        "value": {
          "$ref": "#/$defs/ReviewValue"
        }
      },
      "required": [
        "op",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "works.export.check"
        },
        "value": {
          "$ref": "#/$defs/ExportValue"
        }
      },
      "required": [
        "op",
        "value"
      ]
    }
  ],
  "required": [
    "ok"
  ],
  "$defs": {
    "DraftValue": {
      "description": "Success value of `works.draft.validate`. The two material fields are the\nexact bytes a host hashes: a revision's `contentDigest` is `sha256:` plus\nthe hex SHA-256 of the UTF-8 `content_material` bytes, and\n`payload_material` also covers tags.",
      "type": "object",
      "properties": {
        "content_material": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "The normalized kind, present only when the draft is valid.",
          "type": [
            "string",
            "null"
          ]
        },
        "payload_material": {
          "type": [
            "string",
            "null"
          ]
        },
        "refusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorksRefusal"
          }
        },
        "tags": {
          "description": "Tags after trimming and de-duplication, present only when valid.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "title": {
          "description": "The trimmed title, present only when the draft is valid.",
          "type": [
            "string",
            "null"
          ]
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "refusals"
      ]
    },
    "ExportValue": {
      "description": "Success value of `works.export.check`.",
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "export_state": {
          "description": "`ready` | `blocked`.",
          "type": "string"
        },
        "reason": {
          "description": "The card's export explanation for this state.",
          "type": "string"
        },
        "refusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorksRefusal"
          }
        },
        "review_state": {
          "description": "`draft` | `edited` | `reviewed`.",
          "type": "string"
        }
      },
      "required": [
        "allowed",
        "review_state",
        "export_state",
        "reason",
        "refusals"
      ]
    },
    "FieldRefusal": {
      "description": "One refused field.",
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "field",
        "message"
      ]
    },
    "ManifestPreflightValue": {
      "description": "Success value of `app.manifest.preflight`.",
      "type": "object"
    },
    "ReadinessValue": {
      "description": "Success value of `issue.readiness`.",
      "type": "object",
      "properties": {
        "blocked": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        },
        "refusal": {
          "description": "Why `status=ready` would be refused; present only then.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ready",
        "blocked"
      ]
    },
    "ReviewValue": {
      "description": "Success value of `works.review.check`: the state the host must write.",
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "refusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorksRefusal"
          }
        },
        "review_status": {
          "description": "`approved` or `changes_requested`; absent when refused.",
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_revision": {
          "description": "The revision an approval records; absent when refused, or for\n`changes`, which leaves the stored reviewed revision unchanged.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "required": [
        "allowed",
        "refusals"
      ]
    },
    "ValidateValue": {
      "description": "Success value of `issue.validate`.",
      "type": "object",
      "properties": {
        "refusals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldRefusal"
          }
        },
        "tags": {
          "description": "Sorted, de-duplicated tags; present when `tags` was given and valid.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "refusals"
      ]
    },
    "WorksRefusal": {
      "description": "One refused Works domain step, in the native wire shape.",
      "type": "object",
      "properties": {
        "code": {
          "description": "`invalid` | `conflict` | `forbidden` | `not_found` | `needs_review`.",
          "type": "string"
        },
        "kind": {
          "description": "`rejected` or `conflict`.",
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "message"
      ]
    }
  }
}
