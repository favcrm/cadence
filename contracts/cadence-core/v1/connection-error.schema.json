{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorCodeV1",
  "description": "The closed refusal/admission error set. The wire string and the human\nmessage are fixed per variant; adapters never compose them.",
  "type": "string",
  "enum": [
    "invalid_request",
    "unsupported_version",
    "digest_mismatch",
    "principal_required",
    "session_expired",
    "management_forbidden",
    "operation_not_granted",
    "runtime_revoked",
    "data_policy_refused",
    "destination_refused",
    "not_found",
    "method_not_allowed",
    "stale_revision",
    "idempotency_conflict",
    "loaded_state_mismatch",
    "placement_changed",
    "approval_required",
    "price_changed",
    "payload_too_large",
    "rate_limit",
    "spend_limit",
    "runtime_unqualified",
    "capability_unavailable",
    "custody_locked",
    "pricing_unavailable",
    "unsupported_verification",
    "entry_session_required",
    "already_submitted",
    "nonce_expired",
    "request_changed",
    "request_not_ready",
    "provider_refused",
    "reservation_overrun",
    "clock_regression",
    "state_conflict",
    "ledger_mismatch"
  ]
}
