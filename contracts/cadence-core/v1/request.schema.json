{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "description": "The request envelope.",
  "type": "object",
  "properties": {
    "v": {
      "description": "Contract version; only `1` exists.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "description": "Split the frontmatter, then check `needs.requires`.",
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/ManifestPreflightInput"
        },
        "op": {
          "type": "string",
          "const": "app.manifest.preflight"
        }
      },
      "required": [
        "op",
        "input"
      ]
    },
    {
      "description": "Check an issue id, project key, tags, status and priority.",
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/ValidateInput"
        },
        "op": {
          "type": "string",
          "const": "issue.validate"
        }
      },
      "required": [
        "op",
        "input"
      ]
    },
    {
      "description": "Whether an issue is ready or blocked, given its blockers' statuses.",
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/ReadinessInput"
        },
        "op": {
          "type": "string",
          "const": "issue.readiness"
        }
      },
      "required": [
        "op",
        "input"
      ]
    },
    {
      "description": "Validate a Works draft's kind, title, tags and closed content payload.",
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/DraftInput"
        },
        "op": {
          "type": "string",
          "const": "works.draft.validate"
        }
      },
      "required": [
        "op",
        "input"
      ]
    },
    {
      "description": "Whether a Works review may be recorded for a revision.",
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/ReviewInput"
        },
        "op": {
          "type": "string",
          "const": "works.review.check"
        }
      },
      "required": [
        "op",
        "input"
      ]
    },
    {
      "description": "Whether a Works revision is approved material a host may export.",
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/ExportInput"
        },
        "op": {
          "type": "string",
          "const": "works.export.check"
        }
      },
      "required": [
        "op",
        "input"
      ]
    }
  ],
  "required": [
    "v"
  ],
  "$defs": {
    "Blocker": {
      "description": "A `blocked_by` target and its current status. A target that cannot be\nfound counts as open: pass any status that is not `done` or `dropped`.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ]
    },
    "DraftInput": {
      "description": "Input of `works.draft.validate`: the fields a Works create parses. They\nstay untyped so a wrong type reaches the same refusal a native caller gets\ninstead of failing envelope decoding.",
      "type": "object",
      "properties": {
        "content": true,
        "kind": true,
        "tags": {
          "description": "Optional; an absent or null value means no tags."
        },
        "title": true
      },
      "additionalProperties": false
    },
    "ExportInput": {
      "description": "Input of `works.export.check`: the stored state plus the requested format.",
      "type": "object",
      "properties": {
        "current": {
          "type": "integer",
          "format": "int64"
        },
        "format": {
          "description": "The host's export format, required, non-blank and bounded.",
          "type": "string"
        },
        "review_status": {
          "type": "string"
        },
        "reviewed": {
          "description": "The revision the last approval covered; `0` before any approval.",
          "type": "integer",
          "format": "int64"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        },
        "trashed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "current",
        "revision",
        "review_status",
        "reviewed",
        "trashed",
        "format"
      ]
    },
    "ManifestPreflightInput": {
      "type": "object",
      "properties": {
        "manifest": {
          "description": "The exact `app.md` text.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "manifest"
      ]
    },
    "ReadinessInput": {
      "description": "Input of `issue.readiness`. `id` names the issue in the refusal.",
      "type": "object",
      "properties": {
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Blocker"
          }
        },
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "blockers"
      ]
    },
    "ReviewInput": {
      "description": "The stored state a Works operation must judge; the host proves it.",
      "type": "object",
      "properties": {
        "author": {
          "description": "The stored author of the revision.",
          "type": "string"
        },
        "current": {
          "description": "The item's current revision.",
          "type": "integer",
          "format": "int64"
        },
        "decision": {
          "description": "`approve` or `changes`.",
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending": {
          "description": "The revision a pending review was requested for.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "review_status": {
          "description": "`none` | `pending` | `approved` | `changes_requested`.",
          "type": "string"
        },
        "reviewer": {
          "description": "The verified human presenting the decision.",
          "type": "string"
        },
        "revision": {
          "description": "The revision under review.",
          "type": "integer",
          "format": "int64"
        },
        "trashed": {
          "description": "Whether the record is trashed. Trash state does not clear a pending\nreview, so a review of a trashed record must refuse as missing — the\nhost proves this value, it is not a caller claim.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "current",
        "revision",
        "review_status",
        "trashed",
        "author",
        "reviewer",
        "decision"
      ]
    },
    "ValidateInput": {
      "description": "Input of `issue.validate`: every field is optional and checked when set.",
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
