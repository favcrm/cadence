{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialRequestV1",
  "type": "object",
  "properties": {
    "allowed_verb": {
      "$ref": "#/$defs/HumanVerbV1"
    },
    "connection_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ]
    },
    "conversation_id": {
      "$ref": "#/$defs/Ident"
    },
    "custody_domain": {
      "$ref": "#/$defs/Ident"
    },
    "custody_epoch": {
      "$ref": "#/$defs/Revision"
    },
    "enrollment_intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnrollmentIntentV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_authorization_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_credential_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_request_revision": {
      "$ref": "#/$defs/Revision"
    },
    "participant_uid": {
      "$ref": "#/$defs/AgentUid"
    },
    "provider_kind": {
      "$ref": "#/$defs/ProviderKindV1"
    },
    "request_id": {
      "$ref": "#/$defs/UuidV1"
    },
    "state": {
      "$ref": "#/$defs/CredentialRequestStateV1"
    },
    "status": {
      "$ref": "#/$defs/CredentialRequestStatusV1"
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "v",
    "request_id",
    "participant_uid",
    "conversation_id",
    "provider_kind",
    "expected_request_revision",
    "custody_domain",
    "custody_epoch",
    "allowed_verb",
    "state",
    "status"
  ],
  "$defs": {
    "AgentUid": {
      "description": "Stable hosted agent UID: `agt-` plus the 32 lowercase hex UUID digits.",
      "type": "string"
    },
    "CredentialRequestStateV1": {
      "type": "string",
      "enum": [
        "pending",
        "submitting",
        "done",
        "cancelled",
        "expired",
        "unknown"
      ]
    },
    "CredentialRequestStatusV1": {
      "type": "string",
      "enum": [
        "pending_human",
        "recorded",
        "refused",
        "unknown"
      ]
    },
    "EnrollmentIntentV1": {
      "type": "object",
      "properties": {
        "custody_domain": {
          "$ref": "#/$defs/Ident"
        },
        "custody_epoch": {
          "$ref": "#/$defs/Revision"
        },
        "workspace_id": {
          "$ref": "#/$defs/Ident"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "custody_domain",
        "custody_epoch"
      ]
    },
    "HumanVerbV1": {
      "type": "string",
      "enum": [
        "enroll",
        "rotate",
        "verify"
      ]
    },
    "Ident": {
      "description": "Bounded printable ASCII identifier (`0x21..=0x7e`, 1..=128 bytes).",
      "type": "string"
    },
    "ProviderKindV1": {
      "type": "string",
      "enum": [
        "smtp",
        "openrouter"
      ]
    },
    "Revision": {
      "description": "Positive canonical decimal revision (0 refuses).",
      "type": "string"
    },
    "UuidV1": {
      "description": "Canonical lowercase UUID selector (`8-4-4-4-12`).",
      "type": "string"
    }
  }
}
