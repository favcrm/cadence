{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.local/contracts/app-assistant/v1/app-assistant.schema.json",
  "title": "Cadence app assistant descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "actions"],
  "properties": {
    "contract": {"const": "app-assistant/v1"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "input_schema", "effect", "confirmation"],
        "properties": {
          "id": {"type": "string", "enum": ["customers.search", "customers.show", "segments.list", "segments.show", "segments.preview", "segments.save", "campaigns.list", "campaigns.show", "campaigns.create_draft", "email.draft", "customer.tags.update"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 240},
          "input_schema": {"type": "object"},
          "effect": {"enum": ["read", "draft", "write"]},
          "confirmation": {"enum": ["none", "permission"]}
        }
      }
    }
  }
}
