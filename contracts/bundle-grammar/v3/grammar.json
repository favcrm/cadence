{
  "caps": {
    "bundleBytes": 2097152,
    "fileBytes": 262144,
    "files": 128,
    "screenAssetBytes": 393216,
    "skillFileBytes": 16384,
    "skillFiles": 16,
    "skillManifestBytes": 4096,
    "skillPackageBytes": 32768
  },
  "definitions": {
    "exact": {
      "leaf": "the name carried by the directory entry"
    },
    "screensPackage": {
      "assetStem": "validTag",
      "declaration": "screens.json",
      "extensions": [
        "js",
        "css",
        "svg",
        "json"
      ],
      "path": "screens/<tag>/<leaf>",
      "tag": "validTag"
    },
    "skillsPackage": {
      "declaredEqualsPresent": true,
      "dotfiles": "refused",
      "entry": "SKILL.md",
      "manifest": "skill.json",
      "maxDepth": 2,
      "nested": {
        "references": [
          "md",
          "txt"
        ],
        "scripts": [
          "py",
          "sh",
          "js",
          "mjs"
        ]
      },
      "path": "skills/<tag>/<member>",
      "rootExtensions": [
        "md",
        "txt",
        "json",
        "yaml",
        "yml",
        "csv",
        "css",
        "svg"
      ],
      "symlinks": "refused",
      "tag": "validTag"
    },
    "svgLeaf": {
      "maxLeafBytes": 128,
      "segment": true,
      "suffix": ".svg"
    },
    "validTag": {
      "charset": "abcdefghijklmnopqrstuvwxyz0123456789-",
      "forbidLeading": "-",
      "maxBytes": 32,
      "minBytes": 1,
      "wholeInput": true
    },
    "visibleLeaf": {
      "segment": true
    },
    "workflowMdTag": {
      "segment": true,
      "stem": "validTag of the leaf with every trailing suffix removed",
      "suffix": ".md"
    }
  },
  "directories": [
    {
      "dir": "workflows",
      "rule": "workflow_md_tag"
    },
    {
      "dir": "views",
      "name": "app-views-v1.json",
      "rule": "exact"
    },
    {
      "dir": "rubrics",
      "rule": "visible_leaf"
    },
    {
      "dir": "templates",
      "rule": "visible_leaf"
    },
    {
      "dir": "assets",
      "maxLeafBytes": 128,
      "rule": "svg_leaf"
    },
    {
      "declaration": "screens.json",
      "dir": "screens",
      "leaf": "tag_stem.(js|css|svg|json)",
      "rule": "screens_package"
    },
    {
      "declaration": "skill.json",
      "dir": "skills",
      "entry": "SKILL.md",
      "member": "<stem>.(md|txt|json|yaml|yml|csv|css|svg) | <scripts|references>/<stem>",
      "rule": "skills_package"
    },
    {
      "dir": "storage",
      "rule": "tagged_leaf",
      "suffix": ".json"
    }
  ],
  "rootFiles": [
    "app.md",
    "app-chat.json",
    "app-assistant.json",
    "app-actions.json",
    "app-storage.json"
  ],
  "segments": {
    "asciiOnly": true,
    "forbidBackslash": true,
    "forbidExact": [
      ".",
      ".."
    ],
    "forbidLeadingDot": true,
    "forbidNul": true,
    "nonEmpty": true
  },
  "version": 3
}
