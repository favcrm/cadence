{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssueDetail",
  "description": "`GET /api/issues/:id` and `issue show --json`: the drawer payload.\nThe board adds `agents` when a job binds agents to the issue.",
  "type": "object",
  "properties": {
    "acceptance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AcceptanceRow"
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActivityEntry"
      }
    },
    "agents": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/CardAgent"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactRow"
      }
    },
    "blocked": {
      "type": "boolean"
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "body": {
      "type": "string"
    },
    "checks": {
      "$ref": "#/$defs/CardChecks"
    },
    "claim": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaimCard"
        },
        {
          "type": "null"
        }
      ]
    },
    "comments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommentRow"
      }
    },
    "commits": {
      "type": "array",
      "items": true
    },
    "commits_skipped": {
      "type": "array",
      "items": true
    },
    "component": {
      "type": [
        "string",
        "null"
      ]
    },
    "container": {
      "type": "boolean"
    },
    "created": {
      "type": "string"
    },
    "frontmatter": {
      "description": "The issue's front matter as stored.",
      "type": "object",
      "additionalProperties": true
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HistoryEntry"
      }
    },
    "id": {
      "type": "string"
    },
    "links": {
      "$ref": "#/$defs/IssueLinks"
    },
    "notes_chain": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NoteRow"
      }
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "plan": {
      "description": "Plan state, tickets and weighted progress; null unless a plan epic."
    },
    "priority": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "ready": {
      "type": "boolean"
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref"
      }
    },
    "reports": {
      "description": "Task reports filed on the issue (`issue/task_report.rs` rows).",
      "type": "array",
      "items": true
    },
    "rev": {
      "type": "string"
    },
    "size": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    },
    "status_source": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "work": {
      "description": "The CAD-405 work block (`work::detail`).",
      "anyOf": [
        {
          "$ref": "#/$defs/WorkBlock"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "project",
    "title",
    "status",
    "status_source",
    "priority",
    "tags",
    "paths",
    "container",
    "ready",
    "blocked",
    "created",
    "rev",
    "frontmatter",
    "body",
    "path",
    "links",
    "refs",
    "artifacts",
    "comments",
    "reports",
    "notes_chain",
    "acceptance",
    "history",
    "activity",
    "commits",
    "commits_skipped",
    "checks"
  ],
  "$defs": {
    "AcceptanceRow": {
      "description": "One checklist item of the `Acceptance` section; `done` mirrors `checked`.",
      "type": "object",
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "done": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "checked",
        "done"
      ]
    },
    "ActivityEntry": {
      "description": "One merged activity entry: `kind` is `note` (with `note_kind`, `title`,\n`name`), `comment` (`author`, `body`, `name`) or `commit` (`commit`,\n`subject`).",
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "note_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "at",
        "kind"
      ]
    },
    "ArtifactRow": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "size"
      ]
    },
    "CardAgent": {
      "description": "One bound agent on an issue card or drawer — from the job binding.",
      "type": "object",
      "properties": {
        "alias": {
          "type": "string"
        },
        "message": {
          "description": "Running kickoff message id for this task, if live.",
          "type": [
            "string",
            "null"
          ]
        },
        "resume": {
          "description": "Concrete resume command for a stopped pane.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "description": "The agent's state; `null` when the daemon reports none.",
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": "string"
        },
        "task_state": {
          "type": "string"
        }
      },
      "required": [
        "alias",
        "task",
        "task_state"
      ]
    },
    "CardChecks": {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "done",
        "total"
      ]
    },
    "ClaimCard": {
      "description": "The in-flight claim on a card, with its age.",
      "type": "object",
      "properties": {
        "age_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "at": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "last_seen": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "stale": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "by",
        "at"
      ]
    },
    "CommentRow": {
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "author",
        "at",
        "body"
      ]
    },
    "HealthReason": {
      "description": "One reason an epic is not on track, with its next action.",
      "type": "object",
      "properties": {
        "cause": {
          "description": "`blocked` | `stage_time` | `stalled`.",
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "cause",
        "issue",
        "detail",
        "next"
      ]
    },
    "HistoryEntry": {
      "description": "One `git log` line of the issue's `issue.md`.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "commit",
        "at",
        "subject"
      ]
    },
    "IssueLinks": {
      "type": "object",
      "properties": {
        "blocked_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LinkRef"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LinkRef"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LinkRef"
          }
        },
        "duplicate_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "duplicates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LinkRef"
          }
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "relates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LinkRef"
          }
        }
      },
      "required": [
        "children",
        "blocked_by",
        "blocks",
        "relates",
        "duplicates"
      ]
    },
    "LinkRef": {
      "description": "A link target in the drawer: the issue's title and status when it is on\nthe board, else just its id with `missing: true`.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "missing": {
          "type": "boolean"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "missing"
      ]
    },
    "NoteRow": {
      "description": "A notes-chain entry tagged to the issue.",
      "type": "object",
      "properties": {
        "at": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "at",
        "title"
      ]
    },
    "ProgressCounts": {
      "description": "Work-item counts by status bucket.",
      "type": "object",
      "properties": {
        "blocked": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "doing": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "done": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "dropped": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "open": {
          "description": "Backlog plus ready.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "review": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "open",
        "doing",
        "review",
        "blocked",
        "done",
        "dropped",
        "total"
      ]
    },
    "Ref": {
      "description": "A typed link kept on an issue: PR, commit, note, preview, message, ...\n`note` refs use `path` (the notes directory), preview refs store the\npublish path — never a signed URL.",
      "type": "object",
      "properties": {
        "agent": {
          "description": "`message` refs only: the dispatch recipient — structured so\nfinish finds the agent holding the bound message without\nparsing it back out of the display label.",
          "type": [
            "string",
            "null"
          ]
        },
        "cargo_target": {
          "description": "`worktree` refs only: the effective cargo target dir for the\ncheckout — the shared cache or the worktree-local `target/`\nwhen the project opted out — so `issue finish` and\n`doctor --host` account for the right bytes.",
          "type": [
            "string",
            "null"
          ]
        },
        "closed": {
          "description": "`issue finish` marks worktree/branch refs closed rather than\ndeleting them — the ref stays as history.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "description": "`message` refs only: the worktree the dispatch ran against, so\na re-start under `--name` leaves the earlier kickoff bound to\nits own pair instead of every worktree the issue ever opens.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "StageMove": {
      "description": "One move `epic_stage` accepts from the epic's current stage.",
      "type": "object",
      "properties": {
        "forward": {
          "type": "boolean"
        },
        "needs_operator": {
          "description": "Only the proven operator may make it.",
          "type": "boolean"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "to",
        "forward",
        "needs_operator"
      ]
    },
    "WorkBlock": {
      "description": "The CAD-405 work block on a card: type, milestone, size; stage,\nprogress and health on epics.",
      "type": "object",
      "properties": {
        "config_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "config_unapproved": {
          "type": [
            "string",
            "null"
          ]
        },
        "health": {
          "description": "Epics only.",
          "anyOf": [
            {
              "$ref": "#/$defs/WorkHealth"
            },
            {
              "type": "null"
            }
          ]
        },
        "milestone": {
          "type": [
            "string",
            "null"
          ]
        },
        "milestone_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "description": "Epics only: weighted child progress.",
          "anyOf": [
            {
              "$ref": "#/$defs/WorkProgress"
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "description": "Epics only; `null` otherwise.",
          "anyOf": [
            {
              "$ref": "#/$defs/WorkStage"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string"
        },
        "type_source": {
          "description": "`field` | `implicit`.",
          "type": "string"
        },
        "weight": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "type_source",
        "weight"
      ]
    },
    "WorkHealth": {
      "description": "An epic's health: `stalled` is time in stage, not child activity.",
      "type": "object",
      "properties": {
        "days_in_stage": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "limit_days": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HealthReason"
          }
        },
        "state": {
          "description": "`on_track` | `at_risk` | `stalled`.",
          "type": "string"
        }
      },
      "required": [
        "state",
        "limit_days",
        "reasons"
      ]
    },
    "WorkProgress": {
      "description": "Size-weighted progress over a set of work items.",
      "type": "object",
      "properties": {
        "counts": {
          "$ref": "#/$defs/ProgressCounts"
        },
        "done_weight": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ratio": {
          "type": "number",
          "format": "double"
        },
        "total_weight": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "done_weight",
        "total_weight",
        "ratio",
        "counts"
      ]
    },
    "WorkStage": {
      "description": "An epic's stage in its project's stage list.",
      "type": "object",
      "properties": {
        "exit": {
          "description": "The exit criterion of this stage; `null` for a stage the list lacks.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "moves": {
          "description": "The legal moves from here; empty while PROJECT.md cannot be loaded.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageMove"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_needs_operator": {
          "type": "boolean"
        },
        "since": {
          "description": "When the epic entered the stage (ISO); `null` when unknown.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "`field` | `plan` | `status` | `default`.",
          "type": "string"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terminal": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source",
        "next_needs_operator",
        "terminal",
        "stages",
        "moves"
      ]
    }
  }
}
